"""Keep native Ray submission semantics, but require synchronous success."""

import json
import os
import signal
import subprocess
import sys
import uuid
from pathlib import Path


def check_status() -> None:
    from ray.dashboard.modules.job.cli import _get_sdk_client
    from ray.job_submission import JobStatus

    options = json.load(sys.stdin)
    submission_id = options.pop("submission_id")
    status = _get_sdk_client(**options).get_job_status(submission_id)
    if status != JobStatus.SUCCEEDED:
        sys.exit(f"Ray job {submission_id} ended with status {status}; expected SUCCEEDED")


def run_native(command: list[str], *, input: str | None = None, timeout: int | None = None) -> int:
    """Forward cancellation to the native CLI and reap it before returning."""
    process = subprocess.Popen(command, stdin=subprocess.PIPE if input is not None else None, text=True)
    received = []

    def forward(signum, _frame):
        received.append(signum)
        if process.poll() is None:
            process.send_signal(signum)

    previous = {sig: signal.signal(sig, forward) for sig in (signal.SIGINT, signal.SIGTERM)}
    try:
        try:
            process.communicate(input=input, timeout=timeout)
        except subprocess.TimeoutExpired:
            process.kill()
            process.communicate()
            raise
        code = process.returncode
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)
    if received:
        return 128 + received[-1]
    return code if code >= 0 else 128 - code


def main() -> int:
    real_ray = os.environ["RELAX_REAL_RAY"]
    argv = sys.argv[1:]
    if argv[:2] != ["job", "submit"]:
        os.execv(real_ray, [real_ray, *argv])

    # Reuse Ray's parser, including -- boundaries, authentication, TLS and aliases.
    # Do not invoke the callback here: the original CLI still performs submission.
    import click
    from ray.dashboard.modules.job.cli import submit

    try:
        with submit.make_context("ray job submit", argv[2:]) as context:
            options = context.params.copy()
    except click.exceptions.Exit as exc:
        return exc.exit_code
    except click.ClickException as exc:
        exc.show()
        return exc.exit_code

    submission_id = options.get("submission_id") or options.get("job_id")
    if not submission_id:
        submission_id = f"relax-{uuid.uuid4().hex}"
        argv[2:2] = ["--submission-id", submission_id]
    code = run_native([real_ray, *argv])
    if code or options["no_wait"]:
        return code

    # Bound only the final status request, never the training/log-stream duration.
    payload = {key: options[key] for key in ("address", "headers", "verify")}
    payload["submission_id"] = submission_id
    try:
        return run_native(
            [sys.executable, str(Path(__file__).resolve()), "--relax-check-status"],
            input=json.dumps(payload),
            timeout=60,
        )
    except subprocess.TimeoutExpired:
        print(f"Timed out checking final status of Ray job {submission_id}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    if sys.argv[1:] == ["--relax-check-status"]:
        check_status()
    else:
        try:
            sys.exit(main())
        except KeyboardInterrupt:
            sys.exit(130)
