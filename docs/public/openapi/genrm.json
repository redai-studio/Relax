        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Get Engines Engines Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
