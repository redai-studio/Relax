{
  "openapi": "3.1.0",
  "info": {
    "title": "GenRM Service",
    "description": "Generative Reward Model (GenRM) service for LLM-based response evaluation.\n\nUses SGLang engines to perform preference evaluation by comparing model responses against ground truth or quality standards.  The service accepts OpenAI-style chat messages and returns raw model judgements.\n\nGenRM is a passive HTTP service — unlike Actor or Rollout it does not run a background loop.  It only responds to incoming ``/generate`` requests.",
    "version": "1.0.0"
  },
  "paths": {
    "/generate": {
      "post": {
        "summary": "Generate",
        "description": "Forward generation payloads through the shared inference gateway.",
        "operationId": "generate_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "description": "Messages or raw SGLang generation payload; validated by the inference gateway."
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "Legacy messages requests return a response string; raw requests retain the backend response."
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Health check endpoint; reports per-instance status.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "description": "Metrics endpoint; reports per-instance stats.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Metrics Metrics Get"
                }
              }
            }
          }
        }
      }
    }
  }
}
