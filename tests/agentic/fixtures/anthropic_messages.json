    {
      "case_id": "full_multiturn_conversation",
      "payload": {
        "model": "relax-test",
        "max_tokens": 128,
        "system": "Use tools.",
        "thinking": {
          "type": "enabled"
        },
        "messages": [
          {
            "role": "user",
            "content": "Weather in Paris and Berlin?"
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "thinking",
                "thinking": "Two lookups are independent."
              },
              {
                "type": "text",
                "text": "Checking both cities."
              },
              {
                "type": "tool_use",
                "id": "call-1",
                "name": "get_weather",
                "input": {
                  "unit": "celsius",
                  "city": "Paris"
                }
              },
              {
                "type": "tool_use",
                "id": "call-2",
                "name": "get_weather",
                "input": {
                  "city": "Berlin"
                }
              }
            ]
          },
          {
            "role": "user",
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "call-1",
                "content": "17C"
              },
              {
                "type": "tool_result",
                "tool_use_id": "call-2",
                "content": "21C"
              }
            ]
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "Paris 17C, Berlin 21C."
              }
            ]
          }
        ],
        "tools": [
          {
            "name": "get_weather",
            "description": "Return the weather.",
            "input_schema": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "city"
              ]
            }
          }
        ]
      }
