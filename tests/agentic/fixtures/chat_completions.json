    {
      "case_id": "full_multiturn_conversation",
      "payload": {
        "model": "relax-test",
        "messages": [
          {
            "role": "system",
            "content": "Use tools."
          },
          {
            "role": "user",
            "content": "Weather in Paris and Berlin?"
          },
          {
            "role": "assistant",
            "content": "Checking both cities.",
            "reasoning_content": "Two lookups are independent.",
            "tool_calls": [
              {
                "id": "call-1",
                "type": "function",
                "function": {
                  "name": "get_weather",
                  "arguments": "{\"unit\":\"celsius\",\"city\":\"Paris\"}"
                }
              },
              {
                "id": "call-2",
                "type": "function",
                "function": {
                  "name": "get_weather",
                  "arguments": "{\"city\":\"Berlin\"}"
                }
              }
            ]
          },
          {
            "role": "tool",
            "tool_call_id": "call-1",
            "content": "17C"
          },
          {
            "role": "tool",
            "tool_call_id": "call-2",
            "content": "21C"
          },
          {
            "role": "assistant",
            "content": "Paris 17C, Berlin 21C."
          }
        ],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "get_weather",
              "description": "Return the weather.",
              "parameters": {
                "type": "object",
                "properties": {
                  "city": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string"
                  }
                },
                "required": [
                  "city"
                ]
              }
            }
          }
        ],
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      }
    }
  ]
