          },
          {
            "id": "call_time",
            "type": "function",
            "function": {
              "name": "clock",
              "arguments": "{\"city\":\"北京\"}"
            }
          }
        ]
      },
      {
        "role": "tool",
        "content": "18°C",
        "tool_call_id": "call_weather"
      },
      {
        "role": "tool",
        "content": "09:30",
        "tool_call_id": "call_time"
      },
      {
        "role": "assistant",
        "content": "It is 18°C at 09:30."
      }
    ],
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "weather",
          "parameters": {
            "properties": {
