            "content": "Weather in Paris and Berlin?"
          },
          {
            "type": "reasoning",
            "summary": [
              {
                "type": "summary_text",
                "text": "Two lookups are independent."
              }
            ]
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "output_text",
                "text": "Checking both cities."
              }
            ]
          },
          {
            "type": "function_call",
            "call_id": "call-1",
            "name": "get_weather",
            "arguments": "{\"city\":\"Paris\",\"unit\":\"celsius\"}"
          },
          {
            "type": "function_call",
            "call_id": "call-2",
            "name": "get_weather",
            "arguments": "{\"city\":\"Berlin\"}"
          },
          {
            "type": "function_call_output",
            "call_id": "call-1",
            "output": "17C"
          },
          {
            "type": "function_call_output",
            "call_id": "call-2",
            "output": "21C"
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "output_text",
                "text": "Paris 17C, Berlin 21C."
              }
            ]
          }
        ],
        "tools": [
          {
            "type": "function",
            "name": "get_weather",
            "description": "Return the weather.",
            "parameters": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "city"
              ]
            }
          }
        ],
        "reasoning": {
          "effort": "medium"
        }
