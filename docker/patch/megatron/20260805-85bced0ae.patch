+            pv_parts = []
+            grid_parts = []
+            for idx in my_indices:
+                px_start = 0 if idx == 0 else pixel_cumsum[idx - 1].item()
+                px_end = pixel_cumsum[idx].item()
+                pv_parts.append(pixel_values[px_start:px_end])
+                grid_parts.append(grid_thws[idx : idx + 1])
