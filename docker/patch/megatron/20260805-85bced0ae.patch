+        merge_h, merge_w = self.vision_tower.merge_kernel_size
+        param_dtype = next(self.vision_tower.parameters()).dtype
+        text_hidden = self.projector_config.hidden_size
+
+        pixel_counts = grid_thws.prod(dim=-1)
+        out_token_counts = (grid_thws[:, 1] // merge_h) * (grid_thws[:, 2] // merge_w)
+        total_out_tokens = out_token_counts.sum().item()
+
+        chunk_indices = list(range(num_images))
+        chunks = [chunk_indices[i::tp_size] for i in range(tp_size)]
+        my_indices = chunks[tp_rank] if tp_rank < len(chunks) else []
+
