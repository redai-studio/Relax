+def get_mtp_normalization_counts(num_tokens, original_num_tokens, cp_group=None):
+    """Use complete-sequence counts, including CP ranks with no local targets.
+
+    Default DDP averages over CP, so auxiliary microbatch means need a CP
+    multiplier. Per-token training instead normalizes gradients once at the
+    end of the step and needs the global pre-roll/post-roll count ratio.
+    """
+    cp_size = cp_group.size() if cp_group is not None else 1
+    if cp_size == 1:
+        return num_tokens, original_num_tokens, cp_size
+    original = torch.zeros_like(num_tokens) if original_num_tokens is None else original_num_tokens
+    counts = torch.stack((num_tokens, original))
+    torch.distributed.all_reduce(counts, group=cp_group)
+    return counts[0], counts[1], cp_size
