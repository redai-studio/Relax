+class _BoundedSyncStager:
+    """Stage checkpoint tensors just ahead of the synchronous writer.
+
+    A single producer thread copies tensors to host memory (pinned async D2H for
+    CUDA tensors, compaction clone for CPU views) while the writer thread
+    consumes them in the original write order. Staged bytes are capped by
+    ``max_bytes``; a single item larger than the cap is staged once the window
+    is empty, so peak extra host memory per rank is bounded by
+    ``max(max_bytes, largest_item)`` rather than the whole checkpoint.
+    """
+
+    def __init__(self, max_bytes: int):
+        self.max_bytes = max_bytes
+        self.peak_staged_bytes = 0
+        self._cond = threading.Condition()
+        self._window = collections.deque()
+        self._staged_bytes = 0
+        self._inflight_bytes = 0
+        self._ready_events = []
+        self._error = None
+        self._closed = False
+        self._thread = None
+
+    @staticmethod
+    def _stage(tensor: torch.Tensor) -> Tuple[torch.Tensor, Optional[torch.cuda.Event]]:
+        tensor = tensor.detach()
+        if tensor.device.type == "cuda":
+            if "dequantize" in type(tensor).__dict__:
+                tensor = tensor.dequantize()
+            with torch.cuda.device(tensor.device):
+                staged = torch.empty(tensor.shape, dtype=tensor.dtype, pin_memory=True)
+                staged.copy_(tensor, non_blocking=True)
+                event = torch.cuda.Event()
+                event.record()
+            return staged, event
+        staged = tensor.to("cpu", non_blocking=False)
+        if staged.untyped_storage().nbytes() != staged.numel() * staged.element_size():
+            staged = staged.clone()
+        return staged, None
+
+    def _produce(self, tensors: List[torch.Tensor]) -> None:
+        try:
+            # The producer has its own thread-local CUDA current streams. Wait for
+            # work submitted on the caller's streams before reading checkpoint data.
+            for event in self._ready_events:
+                event.synchronize()
+            for tensor in tensors:
+                if tensor.device.type == "cuda" and "dequantize" in type(tensor).__dict__:
+                    with torch.cuda.device(tensor.device):
+                        tensor = tensor.dequantize()
+                nbytes = tensor.numel() * tensor.element_size()
+                with self._cond:
+                    while (
+                        self._staged_bytes
+                        and self._staged_bytes + nbytes > self.max_bytes
+                        and not self._closed
+                    ):
+                        self._cond.wait()
+                    if self._closed:
+                        return
+                    # Reserve before allocating, including the writer's live item.
+                    self._staged_bytes += nbytes
+                    self.peak_staged_bytes = max(self.peak_staged_bytes, self._staged_bytes)
+                staged, event = self._stage(tensor)
+                with self._cond:
+                    if self._closed:
+                        if event is not None:
+                            event.synchronize()
+                        return
+                    self._window.append((staged, event))
+                    # Only the queue/writer may retain the staging allocation.
+                    del staged, event
+                    self._cond.notify_all()
+        except BaseException as exc:
+            # Report to the writer thread; it surfaces through the results queue.
+            with self._cond:
+                self._error = exc if isinstance(exc, Exception) else RuntimeError(str(exc))
+                self._cond.notify_all()
+
+    def start(self, tensors: List[torch.Tensor]) -> None:
+        for device in {tensor.device for tensor in tensors if tensor.is_cuda}:
+            with torch.cuda.device(device):
+                event = torch.cuda.Event()
+                event.record(torch.cuda.current_stream(device))
+                self._ready_events.append(event)
+        self._thread = threading.Thread(
+            target=self._produce, args=(tensors,), name="sync-save-stager", daemon=True
+        )
+        self._thread.start()
+
+    def take(self) -> torch.Tensor:
+        with self._cond:
+            while not self._window:
+                if self._error is not None:
+                    raise self._error
+                if self._closed:
+                    raise RuntimeError("Synchronous save stager closed with items pending")
+                self._cond.wait()
+            staged, event = self._window.popleft()
+            self._inflight_bytes = staged.numel() * staged.element_size()
+        if event is not None:
+            event.synchronize()
+        return staged
+
+    def release(self) -> None:
+        """Return budget only after the writer has dropped its tensor reference."""
+        with self._cond:
+            self._staged_bytes -= self._inflight_bytes
+            self._inflight_bytes = 0
+            self._cond.notify_all()
+
+    def close(self) -> None:
+        with self._cond:
+            self._closed = True
+            self._cond.notify_all()
+        if self._thread is not None and self._thread.ident is not None:
+            self._thread.join()
+        # Complete outstanding D2H copies before releasing pinned destinations.
+        for _, event in self._window:
+            if event is not None:
+                event.synchronize()
+        self._window.clear()
+        self._ready_events.clear()
+
