+    @staticmethod
+    def write_data_synchronously(
+        transform_list: List[_StorageWriterTransforms],
+        use_msc: bool,
+        rank: int,
+        write_buckets: List[WriteBucket],
+        results_queue: queue.Queue,
+        stage_max_bytes: int = 0,
+    ) -> None:
+        """Write buckets sequentially; keep planning and finalization unchanged.
+
+        With ``stage_max_bytes`` > 0 a producer thread stages tensors up to that
+        many bytes ahead of the writer (pinned async D2H, CPU view compaction);
+        with 0 each tensor is staged inline right before its write.
+        """
+        stager = None
+        results = {}
+        try:
+            if stage_max_bytes > 0:
+                stager = _BoundedSyncStager(stage_max_bytes)
+                stager.start(
+                    [tensor for _, _, (_, tensor_data) in write_buckets for _, tensor in tensor_data]
+                )
+            for index, bucket in enumerate(write_buckets):
+                _, output = FileSystemWriterAsync.write_preloaded_data(
+                    transform_list, index, bucket, None, None, True,
+                    use_msc=use_msc, synchronous=True, sync_stager=stager,
+                )
+                if isinstance(output, Exception):
+                    raise output
+                results[index] = output
+        except Exception as exc:
+            results = exc
+        finally:
+            if stager is not None:
+                try:
+                    stager.close()
+                    logger.debug(
+                        f"Synchronous save staged peak bytes on rank {rank}: {stager.peak_staged_bytes}"
+                    )
+                except Exception as exc:
+                    if not isinstance(results, Exception):
+                        results = exc
+        # Start/copy/write/cleanup failures must all reach distributed finalization.
+        # Enqueue only after cleanup, so no rank can publish success prematurely.
+        results_queue.put(results)
+
