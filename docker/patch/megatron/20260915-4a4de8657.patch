+            raw_keys, doc_ids, positions, num_docs=cu.numel() - 1, ratio=self.compress_ratio
+        )
+        starts = (
+            stage2_physical_cu[:-1]
+            if stage2_physical_cu is not None
+            else cu[:-1].to(device=block_relative.device, dtype=torch.long)
