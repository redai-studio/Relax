+@dataclass
+class QSAIndexerSubmodules:
+    """Submodules of the QSA indexer."""
+
+    linear_qk: Union[ModuleSpec, type] = None
+    q_layernorm: Union[ModuleSpec, type] = None
+    k_layernorm: Union[ModuleSpec, type] = None
