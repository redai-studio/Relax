+# Copyright (c) 2026 Relax Authors. All Rights Reserved.
+"""Frozen TP1 PLE with input halos and owner-preserving backward.
+
+Opt in with QWEN38_PLE_INPUT_HALO_CP=1. Metadata must be bound by the packed
+batch producer. This path does not support trainable PLE or TP/SP. A prepared
+batch must remain current throughout its checkpoint recomputation.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+from typing import TYPE_CHECKING
+
+import torch
+import torch.nn.functional as F
+from megatron.core import parallel_state
+from megatron.core.transformer.hyper_connection import gated_residual_group_rmsnorm as norm
+
+if TYPE_CHECKING:
+    from megatron.core.packed_seq_params import PackedSeqParams
+    from megatron.core.transformer.per_layer_embedding import PerLayerEmbedding
+
+
+def _prepared_lengths(layer: PerLayerEmbedding) -> tuple[int, ...]:
+    from relax.backends.megatron.qsa_layout_metadata import valid_physical_layout
+
+    state = layer._cp_packed_seq_params
+    packed = getattr(state, "ple_input_halo_packed", None)
+    record = valid_physical_layout(packed) if packed is not None else None
+    if record is None:
+        raise RuntimeError("Input-halo PLE requires valid prepared physical layout metadata")
+    bounds = record[2]
+    lengths = tuple(b - a for a, b in zip(bounds[:-1], bounds[1:]))
+    if lengths != state.ple_input_halo_lengths or sum(lengths) != layer._ngram_ids.shape[1]:
+        raise RuntimeError("Input-halo PLE metadata changed after prepare")
+    return lengths
+
+
+def _resolve_transport(mode: str, lengths: tuple[int, ...], size: int, halo: int) -> str:
+    """Select compact halos only when every physical chunk covers the halo.
+
+    Producer-bound lengths and layer geometry are identical across CP ranks,
+    so the complete packed batch takes the same collective path on every rank.
+    """
+    if mode == "adaptive":
+        return "halo" if all(length // (2 * size) >= halo for length in lengths) else "full"
+    if mode not in {"full", "halo"}:
+        raise ValueError("PLE transport must be halo, full or adaptive")
+    return mode
+
+
+def forward_input_halo(layer: PerLayerEmbedding, hidden: torch.Tensor) -> torch.Tensor:
+    lengths = _prepared_lengths(layer)
+    if any(p.requires_grad for p in layer.parameters()) or layer.tp_group.size() != 1:
+        raise RuntimeError("Input-halo PLE requires TP1 and all PLE parameters frozen")
+    group = parallel_state.get_context_parallel_group()
+    rank, size = group.rank(), group.size()
+    intervals = []
+    owned = []
+    base = 0
+    for length in lengths:
+        assert length % (2 * size) == 0
+        width = length // (2 * size)
+        for chunk in (rank, 2 * size - 1 - rank):
+            start = base + chunk * width
+            owned.extend(range(start, start + width))
+            low = max(base, start - layer.halo)
+            high = start + width
+            if intervals and intervals[-1][2] == base and low <= intervals[-1][1]:
+                previous = intervals.pop()
+                intervals.append((previous[0], max(previous[1], high), base))
+            else:
+                intervals.append((low, high, base))
+        base += length
+    rows = [row for low, high, _ in intervals for row in range(low, high)]
+    positions = [row - doc for low, high, doc in intervals for row in range(low, high)]
+    mapping = {row: i for i, row in enumerate(rows)}
+    indices = torch.tensor(rows, device=hidden.device, dtype=torch.long)
+    output_indices = torch.tensor(
+        [mapping[row] for row in owned], device=hidden.device, dtype=torch.long
+    )
+    if hidden.shape[0] != sum(lengths) // size:
+        raise RuntimeError("Input-halo PLE hidden rows do not match physical layout")
+    transport = _resolve_transport(
+        os.environ.get("QWEN38_PLE_INPUT_HALO_TRANSPORT", "halo"), lengths, size, layer.halo
+    )
+    if transport == "full":
+        # Retain native collective payload/layout while restricting PLE compute.
+        # Useful when BF16 reductions change order with compact halo placement.
+        from megatron.core.ssm.mamba_context_parallel import reconstruct_tensor_cp
+
+        full = reconstruct_tensor_cp(
+            hidden, layer._cp_packed_seq_params, dim=0, differentiable=True
+        )
+        x = full.index_select(0, indices)
+    elif transport == "halo":
+        x = _gather_input_halo(hidden, lengths, rows, layer.halo, group)
+    else:
+        raise ValueError("PLE transport must be halo or full")
+    embeddings = layer.ple_embedding(layer._ngram_ids.index_select(1, indices)).to(x.dtype)
+    key = norm(layer.key_proj(embeddings), layer.norm_key.weight, layer.n, layer.norm_eps)
+    value = layer.value_proj(embeddings)
+    query = norm(x, layer.norm_query.weight, layer.n, layer.norm_eps)
+    shape = (*x.shape[:2], layer.n, layer.hidden_size)
+    gate = (key.float().view(shape) * query.float().view(shape)).sum(-1, keepdim=True) / math.sqrt(
+        layer.hidden_size
+    )
+    gate = gate.abs().clamp_min(1e-6).sqrt() * gate.sign()
+    gated = (torch.sigmoid(gate) * value.float().unsqueeze(-2)).to(x.dtype).reshape_as(x)
+    normalized = norm(gated, layer.norm_conv.weight, layer.n, layer.norm_eps)
+    # Invalid prefix outputs are discarded; each retained output has its complete
+    # document-bounded halo in the same interval. Document starts retain zero padding.
+    position_tensor = torch.tensor(positions, device=x.device, dtype=torch.long).view(-1, 1)
+    conv = layer._causal_dilated_conv(normalized, position_tensor)
+    result = gated + F.silu(conv.float()).to(x.dtype)
+    return result.index_select(0, output_indices)
+
+
+def _gather_input_halo(
+    hidden: torch.Tensor,
+    lengths: tuple[int, ...],
+    selected_rows: list[int],
+    halo: int,
+    group: torch.distributed.ProcessGroup,
+) -> torch.Tensor:
+    """Gather only boundary input rows, reduce their adjoints after pointwise PLE.
+
+    Every boundary row, including its owner's own contribution, traverses the
+    same differentiable gather. Interior and boundary gradients have disjoint
+    input ownership. This implementation builds metadata on CPU from static lengths.
+    """
+    from bisect import bisect_right
+    from megatron.core.tensor_parallel.mappings import gather_from_sequence_parallel_region
+
+    size, rank = group.size(), group.rank()
+    bounds = [0]
+    for length in lengths:
+        bounds.append(bounds[-1] + length)
+
+    def owner_and_offset(row: int) -> tuple[int, int]:
+        doc = bisect_right(bounds, row) - 1
+        width = lengths[doc] // (2 * size)
+        relative = row - bounds[doc]
+        chunk = relative // width
+        owner = min(chunk, 2 * size - 1 - chunk)
+        offset = bounds[doc] // size + (width if chunk >= size else 0) + relative % width
+        return owner, offset
+
+    boundary = [set() for _ in range(size)]
+    for dest in range(size):
+        for doc, length in enumerate(lengths):
+            width = length // (2 * size)
+            for chunk in (dest, 2 * size - 1 - dest):
+                start = bounds[doc] + chunk * width
+                for row in range(max(bounds[doc], start - halo), start):
+                    owner, _ = owner_and_offset(row)
+                    if owner != dest:
+                        boundary[owner].add(row)
+    boundary = [sorted(values) for values in boundary]
+    capacity = max(map(len, boundary))
+    if capacity == 0:
+        indices = torch.tensor(
+            [owner_and_offset(row)[1] for row in selected_rows], device=hidden.device
+        )
+        return hidden.index_select(0, indices)
+    send_indices = torch.tensor(
+        [owner_and_offset(row)[1] for row in boundary[rank]], device=hidden.device, dtype=torch.long
+    )
+    outgoing = hidden.index_select(0, send_indices)
+    outgoing = F.pad(outgoing, (0, 0, 0, 0, 0, capacity - len(boundary[rank])))
+    gathered = gather_from_sequence_parallel_region(
+        outgoing, tensor_parallel_output_grad=True, group=group
+    )
+    boundary_slots = {
+        row: owner * capacity + slot
+        for owner, values in enumerate(boundary)
+        for slot, row in enumerate(values)
+    }
+    selected = []
+    for row in selected_rows:
+        if row in boundary_slots:
+            selected.append(hidden.shape[0] + boundary_slots[row])
+        else:
+            owner, offset = owner_and_offset(row)
+            assert owner == rank, "Required remote row missing from halo"
+            selected.append(offset)
+    combined = torch.cat((hidden, gathered), dim=0)
+    return combined.index_select(0, torch.tensor(selected, device=hidden.device, dtype=torch.long))
+
+
+def prepare_input_halo_cp(layer: PerLayerEmbedding, packed: PackedSeqParams) -> None:
+    from relax.backends.megatron.qsa_layout_metadata import valid_physical_layout
+
+    record = valid_physical_layout(packed)
+    if record is None or packed.qkv_format != "thd":
+        raise ValueError("Input-halo PLE requires producer-bound packed THD physical boundaries")
+    bounds = record[2]
+    lengths = tuple(b - a for a, b in zip(bounds[:-1], bounds[1:]))
+    size = parallel_state.get_context_parallel_world_size()
+    if size <= 1 or layer.tp_group.size() != 1:
+        raise ValueError("Input-halo PLE requires TP1 and CP>1")
+    if bounds[0] != 0 or any(n <= 0 or n % (2 * size) for n in lengths):
+        raise ValueError("Invalid input-halo PLE physical partition")
+    if sum(lengths) != layer._ngram_ids.shape[1]:
+        raise ValueError("Input-halo PLE prepared token IDs do not match physical boundaries")
+    if layer._cp_packed_seq_params is None:
+        raise ValueError("Input-halo PLE requires native packed prepare first")
+    # Bridge checkpoint closures already capture and restore this object together
+    # with ngram IDs and positions. Independent layer attributes would be stale
+    # when a later microbatch is prepared before an earlier one recomputes.
+    layer._cp_packed_seq_params.ple_input_halo_lengths = lengths
+    layer._cp_packed_seq_params.ple_input_halo_packed = packed
