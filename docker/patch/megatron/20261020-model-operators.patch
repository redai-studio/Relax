diff --git a/megatron/core/fusions/fused_linear_cross_entropy.py b/megatron/core/fusions/fused_linear_cross_entropy.py
new file mode 100644
index 0000000..4570f5d
--- /dev/null
+++ b/megatron/core/fusions/fused_linear_cross_entropy.py
@@ -0,0 +1,36 @@
+# Copyright (c) 2026 Relax Authors. All Rights Reserved.
+"""Bridge the combined output head to Relax's Blackwell linear CE kernel."""
+
+from typing import Literal, Optional
+
+import torch
+
+
+def linear_cross_entropy(
+    hidden: torch.Tensor,
+    weight: torch.Tensor,
+    labels: torch.Tensor,
+    tp_group: Optional[torch.distributed.ProcessGroup] = None,
+    reduction: Literal["none", "sum", "mean"] = "mean",
+    ignore_index: int = -100,
+    sequence_parallel: bool = False,
+) -> torch.Tensor:
+    """Compute loss over a vocabulary shard, gathering SP rows if needed."""
+    from megatron.core.tensor_parallel import gather_from_sequence_parallel_region
+
+    from relax.backends.megatron.kernels.linear_cross_entropy import linear_cross_entropy as kernel
+
+    if sequence_parallel:
+        hidden = gather_from_sequence_parallel_region(
+            hidden, tensor_parallel_output_grad=False, group=tp_group
+        )
+    if ignore_index != -100:
+        labels = labels.masked_fill(labels == ignore_index, -100)
+    losses, _ = kernel(hidden, weight, labels, tp_group, accumulate=False, return_logits=False)
+    if reduction == "none":
+        return losses
+    if reduction == "sum":
+        return losses.sum()
+    if reduction == "mean":
+        return losses.sum() / labels.ne(-100).sum()
+    raise ValueError(f"Unsupported reduction {reduction!r}")
