+    @staticmethod
+    def _add_relax_logprob_base64(meta_info, state, top_k, query_ids):
+        """Compact OPD transport, retaining IDs needed for alignment checks."""
+        def encode(values, dtype):
+            return pybase64.b64encode(np.asarray(values, dtype=dtype).tobytes()).decode("ascii")
+
+        def pack_rows(prefix, values, ids, length_suffix):
+            lengths = [len(row) if row else 0 for row in values]
+            flat_values = [value for row in values if row for value in row]
+            flat_ids = [token for row in ids if row for token in row]
+            meta_info[f"{prefix}_val_b64"] = encode(flat_values, "float32")
+            meta_info[f"{prefix}_idx_b64"] = encode(flat_ids, "int32")
+            meta_info[f"{prefix}_{length_suffix}"] = lengths
+
