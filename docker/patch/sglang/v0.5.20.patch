+def match_head_gate_q_scale(
+    weights: torch.Tensor, q_scale: torch.Tensor
+) -> torch.Tensor:
+    """Broadcast head-gate weights up to ``q_scale``'s head count.
+
+    Models whose indexer has fewer heads than the query projection (e.g. GLM-5)
+    produce ``weights`` with fewer heads than ``q_scale``; the subsequent
+    ``weights.unsqueeze(-1) * q_scale`` would otherwise broadcast incorrectly.
+    """
+    if weights.shape[1] < q_scale.shape[1]:
+        assert q_scale.shape[1] % weights.shape[1] == 0
+        weights = weights.repeat_interleave(q_scale.shape[1] // weights.shape[1], dim=1)
+    return weights
