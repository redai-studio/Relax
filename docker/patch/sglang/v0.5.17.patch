+@dataclass(frozen=True)
+class LoRAExecutionIdentity:
+    cohort_id: str
+    engine_boot_id: str
+    native_lora_id: Optional[str]
+    owner_epoch: str
+    session_id: str
+    rid: str
+    kind: str = "business"  # Filled by trusted tokenizer context, not public JSON.
+    dp_rank: int = 0  # Stable Session route, assigned by the tokenizer.
+
+    @property
+    def session_key(self) -> tuple:
+        return (self.cohort_id, self.engine_boot_id, self.owner_epoch, self.session_id)
+
+    @property
+    def attempt_key(self) -> tuple:
+        # The adapter is deliberately NOT part of the deduplication key.
+        return (
+            self.cohort_id,
+            self.engine_boot_id,
+            self.owner_epoch,
+            self.session_id,
+            self.rid,
+        )
+
+    @property
+    def instance_key(self) -> tuple:
+        return self.engine_boot_id, self.native_lora_id
