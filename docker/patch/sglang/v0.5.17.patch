+            components=(CT.FULL, CT.MAMBA),
+            page_size=64,
+            num_layers=2,
+            full_attention_layer_ids=(1,),
+            kv_size=32768,
+            max_num_reqs=4,
+            max_context_len=9000,
+            head_num=1,
+            head_dim=8,
+            enable_mamba_extra_buffer=True,
+        )
+        pool_class = native.HybridReqToTokenPool
+
+        def pool(**kwargs):
+            kwargs["speculative_num_draft_tokens"] = None
+            return pool_class(**kwargs)
+
+        with (
+            mock.patch.object(native, "get_device", return_value="cpu"),
+            mock.patch.object(native, "HybridReqToTokenPool", side_effect=pool),
+        ):
+            self.cache, self.allocator, self.pool = native.build_fixture(self.cfg)
+        self.helper = native.UnifiedRadixCacheSuite()
+        self.helper.cfg = self.cfg
+        self.cache.tree_core.set_hicache_enabled()
+        self.cache.write_through_threshold = 1
+        self.cache.cache_controller = NS(write_policy="write_through")
+        self.backups = []
+        self.backup_lock_refs = []
+        patcher = mock.patch.object(
+            self.cache, "_execute_kv_backup", side_effect=self.copy_to_host
+        )
+        self.copy_mock = patcher.start()
+        self.addCleanup(patcher.stop)
