+"""CPU lifecycle regressions with native Full/Mamba trees and request pools.
+
+Only the DMA boundary is replaced; no CUDA tensors, model forward, or L3 I/O.
+The TP2 smoke separately validates physical backup and storage consumption.
+"""
+
+from array import array
+from types import SimpleNamespace as NS
