+"""CPU file-backend checks with real quotas, files, epochs, and TP suffixes."""
+
+import torch
+
+from sglang.srt.mem_cache.hicache_storage import HiCacheFile, HiCacheStorageConfig
+
+
+def make_cache(path, rank, monkeypatch):
+    monkeypatch.setenv("SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR", str(path))
+    return HiCacheFile(
+        HiCacheStorageConfig(
+            tp_rank=rank,
+            tp_size=2,
+            pp_rank=0,
+            pp_size=1,
+            attn_cp_rank=0,
+            attn_cp_size=1,
+            is_mla_model=False,
+            enable_storage_metrics=False,
+            is_page_first_layout=True,
+            model_name="native-test",
+            extra_config={
+                "max_size": 256,
+                "min_free_space": 0,
+                "eviction_ratio": 0.75,
+                "enable_metadata_cache": False,
+            },
+        )
+    )
+
+
+def test_old_epochs_and_incarnations_share_quota_without_evicting_peer(
+    tmp_path, monkeypatch
+):
+    first, peer = [make_cache(tmp_path, rank, monkeypatch) for rank in range(2)]
+    for cache in (first, peer):
+        cache.initialize_weight_namespace("a" * 32)
+    page = torch.arange(16, dtype=torch.float32)
+    assert peer.set("peer", page)
+    peer_path = peer._get_component_path("peer")
+    for epoch in range(8):
+        assert first.set("prefix", page)
+        assert first.set("prefix.mamba", page)
+        assert first.exists("prefix") and first.exists("prefix.mamba")
+        assert sum(p.stat().st_size for p in tmp_path.glob("*_0_2.bin")) <= 256
+        assert peer.exists("peer")
+        assert torch.equal(peer.get("peer", torch.empty_like(page)), page)
+        first.advance_weight_namespace()
+        assert not first.exists("prefix")
+    restarted = make_cache(tmp_path, 0, monkeypatch)
+    restarted.initialize_weight_namespace("b" * 32)
+    assert not restarted.exists("prefix")
+    assert restarted.set("after-restart", page)
+    assert sum(p.stat().st_size for p in tmp_path.glob("*_0_2.bin")) <= 256
+    assert peer._get_component_path("peer") == peer_path
+    assert peer.exists("peer")
+
+
+def test_write_larger_than_quota_is_rejected_without_partial_file(
+    tmp_path, monkeypatch
+):
+    cache = make_cache(tmp_path, 0, monkeypatch)
+    cache.initialize_weight_namespace("a" * 32)
+    assert not cache.set("too-large", torch.ones(257, dtype=torch.uint8))
+    assert not list(tmp_path.iterdir())
+    assert cache.set("fits", torch.ones(64, dtype=torch.uint8))
+    assert not list(tmp_path.glob("*.tmp.*"))
