+    def poll(self) -> KVPoll:
+        status = self.req.disagg_kv_sender.poll()
+        entry = self.req.time_stats.prefill_bootstrap_queue_entry_time
+        if (
+            status == KVPoll.Bootstrapping
+            and entry > 0
+            and self.now - entry > self.timeout
+        ):
+            # Failed is reduced with MIN across the existing CP/TP groups.
+            # All ranks must remove the same requests from their queues.
+            return KVPoll.Failed
+        return status
