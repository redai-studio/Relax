+    async def _change_lora_memory(
+        self,
+        action: str,
+        tags: Optional[list[str]] = None,
+        *,
+        sequence: Optional[int] = None,
+    ) -> dict:
+        """Explicit resource handoff, never called by version publication.
+
+        The operation owns its HTTP-independent task. Ambiguous partial failure
+        leaves admission closed; no timer can declare memory restored.
+        """
+        control = self.lora_version_control
+        allowed = {"weights", "kv_cache", "cuda_graph"}
+        tags = tuple(sorted(set(tags or allowed)))
+        if action not in ("suspend", "resume") or not set(tags) <= allowed:
+            raise ValueError("INVALID_MEMORY_OPERATION")
+        if control.mutate is None:
+            raise ValueError("MEMORY_CONTROL_NOT_CONFIGURED")
+        intent = (action, tags)
+        sequence = control.memory_sequence + 1 if sequence is None else sequence
+        if type(sequence) is not int or sequence < 1:
+            raise ValueError("INVALID_MEMORY_SEQUENCE")
+        if sequence < control.memory_sequence:
+            raise ValueError("STALE_MEMORY_OPERATION")
+        if sequence == control.memory_sequence:
+            if intent != control.memory_intent:
+                raise ValueError("MEMORY_SEQUENCE_CONFLICT")
+            return await asyncio.shield(control.memory_task)
+        if sequence != control.memory_sequence + 1:
+            raise ValueError("MEMORY_SEQUENCE_GAP")
+        if control.memory_task is not None and not control.memory_task.done():
+            raise ValueError("MEMORY_OPERATION_BUSY")
+        if control.memory_state == "UNKNOWN":
+            raise ValueError("MEMORY_STATE_UNKNOWN")
+        if action == "suspend" and control.memory_state == "RESIDENT":
+            # Do not race a load/clear or a probe into a parked device. The
+            # caller can retry once these already owned tasks have settled.
+            tasks = [control.probe_task]
+            tasks.extend(r.close_task for r in control.sessions.values())
+            for record in control.versions.values():
+                tasks.append(record.work_task)
+            if any(task is not None and not task.done() for task in tasks):
+                raise ValueError("MEMORY_OPERATION_BUSY")
+        control.memory_intent = intent
+        control.memory_sequence = sequence
+        control.memory_state = "QUIESCING" if action == "suspend" else "RESTORING"
+        control.resident.clear()  # No await between admission fence and task ownership.
+
+        async def change_owned():
+            try:
+                if action == "suspend":
+                    executions = [
+                        r for r in control.requests.values() if r.identity is not None
+                    ]
+                    for record in executions:
+                        if not record.dispatched and not record.drained:
+                            control.cancel(record.identity)
+                    for record in executions:
+                        await record.completion.wait()
+                        if not record.drained:
+                            raise RuntimeError("MEMORY_EXECUTION_DRAIN_UNKNOWN")
+                command = LoRAMemoryCommand(
+                    *control.owner, uuid.uuid4().hex, action, tags, sequence=sequence
+                )
+                replies = await control.mutate(command)
+                if (
+                    len(replies) != len(control.worker_boots or ("",))
+                    or len({reply.sender_rank for reply in replies}) != len(replies)
+                    or any(
+                        reply.control_key != command.control_key
+                        or not control.valid_worker(reply)
+                        for reply in replies
+                    )
+                ):
+                    raise RuntimeError("MEMORY_CONTROL_IDENTITY_MISMATCH")
+                if any(reply.error for reply in replies):
+                    raise RuntimeError(
+                        "; ".join(reply.error for reply in replies if reply.error)
+                    )
+                remaining = replies[0].offloaded_tags
+                expected = (
+                    set(control.offloaded_tags) | set(tags)
+                    if action == "suspend"
+                    else set(control.offloaded_tags) - set(tags)
+                )
+                if any(set(reply.offloaded_tags) != expected for reply in replies):
+                    raise RuntimeError("MEMORY_WORKER_STATE_MISMATCH")
+                control.offloaded_tags = remaining
+                control.memory_state = "SUSPENDED" if remaining else "RESIDENT"
+                if not remaining:
+                    control.resident.set()
+                return {
+                    "memory_state": control.memory_state,
+                    "offloaded_tags": remaining,
+                }
+            except BaseException:
+                control.memory_state = "UNKNOWN"
+                raise
+
+        control.memory_task = asyncio.create_task(change_owned())
+        control.memory_task.add_done_callback(
+            lambda task: task.exception() if not task.cancelled() else None
+        )
+        return await asyncio.shield(control.memory_task)
