+"""CPU regressions for native HiCache ownership and TP failure agreement.
+
+Load the actual methods without CUDA-only module imports. Gloo cases use two
+real processes; no collective is mocked in those tests.
+"""
+
+from __future__ import annotations
+
+import ast
+import datetime
+import hashlib
+import json
+import logging
+import multiprocessing
+import os
+import threading
+import time
+import traceback
+import uuid
+from collections import namedtuple
+from contextlib import contextmanager
+from pathlib import Path
+from queue import Empty, Queue
+from types import SimpleNamespace as NS
+
+import pytest
+import torch
+import torch.distributed as dist
+
+SOURCE = Path(__file__).resolve().parents[4] / "python/sglang/srt"
+LOGGER = logging.getLogger(__name__)
+Info = namedtuple(
+    "Info",
+    "anchor_node_id prefetch_key host_indices operation anchor_lock_params comp_xfers",
+)
+
+
+def methods(path, cls, names, **extra):
+    source = SOURCE / path
+    parsed = ast.parse(source.read_text())
+    klass = next(
+        n for n in parsed.body if isinstance(n, ast.ClassDef) and n.name == cls
+    )
+    selected = [
+        n for n in klass.body if isinstance(n, ast.FunctionDef) and n.name in names
+    ]
+    assert {n.name for n in selected} == set(names)
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__", names=[ast.alias(name="annotations")], level=0
+            ),
+            *selected,
+        ],
+        type_ignores=[],
+    )
+    env = dict(
+        torch=torch,
+        threading=threading,
+        time=time,
+        hashlib=hashlib,
+        json=json,
+        logger=LOGGER,
+        Queue=Queue,
+        Empty=Empty,
+        os=os,
+        uuid=uuid,
