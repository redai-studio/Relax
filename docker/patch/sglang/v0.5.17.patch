+        **outputs,
+    )
+    manager = cls()
+    events = []
+    backend = NS(weight_namespace="a" * 32 + "-0", weight_epoch=0, file_path="test")
+
+    def advance():
+        backend.weight_epoch += 1
+        backend.weight_namespace = "a" * 32 + f"-{backend.weight_epoch}"
+        events.append("epoch")
