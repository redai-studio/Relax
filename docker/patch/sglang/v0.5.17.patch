+def native_cache(reduce, capacity=32, component_fails=False):
+    cls = methods(
+        "mem_cache/unified_radix_cache.py",
+        "UnifiedRadixCache",
+        NATIVE_METHODS,
+        RadixKey=Key,
+        PoolTransfer=lambda **kwargs: NS(**kwargs),
+        PoolName=NS(KV="full"),
+        BASE_COMPONENT_TYPE="full",
+        CacheTransferPhase=NS(PREFETCH="prefetch"),
+    )
+    cache = cls()
+    pool, auxiliary = Pool(capacity), Pool()
+    submitted, released, locks = [], [], []
+
+    def release(extra):
+        for transfer in extra:
+            auxiliary.free(transfer.host_indices)
+
+    def prefetch(rid, key, last_hash, prefix_keys, **kwargs):
+        op = operation(rid, len(key))
+        submitted.append(op)
+        return op
+
+    cc = NS(
+        mem_pool_host=pool,
+        prefetch_tokens_occupied=0,
+        prefetch_rate_limited=lambda: False,
+        prefetch=prefetch,
+        release_unsubmitted_prefetch=release,
+        prefetch_revoke_queue=Queue(),
+        prefetch_hit_queue=Queue(),
+        prefetch_buffer=Queue(),
+        ack_backup_queue=Queue(),
+        host_mem_release_queue=Queue(),
+        extra_host_mem_release_queues={},
+        terminate_prefetch=lambda op: (op.completed_tokens, op.hash_value),
+        append_host_mem_release=lambda **kwargs: released.append(kwargs),
+    )
+    cache.cache_controller = cc
+    cache.enable_storage, cache.enable_storage_metrics = True, False
+    cache.storage_metrics_collector = None
+    (
+        cache.ongoing_prefetch,
+        cache.ongoing_backup,
+        cache.prefetch_loaded_tokens_by_reqid,
+    ) = {}, {}, {}
+    cache.aborted_prefetch, cache._native_prefetch_sequence = set(), 0
+    cache._all_reduce_attn_groups = reduce
+    cache.page_size, cache.prefetch_threshold = 1, 1
+    (
+        cache.prefetch_stop_policy,
+        cache.prefetch_timeout_base,
+        cache.prefetch_timeout_per_page,
+    ) = "wait_complete", 1, 1
+    cache.evict_host = lambda count: None
+    cache.inc_host_lock_ref = lambda node: (
+        locks.append(node) or NS(to_dec_params=lambda: node)
+    )
+    cache.dec_host_lock_ref = lambda node, params: locks.remove(node)
+    cache.tree_components = ["full", "mamba"]
+    cache.components = {
+        "mamba": NS(
+            prepare_prefetch=lambda *a, **k: NS(
+                alloc_failed=component_fails,
+                host_indices=None if component_fails else torch.tensor([9]),
+            )
+        )
+    }
+    cache.tree_core = NS(
+        is_eagle=False,
+        prefetch_anchor_info=lambda node: None,
+        build_hicache_transfers=lambda *a, **k: [
+            NS(name="mamba", host_indices=k["host_indices"])
+        ],
+    )
+    cache._build_sidecar_transfers = lambda *args: []
+    return cache, pool, auxiliary, submitted, released, locks
