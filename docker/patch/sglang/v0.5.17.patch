+def query_error_round(reduce, rank):
+    cls = methods(
+        "managers/cache_controller.py", "HiCacheController", ["prefetch_thread_func"]
+    )
+    cc = cls()
+    cc.prefetch_queue, cc.prefetch_revoke_queue, cc.prefetch_hit_queue = (
+        Queue(),
+        Queue(),
+        Queue(),
+    )
+    cc.storage_stop_event = threading.Event()
+    cc.storage_stop_event.set()  # Drain just the submitted item, then exit.
+    cc.prefetch_io_aux_func = lambda: None
+    cc._all_reduce_prefetch_groups = reduce
+    cc.prefetch_threshold = cc.page_size = 1
+
+    def query(op):
+        if rank == 1 and op.request_id == "bad":
+            raise OSError("one TP rank cannot query its SSD")
+        return ["a"] * 8, 8
+
+    cc._storage_hit_query = query
+    for name in ("bad", "good"):
+        op = operation(name)
+        op.revoke_with_operation = True
+        cc.prefetch_queue.put(op)
+        cc.prefetch_thread_func()
+        cc.prefetch_io_aux_thread.join(3)
+        if name == "bad":
+            assert cc.prefetch_revoke_queue.get_nowait() is op
+            assert cc.prefetch_hit_queue.empty()
+        else:
+            assert cc.prefetch_hit_queue.get_nowait() is op
+            assert op.storage_hit_count == 8
