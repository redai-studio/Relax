+    def __init__(self, operation: str):
+        self.operation = operation
+        super().__init__(f"{self.code}: {operation}")
+
+
+@dataclass(frozen=True)
+class NativeLoadIdentity:
+    engine_boot_id: str
+    native_lora_id: str
+
+    @property
