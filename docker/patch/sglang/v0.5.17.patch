+        }
+
+    def _publication_owner(self, payload: dict) -> LoRAVersionControl:
+        self.lora_publication_capability()
+        control = self.lora_version_control
+        if (payload.get("cohort_id"), payload.get("engine_boot_id")) != control.owner:
+            raise ValueError("ENGINE_EPOCH_MISMATCH")
+        return control
+
+    def _publication_version(self, payload: dict, *, create: bool = False):
+        from pathlib import Path
+
+        control = self._publication_owner(payload)
+        uid, digest = payload["native_lora_id"], payload["digest"]
+        if (
+            not isinstance(uid, str)
+            or not uid
+            or len(uid) > 128
+            or not isinstance(digest, str)
+            or len(digest) != 64
+        ):
+            raise ValueError("INVALID_INSTANCE_DESCRIPTOR")
+        record = control.versions.get(uid)
+        if record is not None:
+            if record.digest != digest:
+                raise ValueError("INSTANCE_CONTENT_CONFLICT")
+        elif create:
+            # Retire-before-load needs no artifact path and must not touch disk.
+            path = payload.get("path")
+            if path is not None:
+                path = Path(path).resolve(strict=True)
+                if not path.is_relative_to(self._lora_artifact_root):
+                    raise ValueError("INVALID_ARTIFACT_PATH")
+            ref = LoRARef(
+                lora_id=uid,
+                lora_name=uid,
+                lora_path=str(path) if path else None,
+                pinned=True,
+            )
+            identity = NativeLoadIdentity(control.owner[1], uid)
+            record = control._version(identity, digest, ref)
+        return record
+
+    def _publication_result(self, payload: dict, record) -> dict:
+        result = {
+            **self.lora_publication_capability(),
+            "digest": payload["digest"],
+            "native_lora_id": record.identity.native_lora_id
+            if record
+            else payload["native_lora_id"],
+            "state": record.state if record else "UNKNOWN",
+            "pinned": bool(record and record.state == "READY" and record.ref.pinned),
+            "resident": bool(
+                record
+                and record.state == "READY"
+                and self.lora_version_control.memory_state == "RESIDENT"
+            ),
+            "fenced": bool(record and record.fenced),
+            "error": record.error if record else None,
+            "actual_unload_count": record.actual_unload_count if record else None,
+            "observation": record.observation if record else None,
+        }
+        return result
+
+    async def prepare_lora_publication(self, payload: dict) -> dict:
+        control = self._publication_owner(payload)
+        control.require_resident()
+        record = self._publication_version(payload, create=True)
+        if not record.fenced and record.state != "READY":
+            if not record.ref.lora_path:
+                raise ValueError("ARTIFACT_PATH_REQUIRED")
+            control._start_work(record, self._generate_lora_control_token)
+        return self._publication_result(payload, record)
+
+    def lora_publication_status(self, payload: dict) -> dict:
+        return self._publication_result(payload, self._publication_version(payload))
+
+    async def retire_lora_publication(self, payload: dict) -> dict:
+        record = self._publication_version(payload, create=True)
+        await self.lora_version_control.retire_version(
+            record.identity, record.digest, record.ref
+        )
+        return self._publication_result(payload, record)
+
+    async def close_lora_publication_session(self, payload: dict) -> dict:
+        from sglang.srt.lora.version_control import LoRASessionIdentity
+
+        control = self._publication_owner(payload)
+        if (
+            payload["session_id"].startswith("relax-health:")
+            or payload["owner_epoch"] == "native-health"
+        ):
+            raise ValueError("RESERVED_SESSION_ID")
+        identity = LoRASessionIdentity(
+            *control.owner, payload["owner_epoch"], payload["session_id"]
+        )
+        if not identity.owner_epoch or not identity.session_id:
+            raise ValueError("INVALID_SESSION_ID")
+        state = await control.close_session(identity)
+        return {
+            **self.lora_publication_capability(),
+            "owner_epoch": identity.owner_epoch,
+            "session_id": identity.session_id,
+            "state": state,
+        }
+
+    def lora_publication_attempt(self, payload: dict, *, cancel: bool = False) -> dict:
+        control = self._publication_owner(payload)
+        if (
+            payload["session_id"].startswith("relax-health:")
+            or payload["owner_epoch"] == "native-health"
+        ):
+            raise ValueError("RESERVED_SESSION_ID")
+        identity = LoRAExecutionIdentity(
+            *control.owner,
+            payload["native_lora_id"],
+            payload["owner_epoch"],
+            payload["session_id"],
+            payload["rid"],
+            dp_rank=control.session_dp_rank(
+                payload["owner_epoch"], payload["session_id"]
+            ),
+        )
+        if identity.rid.startswith("relax-probe-"):
+            raise ValueError("RESERVED_REQUEST_ID")
+        if cancel:
+            control.cancel(identity)
+        record = control._record(identity)
+        session = control.sessions.get(identity.session_id)
+        if session is not None and session.identity.owner_epoch != identity.owner_epoch:
+            raise ValueError("SESSION_ID_CONFLICT")
+        state = "UNKNOWN"
+        if session is not None and session.closed:
+            state = "SESSION_DRAINED"
+        elif (
+            control.outcome(identity) is not None and control.outcome(identity).terminal
+        ):
+            state = "REQUEST_FINISHED"
+        elif record is not None:
+            state = "SUBMITTED" if record.dispatched else "ACCEPTED"
+        # UNKNOWN never proves absence, including status-before-submit.
+        return {
+            **self.lora_publication_capability(),
+            **dataclasses.asdict(identity),
+            "state": state,
+            "error": record.error if record else None,
+            # Static topology for diagnostics, not a per-request ACK set.
+            "execution_workers": sorted(control.execution_workers(identity)),
+        }
+
+    def bind_lora_publication_request(self, obj) -> None:
+        """Validate external identity and attach trusted native execution context."""
+        payload = getattr(obj, "lora_binding", None)
+        if payload is None:
+            return  # The native gate rejects unbound public requests in this mode.
+        version = self._publication_version(payload)
+        if version is None or version.state != "READY" or version.fenced:
+            raise ValueError("ADAPTER_NOT_READY")
+        if payload.get("native_lora_id") != version.identity.native_lora_id:
+            raise ValueError("ADAPTER_IDENTITY_MISMATCH")
+        if (
+            obj.lora_path != version.ref.lora_name
+            or not isinstance(obj.rid, str)
+            or not obj.rid
+            or not isinstance(obj.input_ids, list)
+            or not obj.input_ids
+            or any(type(token) is not int for token in obj.input_ids)
+            or not isinstance(obj.sampling_params, dict)
+            or obj.sampling_params.get("n", 1) != 1
+            or obj.image_data
+            or obj.audio_data
+            or obj.video_data
+            or obj.text is not None
+            or obj.input_embeds is not None
+            or obj.custom_logit_processor is not None
+            or obj.positional_embed_overrides is not None
+            or obj.session_params is not None
+            or obj.lora_id is not None
+        ):
+            raise ValueError("UNSUPPORTED_MANAGED_REQUEST")
+        identity = LoRAExecutionIdentity(
+            self.lora_version_control.owner[0],
+            *version.identity.instance_key,
+            payload["owner_epoch"],
+            payload["session_id"],
+            obj.rid,
+            dp_rank=self.lora_version_control.session_dp_rank(
+                payload["owner_epoch"], payload["session_id"]
+            ),
+        )
+        if not identity.owner_epoch or not identity.session_id:
+            raise ValueError("INVALID_SESSION_ID")
+        if obj.rid.startswith("relax-probe-"):
+            raise ValueError("RESERVED_REQUEST_ID")
+        if (
+            identity.session_id.startswith("relax-health:")
+            or identity.owner_epoch == "native-health"
+        ):
+            raise ValueError("RESERVED_SESSION_ID")
+        if obj.session_id not in (None, identity.session_id):
+            raise ValueError("SESSION_ID_CONFLICT")
+        # Identity here is a validated loaded native instance, not an echoed
+        # client declaration. Actual acquire/submit still occurs downstream.
+        if obj.routed_dp_rank not in (None, identity.dp_rank):
+            raise ValueError("SESSION_DP_ROUTE_CONFLICT")
+        obj.routed_dp_rank = identity.dp_rank
+        obj._lora_execution = identity
+        obj._lora_execution_ref = version.ref
+        obj._lora_adapter_metadata = {
+            "adapter_digest": version.digest,
+            "engine_boot_id": version.identity.engine_boot_id,
+            "native_lora_id": version.identity.native_lora_id,
+        }
+
+    async def _generate_lora_control_token(
+        self: TokenizerManager, identity: LoRAExecutionIdentity, ref: Optional[LoRARef]
+    ) -> None:
+        # Private object attributes cannot be supplied by a public JSON request.
+        # This path uses the same acquire, submit, GPU drain and output lifecycle
+        # as real generation. Its prompt must stay outside cache-test prefixes.
+        obj = GenerateReqInput(
+            rid=identity.rid,
+            input_ids=[0],
+            sampling_params={"max_new_tokens": 1, "temperature": 0.0},
+            lora_path=ref.lora_name if ref is not None else None,
+            stream=False,
+            log_metrics=False,
+            routed_dp_rank=identity.dp_rank,
+        )
+        obj._lora_execution = identity
+        obj._lora_execution_ref = ref
+        result = None
+        async for response in self.generate_request(obj):
+            result = response
+        if result is None:
+            raise RuntimeError("INTERNAL_GENERATION_RESULT_MISSING")
+        reason = result.get("meta_info", {}).get("finish_reason")
+        if (
+            not isinstance(reason, dict)
+            or reason.get("type") not in ("stop", "length")
+            or len(result.get("output_ids", ())) != 1
+        ):
+            raise RuntimeError("INTERNAL_GENERATION_FAILED")

