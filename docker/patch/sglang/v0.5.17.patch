+class Pool:
+    def __init__(self, capacity=32):
+        self.capacity, self.freed = capacity, []
+
+    def alloc(self, count):
+        return torch.arange(count) if count <= self.capacity else None
+
+    def free(self, indices):
+        self.freed.extend(indices.tolist())
