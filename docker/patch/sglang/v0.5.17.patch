+@pytest.mark.parametrize(
+    "case",
+    [
+        "component",
+        "rate",
+        "duplicate",
+        "full_partial",
+        "full_none",
+        "cancelled",
+        "identity",
+        "query_error",
+        "weight_stop",
+        "weight_flush",
+        "weight_worker",
