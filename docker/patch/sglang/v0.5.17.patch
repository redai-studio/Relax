+    identity: NativeLoadIdentity
+    control_id: str
+    action: str
+    state: str
+    error: Optional[str] = None
+    actual_unload_count: int = 0
+    observation: Optional[dict] = None
+    sender_rank: int = 0
+    http_worker_ipc: Optional[str] = None
+    worker_boot_id: str = ""
+
+    @property
+    def control_key(self) -> tuple:
+        return self.identity.instance_key, self.control_id, self.action
+
+
+@dataclass
