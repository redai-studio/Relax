+)
+def test_tp2_failure_agreement(tmp_path, case):
+    ctx = multiprocessing.get_context("spawn")
+    processes = [
+        ctx.Process(
+            target=gloo_worker,
+            args=(rank, str(tmp_path / "gloo"), str(tmp_path / f"{rank}.txt"), case),
+        )
+        for rank in range(2)
+    ]
+    for process in processes:
+        process.start()
+    deadline = time.monotonic() + 40
+    try:
+        for process in processes:
+            process.join(max(0, deadline - time.monotonic()))
+        for rank, process in enumerate(processes):
+            evidence = tmp_path / f"{rank}.txt"
+            assert process.exitcode == 0, (
+                evidence.read_text()
+                if evidence.exists()
+                else "TP process did not finish"
+            )
+            assert evidence.read_text() == "PASS"
+    finally:
+        for process in processes:
+            if process.is_alive():
+                process.terminate()
+                process.join(3)
