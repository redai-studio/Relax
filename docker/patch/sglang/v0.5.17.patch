+
+def execution_boot_id(tokenizer_boot_id: str, worker_boots: tuple[str, ...]) -> str:
+    digest = hashlib.sha256(json.dumps(worker_boots).encode()).hexdigest()
+    return f"{tokenizer_boot_id}:{digest}"
+
+
+def execution_rank(scheduler: Any) -> int:
+    ps = getattr(scheduler, "ps", None)
+    return getattr(ps, "pp_rank", 0) * getattr(ps, "tp_size", 1) + getattr(
+        ps, "tp_rank", 0
+    )
+
+
+def validate_execution_commit(scheduler: Any, request: LoRAExecutionInit) -> str:
+    """A late commit cannot install an old owner on a restarted worker."""
+    boots = request.worker_boots
+    rank = execution_rank(scheduler)
+    if (
+        not boots
+        or len(boots) != scheduler.ps.tp_size * getattr(scheduler.ps, "pp_size", 1)
+        or len(set(boots)) != len(boots)
+        or not all(isinstance(boot, str) and boot for boot in boots)
+        or not 0 <= rank < len(boots)
+        or boots[rank] != scheduler._lora_scheduler_boot_id
+    ):
+        raise ValueError("ENGINE_EPOCH_MISMATCH")
+    return execution_boot_id(request.tokenizer_boot_id, boots)
+
+
+def send_managed_reply(scheduler: Any, reply: Any) -> None:
+    """Instance controls fan out; request completion uses the native output leader."""
+    if isinstance(reply, LoRAExecutionReply) and not request_leader(scheduler):
+        return
+    reply = replace(
+        reply,
+        sender_rank=execution_rank(scheduler),
+        worker_boot_id=getattr(scheduler, "_lora_scheduler_boot_id", ""),
+    )
+    channel = getattr(scheduler, "_lora_reply_socket", None)
+    if channel is None:
+        scheduler.ipc_channels.send_to_tokenizer.send_output(reply)
+    else:
+        channel.send_pyobj(reply)
+
+
+def configure_execution_tracking(
+    scheduler: Any, cohort_id: str, engine_boot_id: str, max_records: int
+) -> None:
+    """Called by native bootstrap after the tokenizer/scheduler boot handshake.
+
+    This is deliberately not an HTTP-configurable switch. The first profile
+    must exclude queues and streams not covered by native instance drain.
+    """
+    args = scheduler.server_args
+    unsupported = (
+        scheduler.device != "cuda"
+        or not scheduler.enable_lora
+        or (args.dp_size != 1 and not args.enable_dp_attention)
+        or (
+            scheduler.ps.pp_size > 1
+            and scheduler.model_config.hf_config.model_type == "llama"
+            and getattr(scheduler.model_config.hf_config, "tie_word_embeddings", False)
+        )
+        or args.tokenizer_worker_num != 1
+        or args.enable_strict_thinking
+        or scheduler.disaggregation_mode.value != "null"
+        or not (
+            scheduler.spec_algorithm.is_none() or scheduler.spec_algorithm.is_ngram()
+        )
+        or scheduler.enable_hierarchical_cache
+        or scheduler.enable_hisparse
+        or scheduler.enable_unified_memory
+        or scheduler.dllm_config is not None
+        or scheduler.model_config.is_multimodal
+        or getattr(scheduler, "rust_server", None) is not None
+        or scheduler.model_config.hf_config.model_type
+        not in ("qwen2", "qwen3", "llama")
+        or scheduler.model_config.quantization is not None
+    )
+    if unsupported:
+        raise ValueError("Unsupported immutable LoRA execution profile")
+    if (
+        getattr(scheduler.ps, "attn_cp_size", 1) > 1
+        or getattr(args, "enable_prefill_cp", False)
+        or getattr(args, "enable_cp_decode_attn_tp", False)
+    ):
+        raise ValueError("Prefill CP requires token-to-adapter metadata remapping")
+    dcp_size = getattr(args, "dcp_size", 1)
+    if scheduler.ps.tp_size // args.dp_size % dcp_size:
+        raise ValueError("DCP groups must stay within one attention DP request group")
+    if args.dp_size > 1:
+        manager = scheduler.tp_worker.model_runner.lora_manager
+        # These projections execute before Qwen3's DP token gather. Upstream
+        # MLP/lm_head LoRA metadata does not describe gathered cross-DP tokens.
+        if (
+            scheduler.model_config.hf_config.model_type != "qwen3"
+            or args.lora_backend != "triton"
+            or not set(manager.target_modules) <= {"qkv_proj", "o_proj"}
+        ):
+            raise ValueError("DP attention requires Qwen3 attention-only Triton LoRA")
+
+    if (
+        not cohort_id
+        or not engine_boot_id
+        or type(max_records) is not int
+        or max_records < 1
+    ):
+        raise ValueError("Invalid immutable LoRA execution configuration")
+    owner = (cohort_id, engine_boot_id)
+    if hasattr(scheduler, "lora_execution_owner"):
+        if (
+            scheduler.lora_execution_owner != owner
+            or scheduler.lora_execution_limit != max_records
+        ):
+            raise ValueError("ENGINE_EPOCH_MISMATCH")
+        return
+    # Bootstrap precedes admission; never transfer a running ordinary request
+    # to a new owner by merely creating an empty table.
+    if not scheduler.is_fully_idle():
+        raise ValueError("Execution bootstrap requires an idle engine")
+    scheduler.lora_execution_owner = owner
+    scheduler.lora_execution_limit = max_records
+    scheduler.lora_execution_accepting = True
+    # Only the native output leader indexes live Req objects for completion.
+    # Other workers protect instances through their existing scheduler queues.
+    scheduler.output_streamer.on_terminal = lambda req: finish_native_request(
+        scheduler, req
+    )
+    scheduler.lora_versions = {}
+    scheduler.lora_version_names = {}
+    scheduler.lora_retirements = {}
+    scheduler.lora_loads = {}
+    scheduler.lora_sessions = {}
+    scheduler.lora_session_closures = {}
+
+
+@dataclass
+class AttemptResult:
+    identity: LoRAExecutionIdentity
+    terminal: bool = False
+    used_gpu: bool = False
+    delivery: str = "WAITING"
+    error: Optional[str] = None
+
+
+class LoRAVersionControl:
+    """Tokenizer execution ownership, independent of HTTP/output task lifetime.
+
+    Registration/publish coordination is separate from these request records.
+    The registry remains the only native adapter-reference counter.
+    """
+
+    def __init__(
+        self,
+        registry: Any,
+        send: Any,
+        cohort_id: str,
+        engine_boot_id: str,
+        max_records: int,
+        mutate: Any = None,
+        fence: Any = None,
+        worker_boots: Optional[tuple[str, ...]] = None,
+        dp_size: int = 1,
+        tp_size: Optional[int] = None,
+        requests: Optional[dict] = None,
+    ):
+        if (
+            not cohort_id
+            or not engine_boot_id
+            or type(max_records) is not int
+            or max_records < 1
+        ):
+            raise ValueError("Invalid immutable LoRA execution configuration")
+        self.registry = registry
+        self.send = send
+        self.owner = (cohort_id, engine_boot_id)
+        self.max_records = max_records
+        self.requests = requests if requests is not None else {}
+        self.rids = {}
+        self.accepting = True
+        self.versions = {}
+        self.sessions = {}
+        self.mutate = mutate
+        self.fence = fence
+        self.probe_task = None
+        self.probe_identity = None
+        self.probe_sequence = 0
+        self.probe_drained = 0
+        self.worker_boots = worker_boots
+        self.dp_size = dp_size
+        self.tp_size = tp_size or len(worker_boots or ("",))
+        if dp_size < 1 or self.tp_size % dp_size:
+            raise ValueError("Invalid attention DP topology")
+        width = self.tp_size // self.dp_size
+        self._execution_groups = tuple(
+            frozenset(
+                rank
+                for rank in range(len(worker_boots or ("",)))
+                if (rank % self.tp_size) // width == group
+            )
+            for group in range(self.dp_size)
+        )
+        self.memory_state = "RESIDENT"
+        self.offloaded_tags = ()
+        self.memory_task = None
+        self.memory_intent = None
+        self.memory_sequence = 0
+        self.resident = asyncio.Event()
+        self.resident.set()
+
+    def session_dp_rank(self, owner_epoch: str, session_id: str) -> int:
+        identity = json.dumps([owner_epoch, session_id], separators=(",", ":"))
+        return (
+            int.from_bytes(hashlib.sha256(identity.encode()).digest()[:8], "big")
+            % self.dp_size
+        )
+
+    def execution_workers(self, identity: LoRAExecutionIdentity) -> frozenset:
+        if not 0 <= identity.dp_rank < self.dp_size:
+            raise ValueError("INVALID_DP_ROUTE")
+        return self._execution_groups[identity.dp_rank]
+
+    def require_resident(self) -> None:
+        if self.memory_state != "RESIDENT":
+            raise ValueError("ENGINE_SUSPENDED")
+
+    def valid_worker(self, reply: Any) -> bool:
+        rank = reply.sender_rank
+        return (
+            type(rank) is int
+            and 0 <= rank < len(self.worker_boots or ("",))
+            and (
+                self.worker_boots is None
+                or self.worker_boots[rank] == reply.worker_boot_id
+            )
+        )
+
+    def _version(
+        self, identity: NativeLoadIdentity, digest: str, ref: Any
+    ) -> TokenizerVersion:
+        if identity.engine_boot_id != self.owner[1]:
+            raise ValueError("ENGINE_EPOCH_MISMATCH")
+        if identity.native_lora_id != ref.lora_id or not ref.pinned or not digest:
+            raise ValueError("ADAPTER_IDENTITY_MISMATCH")
+        existing = self.versions.get(identity.native_lora_id)
+        if existing is not None:
+            if (existing.identity, existing.digest, existing.ref) != (
+                identity,
+                digest,
+                ref,
+            ):
+                raise ValueError("INSTANCE_CONTENT_CONFLICT")
+            return existing
+        if len(self.versions) + len(self.rids) + len(self.sessions) >= self.max_records:
+            self.accepting = False
+            raise ValueError("LIFECYCLE_CAPACITY_EXCEEDED")
+        record = TokenizerVersion(identity, ref, digest)
+        self.versions[identity.native_lora_id] = record
+        return record
+
+    async def _command(self, record: TokenizerVersion, action: str) -> LoRAVersionReply:
+        channel = self.fence if action == "fence" else self.mutate
+        if channel is None:
+            raise RuntimeError("Native version control channel is not connected")
+        command = LoRAVersionCommand(
+            record.identity,
+            uuid4().hex,
+            action,
+            record.ref,
+            record.digest,
+        )
+        replies = await channel(command)
+        expected = len(self.worker_boots or ("",))
+        if (
+            len(replies) != expected
+            or len({reply.sender_rank for reply in replies}) != expected
+            or any(
+                reply.control_key != command.control_key or not self.valid_worker(reply)
+                for reply in replies
+            )
+        ):
+            raise RuntimeError("NATIVE_CONTROL_IDENTITY_MISMATCH")
+        replies.sort(key=lambda reply: reply.sender_rank)
+        reply = replies[0]
+        if any(item.error for item in replies):
+            raise RuntimeError(
+                "; ".join(
+                    f"rank {item.sender_rank}: {item.error}"
+                    for item in replies
+                    if item.error
+                )
+            )
+        if any(item.state != reply.state for item in replies):
+            # Fence ACKs may legitimately describe different progress on each
+            # rank; all other phases require the same completed outcome.
+            if action != "fence" or any(
+                item.state not in {"FENCED", "RETIRING", "CLEARING", "ABSENT"}
+                for item in replies
+            ):
+                raise RuntimeError("NATIVE_WORKER_STATE_MISMATCH")
+            reply = replace(reply, state="FENCED")
+        observation = reply.observation
+        if expected > 1:
+            observation = {
+                "workers": {
+                    str(item.sender_rank): item.observation for item in replies
+                },
+                "worker_boots": self.worker_boots,
+            }
+        return replace(
+            reply,
+            observation=observation,
+            actual_unload_count=max(item.actual_unload_count for item in replies),
+        )
+
+    async def _load(self, record: TokenizerVersion) -> None:
+        record.state = "LOADING"
+        reply = await self._command(record, "load")
+        if reply.state != "LOADED":
+            raise RuntimeError("ADAPTER_NOT_LOADED")
+        if not record.fenced:
+            await self.registry.register(record.ref)
+            record.registered = record.counter_present = True
+        record.state = "RETIRING" if record.fenced else "LOADED"
+
+    async def _retire(self, record: TokenizerVersion) -> str:
+        await self.resident.wait()
+        record.state = "RETIRING"
+        await self._command(record, "fence")
+        executions = [
+            r
+            for r in self.requests.values()
+            if r.identity is not None
+            and r.identity.instance_key == record.identity.instance_key
+        ]
+        for execution in executions:
+            if not execution.dispatched:
+                self.cancel(execution.identity)
+        for execution in executions:
+            await execution.completion.wait()
+            if not execution.drained:
+                raise RuntimeError(execution.error or "EXECUTION_UNKNOWN")
+        if record.registered:
+            await self.registry.unregister_exact(record.ref)
+            record.registered = False
+        if record.counter_present:
+            await self.registry.wait_for_unload(record.ref.lora_id)
+            record.counter_present = False
+        reply = await self._command(record, "cleanup")
+        if reply.state != "ABSENT":
+            raise RuntimeError("VERSION_CLEANUP_UNCONFIRMED")
+        record.actual_unload_count = reply.actual_unload_count
+        record.observation = reply.observation
+        record.state = "ABSENT"
+        return record.state
+
+    def _start_work(self, record: TokenizerVersion, warmup=None) -> asyncio.Task:
+        if record.work_task is not None and not record.work_task.done():
+            return record.work_task
+
+        async def work():
+            try:
+                if not record.fenced:
+                    if record.state != "LOADED":
+                        await self._load(record)
+                    if not record.fenced:
+                        record.state = "WARMING"
+                        for dp_rank in range(self.dp_size):
+                            if record.fenced:
+                                break
+                            attempt = LoRAExecutionIdentity(
+                                self.owner[0],
+                                *record.identity.instance_key,
+                                "native-prepare",
+                                uuid4().hex,
+                                uuid4().hex,
+                                kind="warmup",
+                                dp_rank=dp_rank,
+                            )
+                            record.warmup = attempt
+                            try:
+                                await warmup(attempt, record.ref)
+                                execution = self.outcome(attempt)
+                                if (
+                                    execution is None
+                                    or execution.delivery != "DELIVERED"
+                                ):
+                                    raise RuntimeError("WARMUP_EXECUTION_UNCONFIRMED")
+                            finally:
+                                await self.close_session(
+                                    LoRASessionIdentity(*attempt.session_key)
+                                )
+                    if not record.fenced:
+                        reply = await self._command(record, "ready")
+                        if not record.fenced:
+                            if reply.state != "READY":
+                                raise RuntimeError("ADAPTER_NOT_READY")
+                            record.state, record.error = "READY", None
+                            record.observation = reply.observation
+                            return record.state
+            except Exception as exc:
+                record.error = str(exc)
+                record.fenced = True
+            try:
+                return await self._retire(record)
+            except Exception as exc:
+                record.state, record.error = "CLEANUP_PENDING", str(exc)
+                raise
+
+        record.work_task = asyncio.create_task(work())
+        record.work_task.add_done_callback(
+            lambda task: task.exception() if not task.cancelled() else None
+        )
+        return record.work_task
+
+    async def prepare_version(self, identity, digest, ref, warmup) -> str:
+        self.require_resident()
+        record = self._version(identity, digest, ref)
+        if record.fenced:
+            raise ValueError("VERSION_FENCED")
+        if record.state == "READY":
+            return record.state
+        state = await asyncio.shield(self._start_work(record, warmup))
+        if record.error:
+            raise RuntimeError(record.error)
+        if record.fenced:
+            raise ValueError("VERSION_FENCED")
+        return state
+
+    async def retire_version(self, identity, digest, ref) -> str:
+        record = self._version(identity, digest, ref)
+        record.fenced = True
+        if record.state == "ABSENT":
+            return record.state
+        if record.warmup is not None:
+            self.cancel(record.warmup)
+        # Independent fence may overtake a pending load. Cancellation of this
+        # waiter never releases that RPC's communicator ownership.
+        await self._command(record, "fence")
+        return await asyncio.shield(self._start_work(record))
+
+    def _session(self, identity: LoRASessionIdentity) -> TokenizerSession:
+        if (
+            probe_sequence(identity.session_id)
+            and probe_sequence(identity.session_id) <= self.probe_drained
+        ):
+            raise ValueError("SESSION_CLOSED")
+        if (identity.cohort_id, identity.engine_boot_id) != self.owner:
+            raise ValueError("ENGINE_EPOCH_MISMATCH")
+        # Native Session KV uses session_id alone. Do not allow another owner
+        # to acquire that same cache identity within this engine incarnation.
+        record = self.sessions.get(identity.session_id)
+        if record is not None:
+            if record.identity != identity:
+                raise ValueError("SESSION_ID_CONFLICT")
+            return record
+        if len(self.versions) + len(self.rids) + len(self.sessions) >= self.max_records:
+            self.accepting = False
+            raise ValueError("LIFECYCLE_CAPACITY_EXCEEDED")
+        record = TokenizerSession(identity)
+        self.sessions[identity.session_id] = record
+        return record
+
+    async def close_session(self, identity: LoRASessionIdentity) -> str:
+        if (identity.cohort_id, identity.engine_boot_id) != self.owner:
+            raise ValueError("ENGINE_EPOCH_MISMATCH")
+        sequence = probe_sequence(identity.session_id)
+        if sequence and sequence <= self.probe_drained:
+            return "SESSION_DRAINED"
+        record = self._session(identity)
+        record.closing = True  # Fence before await, including close-before-bind.
+        if record.closed:
+            return "SESSION_DRAINED"
+        if record.close_task is None or record.close_task.done():
+
+            async def close_owned():
+                await self.resident.wait()
+                # Install the correlated future BEFORE IPC send. No serialized
+                # mutation channel is held while another Session keeps running.
+                command = LoRASessionClose(identity, uuid4().hex)
+                record.command = command
+                record.replies.clear()
+                record.reply = asyncio.get_running_loop().create_future()
+                executions = tuple(record.attempts.values())
+                try:
+                    try:
+                        self.send(command)
+                    except Exception as exc:
+                        # Send outcome is ambiguous. Retain this waiter/control
+                        # key; a matching late ACK can still complete the close.
+                        record.error = str(exc)
+                    for execution in executions:
+                        self.cancel(execution.identity)
+                    reply = await record.reply
+                    if reply.error or reply.state != "SESSION_DRAINED":
+                        raise RuntimeError(reply.error or "SESSION_DRAIN_UNCONFIRMED")
+                    for execution in executions:
+                        # A Session fence + drain also proves that a submit
+                        # still in transit cannot execute. But an owned acquire
+                        # must settle before its increment can be released.
+                        if execution.acquire_task is not None:
+                            try:
+                                await asyncio.shield(execution.acquire_task)
+                            except Exception:
+                                pass
+                        self._release(execution)
+                        await execution.completion.wait()
+                        if not execution.drained:
+                            raise RuntimeError(
+                                execution.error or "REFERENCE_RELEASE_UNKNOWN"
+                            )
+                    record.closed = True
+                    record.error = None
+                    for execution in executions:
+                        self.requests.pop(execution.identity.rid, None)
+                        if sequence:
+                            self.rids.pop(execution.identity.rid, None)
+                    record.attempts.clear()
+                    record.command = record.reply = None
+                    record.replies.clear()
+                    if sequence:
+                        # Internal probes are serial and never externally replayed.
+                        # One watermark rejects late submits/closes without keeping
+                        # a Session, task or GPU event for every health check.
+                        self.probe_drained = sequence
+                        if (
+                            self.probe_identity is not None
+                            and self.probe_identity.session_key == identity.session_key
+                        ):
+                            self.rids.pop(self.probe_identity.rid, None)
+                        self.sessions.pop(identity.session_id)
+                    return "SESSION_DRAINED"
+                except Exception as exc:
+                    record.error = str(exc)
+                    raise
+
+            record.close_task = asyncio.create_task(close_owned())
+
+            def closed(task):
+                if not task.cancelled():
+                    task.exception()
+                if record.close_task is task:
+                    record.close_task = None
+
+            record.close_task.add_done_callback(closed)
+        return await asyncio.shield(record.close_task)
+
+    def observe_session(self, reply: LoRASessionReply) -> bool:
+        record = self.sessions.get(reply.identity.session_id)
+        if (
+            record is None
+            or record.identity != reply.identity
+            or record.command is None
+            or record.command.control_key != reply.control_key
+            or record.reply.done()
+            or not self.valid_worker(reply)
+            or reply.sender_rank in record.replies
+        ):
+            return False
+        record.replies[reply.sender_rank] = reply
+        if len(record.replies) == len(self.worker_boots or ("",)):
+            failed = next(
+                (
+                    item
+                    for item in record.replies.values()
+                    if item.error or item.state != "SESSION_DRAINED"
+                ),
+                None,
+            )
+            record.reply.set_result(failed or reply)
+        return True
+
+    def check_new_rid(self, rid: str) -> None:
+        # Native output messages route by RID. Keep it unique for the cohort,
+        # even across Sessions, so delayed output cannot reach a new consumer.
+        if rid in self.rids:
+            raise ValueError("ATTEMPT_ALREADY_EXISTS")
+
+    def _record(self, identity: LoRAExecutionIdentity) -> Optional[Any]:
+        if (identity.cohort_id, identity.engine_boot_id) != self.owner:
+            raise ValueError("ENGINE_EPOCH_MISMATCH")
+        record = self.requests.get(identity.rid)
+        if record is not None and record.identity is None:
+            return None
+        if record is not None and record.identity != identity:
+            raise ValueError("ATTEMPT_ID_CONFLICT")
+        return record
+
+    async def acquire(
+        self, identity: LoRAExecutionIdentity, ref: Any, state: Any
+    ) -> None:
+        self.require_resident()
+        self.execution_workers(identity)
+        previous = self._record(identity)
+        session = self._session(LoRASessionIdentity(*identity.session_key))
+        if session.closing:
+            raise ValueError("SESSION_CLOSED")
+        if session.instance_key not in (None, identity.instance_key):
+            raise ValueError("SESSION_ADAPTER_CONFLICT")
+        if previous is not None:
+            # Duplicate transport is queried/cancelled, never re-executed.
+            raise ValueError("ATTEMPT_ALREADY_EXISTS")
+        if (
+            not self.accepting
+            or len(self.rids) + len(self.versions) + len(self.sessions)
+            >= self.max_records
+        ):
+            raise ValueError("LIFECYCLE_CAPACITY_EXCEEDED")
+        probe = identity.kind == "probe"
+        if probe:
+            if (
+                identity != self.probe_identity
+                or not is_base_probe(identity)
+                or ref is not None
+            ):
+                raise ValueError("INVALID_INTERNAL_PROBE")
+        else:
+            if ref.lora_id != identity.native_lora_id:
+                raise ValueError("ADAPTER_IDENTITY_MISMATCH")
+            version = self.versions.get(identity.native_lora_id)
+            if (
+                version is None
+                or version.identity.instance_key != identity.instance_key
+                or version.ref != ref
+            ):
+                raise ValueError("ADAPTER_NOT_READY")
+            if version.fenced or not version.registered:
+                raise ValueError(
+                    "VERSION_FENCED" if version.fenced else "ADAPTER_NOT_READY"
+                )
+            if identity.kind == "warmup":
+                if version.warmup != identity:
+                    raise ValueError("INVALID_INTERNAL_WARMUP")
+            elif identity.kind != "business" or version.state != "READY":
+                raise ValueError("ADAPTER_NOT_READY")
+        self.check_new_rid(identity.rid)
+        session.instance_key = identity.instance_key
+        record = state
+        if (
+            self.requests.get(identity.rid) is not None
+            and self.requests[identity.rid] is not state
+        ):
+            raise ValueError("REQUEST_OWNER_CONFLICT")
+        record.identity = identity
+        self.requests[identity.rid] = state
+        session.attempts[identity.attempt_key] = state
+        self.rids[identity.rid] = AttemptResult(identity)
+
+        async def acquire_owned():
+            try:
+                if not probe:
+                    await self.registry.acquire_exact(ref)
+                    record.acquired = True
+                record.acquire_complete = True
+                if record.abort_requested:
+                    self._release(record)
+            except Exception as exc:
+                record.error = str(exc)
+                self._release(record)
+                raise
+
+        record.acquire_task = asyncio.create_task(acquire_owned())
+        # A detached acquire may fail after its HTTP waiter has disappeared.
+        # Observe its exception without discarding the queryable record.
+        record.acquire_task.add_done_callback(
+            lambda task: task.exception() if not task.cancelled() else None
+        )
+        # Own the acquire even if its caller disappears during the registry
+        # await. Never lose an increment whose coroutine no longer has a waiter.
+        try:
+            await asyncio.shield(record.acquire_task)
+        except BaseException:
+            self.cancel(identity)
+            raise
+        if record.abort_requested:
+            raise ValueError("ATTEMPT_CANCELLED")
+
+    def begin_submit(self, identity: LoRAExecutionIdentity) -> None:
+        self.require_resident()
+        record = self._record(identity)
+        if (
+            record is None
+            or not record.acquire_complete
+            or record.abort_requested
+            or record.drained
+        ):
+            raise ValueError("ATTEMPT_NOT_ADMITTED")
+        session = self.sessions.get(identity.session_id)
+        if session is None or session.closing:
+            raise ValueError("SESSION_CLOSED")
+        if identity.kind != "probe":
+            version = self.versions.get(identity.native_lora_id)
+            if version is None or version.fenced:
+                raise ValueError("VERSION_FENCED")
+        if record.dispatched:
+            raise ValueError("ATTEMPT_ALREADY_SUBMITTED")
+        # Runs before IPC send, with no await between fence check and transition.
+        record.dispatched = True
+
+    def _release(self, record: Any) -> None:
+        if record.release_task is not None or record.drained:
+            return
+
+        async def release_owned():
+            try:
+                if record.acquired:
+                    await self.registry.release(record.identity.native_lora_id)
+                    record.acquired = False
+                record.drained = True
+                result = self.rids[record.identity.rid]
+                result.terminal, result.used_gpu = True, record.used_gpu
+                result.error = record.error
+                self._forget_finished(record)
+            except Exception as exc:
+                # Unknown release cannot be retried by decrementing again.
+                record.error = str(exc)
+            finally:
+                record.completion.set()
+
+        record.release_task = asyncio.create_task(release_owned())
+
+    def cancel(self, identity: LoRAExecutionIdentity) -> None:
+        record = self._record(identity)
+        if record is None:
+            previous = self.outcome(identity)
+            if previous is not None and previous.terminal:
+                return
+            session = self._session(LoRASessionIdentity(*identity.session_key))
+            if session.closed:
+                return
+            self.check_new_rid(identity.rid)
+            if (
+                len(self.rids) + len(self.versions) + len(self.sessions)
+                >= self.max_records
+            ):
+                self.accepting = False
+                raise ValueError("LIFECYCLE_CAPACITY_EXCEEDED")
+            self.rids[identity.rid] = AttemptResult(
+                identity, terminal=True, delivery="ABANDONED"
+            )
+            return
+        record.abort_requested = True
+        if not record.dispatched:
+            # A pending owned acquire will release itself on completion.
+            if record.acquire_task is None or record.acquire_task.done():
+                self._release(record)
+            return
+        # Send may fail after reaching scheduler: preserve SUBMITTING/ref.
+        try:
+            self.send(LoRAExecutionControl(identity, "cancel"))
+        except Exception as exc:
+            record.error = str(exc)
+
+    def _forget_finished(self, record) -> None:
+        if record.drained and record.delivery != "WAITING":
+            self.requests.pop(record.identity.rid, None)
+            session = self.sessions.get(record.identity.session_id)
+            if session is not None:
+                session.attempts.pop(record.identity.attempt_key, None)
+
+    def outcome(self, identity):
+        result = self.rids.get(identity.rid)
+        if result is not None and result.identity != identity:
+            raise ValueError("ATTEMPT_ID_CONFLICT")
+        return result
+
+    def abandon(self, identity: LoRAExecutionIdentity) -> None:
+        record = self._record(identity)
+        if record is not None:
+            record.delivery = "ABANDONED"
+            record.consumer_detached = True
+            # Release accumulated output payloads; the native owner needs only
+            # its identity and completion state once its consumer has left.
+            for value in vars(record).values():
+                if isinstance(value, (list, dict)):
+                    value.clear()
+            record.input_top_logprobs_scheduler_flat = None
+            record.input_top_logprobs_flat_fields = None
+            record.text = ""
+            self.rids[identity.rid].delivery = "ABANDONED"
+            self._forget_finished(record)
+        self.cancel(identity)
+
+    def delivered(self, identity: LoRAExecutionIdentity) -> None:
+        record = self._record(identity)
+        if record is not None and record.delivery == "WAITING":
+            record.delivery = "DELIVERED"
+            self.rids[identity.rid].delivery = "DELIVERED"
+            self._forget_finished(record)
+
+    def observe(self, message: LoRAExecutionReply) -> bool:
+        # RID is unique for this engine incarnation. Only the native output
+        # leader reports logical completion; this is not a physical GPU fence.
+        record = self.requests.get(message.rid)
+        if (
+            record is None
+            or record.identity is None
+            or not record.dispatched
+            or message.engine_boot_id != self.owner[1]
+            or not self.valid_worker(message)
+            or message.sender_rank != min(self.execution_workers(record.identity))
+        ):
+            return False
+        if message.error:
+            record.error = message.error
+        if message.state == "REQUEST_FINISHED":
+            record.used_gpu |= message.used_gpu
+            self._release(record)
+        return True
+
+
+def probe_sequence(session_id: str) -> int:
+    """Reserved internal namespace; public bindings cannot choose these IDs."""
+    if not session_id.startswith("relax-health:"):
+        return 0
+    sequence = int(session_id.removeprefix("relax-health:"))
+    if sequence < 1:
+        raise ValueError("INVALID_INTERNAL_PROBE")
+    return sequence
+
+
+def is_base_probe(identity: LoRAExecutionIdentity) -> bool:
+    return (
+        identity.kind == "probe"
+        and identity.native_lora_id is None
+        and identity.owner_epoch == "native-health"
+    )
+
+
+def request_leader(scheduler: Any) -> bool:
+    ps = scheduler.ps
+    return ps.pp_rank == 0 and ps.attn_tp_rank == 0 and ps.attn_cp_rank == 0
+
+
+def native_requests(scheduler: Any) -> tuple:
+    """Actual scheduler owners, including overlap and PP batch copies.
+
+    Do not use finished() as a drain condition: a terminal Req may still be in
+    an already-launched microbatch. Deduplication only avoids repeated scans.
+    """
+    batches = [
+        scheduler.running_batch,
+        scheduler.last_batch,
+        getattr(scheduler, "cur_batch_for_debug", None),
+    ]
+    for name in ("mbs", "running_mbs", "last_mbs"):
+        batches.extend(getattr(scheduler, name, ()))
+    batches.extend(batch for batch, _ in getattr(scheduler, "result_queue", ()))
+    requests = {
+        id(req): req for batch in batches if batch is not None for req in batch.reqs
+    }
+    requests.update((id(req), req) for req in scheduler.waiting_queue)
+    grammar = getattr(scheduler, "grammar_manager", None)
+    requests.update((id(req), req) for req in getattr(grammar, "grammar_queue", ()))
+    for name in ("chunked_req", "_pending_chunked_abort_req"):
+        req = getattr(scheduler, name, None)
+        if req is not None:
+            requests[id(req)] = req
+    return tuple(requests.values())
+
+
+def request_reply(
+    scheduler: Any,
+    rid: str,
+    state: str,
+    *,
+    error=None,
+    used_gpu=False,
+    http_worker_ipc=None,
+) -> LoRAExecutionReply:
+    return LoRAExecutionReply(
+        rid, scheduler.lora_execution_owner[1], state, http_worker_ipc, error, used_gpu
+    )
+
+
+def accept_execution(scheduler: Any, message: Any) -> None:
+    """Validate trusted tokenizer metadata; never create a shadow request."""
+    if (
+        message.lora_engine_boot_id
+        != getattr(scheduler, "lora_execution_owner", (None, None))[1]
+    ):
+        raise ValueError("ENGINE_EPOCH_MISMATCH")
+    if getattr(scheduler, "lora_memory_state", "RESIDENT") != "RESIDENT":
+        raise ValueError("ENGINE_SUSPENDED")
+    if not scheduler.lora_execution_accepting:
+        raise ValueError("EXECUTION_ADMISSION_CLOSED")
+    session = scheduler.lora_sessions.get(message.lora_session_id)
+    if session is not None and session.closing:
+        raise ValueError("SESSION_CLOSED")
+    if message.lora_request_kind == "probe":
+        if message.lora_id is not None or not probe_sequence(message.lora_session_id):
+            raise ValueError("INVALID_INTERNAL_PROBE")
+        if probe_sequence(message.lora_session_id) <= getattr(
+            scheduler, "lora_probe_drained", 0
+        ):
+            raise ValueError("SESSION_CLOSED")
+        return
+    version = scheduler.lora_versions.get(message.lora_id)
+    if version is None or version.fenced:
+        raise ValueError("ADAPTER_NOT_READY")
+    if message.lora_request_kind == "warmup":
+        if version.state != "LOADED":
+            raise ValueError("ADAPTER_NOT_READY")
+    elif message.lora_request_kind != "business" or version.state != "READY":
+        raise ValueError("ADAPTER_NOT_READY")
+
+
+def control_execution(scheduler: Any, message: LoRAExecutionControl) -> None:
+    identity = message.identity
+    if (identity.cohort_id, identity.engine_boot_id) != getattr(
+        scheduler, "lora_execution_owner", None
+    ):
+        raise ValueError("ENGINE_EPOCH_MISMATCH")
+    if identity.dp_rank != scheduler.ps.attn_dp_rank:
+        return
+    if message.action not in ("status", "cancel"):
+        raise ValueError("INVALID_EXECUTION_ACTION")
+    requests = {req.rid: req for req in native_requests(scheduler)}
+    req = requests.get(identity.rid)
+    if req is not None and message.action == "cancel":
+        from sglang.srt.managers.io_struct import AbortReq
+
+        scheduler.abort_request(AbortReq(rid=req.rid), exact=True)
+    # Submit and cancel share the native input stream. The tokenizer prevents
+    # dispatch after its fence, so cancel cannot be followed by a new submit.
+    # Unknown status is NOT evidence of non-submission.
+    state = (
+        "REQUEST_FINISHED" if req is None and message.action == "cancel" else "UNKNOWN"
+    )
+    send_managed_reply(
+        scheduler,
+        request_reply(
+            scheduler, identity.rid, state, http_worker_ipc=message.http_worker_ipc
+        ),
+    )
+
+
+def begin_execution_batch(scheduler: Any, batch: Any) -> tuple:
+    """Track GPU uses per immutable instance, not per request/rank."""
+    if not hasattr(scheduler, "lora_execution_owner"):
+        return ()
+    versions = {}
+    for req in batch.reqs:
+        if not getattr(req, "lora_request_kind", None):
+            raise RuntimeError("UNMANAGED_REQUEST_IN_MANAGED_BATCH")
+        req.lora_used_gpu = True
+        if req.lora_id is None:  # Private base health probe.
+            continue
+        version = scheduler.lora_versions.get(req.lora_id)
+        key = (scheduler.lora_execution_owner[1], req.lora_id)
+        if version is None:
+            raise RuntimeError("MANAGED_INSTANCE_LOST")
+        # A lost admitted instance is an engine failure. Do not repair a batch
+        # independently on one rank and diverge its native collectives.
+        if key not in versions:
+            scheduler.tp_worker.model_runner.lora_manager._validate_managed_batch_ids(
+                {req.lora_id}
+            )
+            versions[key] = version
+        if req.lora_request_kind == "warmup":
+            version.warmed = True
+    for version in versions.values():
+        version.launching = True
+    return tuple(versions.values())
+
+
+def execution_stream(scheduler: Any) -> Any:
+    if getattr(scheduler, "enable_overlap", True) or scheduler.ps.pp_size > 1:
+        return scheduler.forward_stream
+    return scheduler.device_module.current_stream()
+
+
+def finish_execution_batch(scheduler: Any, versions: tuple, event: Any = None) -> None:
+    if not versions:
+        return
+    if event is None:
+        event = scheduler.device_module.Event()
+        stream = execution_stream(scheduler)
+        event.record(stream=stream)
+    # This is after forward/graph replay; later uses on the same stream cover
+    # earlier ones. H2D and slot clearing retain their own completion events.
+    for version in versions:
+        version.last_use_event = event
+        version.launching = False
+
+
+def finish_native_request(scheduler: Any, req: Any) -> None:
+    """Called by native final output or queued abort, never by queue polling."""
+    if not getattr(req, "lora_request_kind", None) or getattr(
+        req, "lora_terminal_notified", False
+    ):
+        return
+    req.lora_terminal_notified = True
+    send_managed_reply(
+        scheduler,
+        request_reply(
+            scheduler,
+            req.rid,
+            "REQUEST_FINISHED",
+            used_gpu=getattr(req, "lora_used_gpu", False),
+            http_worker_ipc=getattr(req, "http_worker_ipc", None),
+        ),
+    )
+
+
+def version_reply(
+    command: LoRAVersionCommand,
+    state: str,
+    error: Optional[str] = None,
+    count: int = 0,
+    observation: Optional[dict] = None,
+) -> LoRAVersionReply:
+    return LoRAVersionReply(
+        command.identity,
+        command.control_id,
+        command.action,
+        state,
+        error=error,
+        actual_unload_count=count,
+        observation=observation,
+        http_worker_ipc=command.http_worker_ipc,
+    )
+
+
+def version_observation(scheduler: Any, record: NativeVersion) -> dict:
+    """Low-frequency actual scheduler ownership; no tensor copies/synchronization."""
+    manager = scheduler.tp_worker.model_runner.lora_manager
+    pool = getattr(manager, "memory_pool", None)
+    if pool is None:
+        return {}  # Test doubles do not produce hardware resource evidence.
+    uid = record.identity.native_lora_id
+    ref = manager.lora_refs.get(uid)
+    slot = pool.uid_to_buffer_id.get(uid)
+    return {
+        "native_lora_id": uid,
+        "state": record.state,
+        "slot": slot,
+        "resident": slot is not None and pool.buffer_id_to_uid[slot] == uid,
+        "clearing": uid in pool.clearing_loras,
+        "pinned": bool(ref and ref.pinned),
+        "cpu_adapter": uid in manager.loras,
+        "config": uid in manager.configs,
+        "native_executions": sum(
+            req.lora_id == uid for req in native_requests(scheduler)
+        ),
+        "actual_unload_count": record.actual_unload_count,
+    }
+
+
+def control_memory(scheduler: Any, command: LoRAMemoryCommand) -> LoRAMemoryReply:
+    """Low-frequency rank consensus; no voting is added to normal decode.
+
+    The last sequence fences old IPC without an unbounded command history.
+    Every rank joins preflight and each memory phase, including local errors.
+    A lost process still follows the engine's ordinary collective-failure path.
+    """
+    updater = scheduler.weight_updater
+    previous = getattr(scheduler, "lora_memory_reply", None)
+    error = None
+    changed = set()
+    try:
+        if (
+            command.cohort_id,
+            command.engine_boot_id,
+        ) != scheduler.lora_execution_owner:
+            raise ValueError("ENGINE_EPOCH_MISMATCH")
+        last = previous.sequence if previous is not None else 0
+        if type(command.sequence) is not int or command.sequence < 1:
+            raise ValueError("INVALID_MEMORY_SEQUENCE")
+        if command.sequence < last:
+            raise ValueError("STALE_MEMORY_OPERATION")
+        if command.sequence == last:
+            if command.control_key != previous.control_key:
+                raise ValueError("MEMORY_SEQUENCE_CONFLICT")
+        elif command.sequence != last + 1:
+            raise ValueError("MEMORY_SEQUENCE_GAP")
+        elif getattr(scheduler, "lora_memory_state", "RESIDENT") == "UNKNOWN":
+            raise ValueError("MEMORY_STATE_UNKNOWN")
+        if (
+            command.action not in ("suspend", "resume")
+            or not command.tags
+            or not set(command.tags) <= {"weights", "kv_cache", "cuda_graph"}
+        ):
+            raise ValueError("INVALID_MEMORY_OPERATION")
+        if (
+            not scheduler.server_args.enable_memory_saver
+            or not scheduler.server_args.enable_weights_cpu_backup
+        ):
+            raise ValueError("MEMORY_BACKUP_REQUIRED")
+        remaining = set(updater.offload_tags)
+        changed = (
+            set(command.tags) - remaining
+            if command.action == "suspend"
+            else set(command.tags) & remaining
+        )
+        if (
+            command.sequence != last
+            and changed
+            and (
+                scheduler.lora_loads
+                or scheduler.lora_retirements
+                or scheduler.lora_session_closures
+                or not scheduler.is_fully_idle()
+                or any(
+                    record.load_unknown
+                    or record.launching
+                    or record.last_use_event is not None
+                    and not record.last_use_event.query()
+                    for record in scheduler.lora_versions.values()
+                )
+            )
+        ):
+            raise ValueError("MEMORY_DRAIN_UNCONFIRMED")
+    except Exception as exc:
+        error = str(exc)
+    state = (
+        command.control_key,
+        tuple(sorted(updater.offload_tags)),
+        previous.control_key if previous else None,
+    )
+    votes = scheduler._lora_memory_consensus((state, error))
+    errors = [item[1] for item in votes if item[1]]
+    if any(item[0] != state for item in votes):
+        errors.append("MEMORY_WORKER_STATE_MISMATCH")
+    if not errors and previous is not None and command.sequence == previous.sequence:
+        return previous
+    if not errors:
+        order = (
+            ("kv_cache", "weights", "cuda_graph")
+            if command.action == "suspend"
+            else ("cuda_graph", "weights", "kv_cache")
+        )
+        scheduler.lora_memory_state = "TRANSITIONING"
+        scheduler._lora_memory_transition = True
+        try:
+            for tag in order:
+                if tag not in changed:
+                    continue
+                error = None
+                try:
+                    scheduler._apply_lora_memory(command.action, [tag])
+                except Exception as exc:
+                    error = str(exc)
+                errors = [
+                    item for item in scheduler._lora_memory_consensus(error) if item
+                ]
+                if errors:
+                    scheduler.lora_memory_state = "UNKNOWN"
+                    break
+            else:
+                scheduler.lora_memory_state = (
+                    "SUSPENDED" if updater.offload_tags else "RESIDENT"
+                )
+        finally:
+            scheduler._lora_memory_transition = False
+    reply = LoRAMemoryReply(
+        command.cohort_id,
+        command.engine_boot_id,
+        command.control_id,
+        command.action,
+        command.tags,
+        tuple(sorted(updater.offload_tags)),
+        "; ".join(errors) or None,
+        sequence=command.sequence,
+    )
+    # Foreign/stale commands cannot overwrite the fence for a newer operation.
+    if (
+        not errors
+        or (command.cohort_id, command.engine_boot_id) == scheduler.lora_execution_owner
+        and (
+            type(command.sequence) is int
+            and command.sequence == (previous.sequence if previous else 0) + 1
+        )
+    ):
+        scheduler.lora_memory_reply = reply
+    return reply
+
+
+def control_version(
+    scheduler: Any, command: LoRAVersionCommand
+) -> Optional[LoRAVersionReply]:
+    """Scheduler side of load/fence/cleanup, on the existing IPC channel."""
+    identity = command.identity
+    if (
+        identity.engine_boot_id
+        != getattr(scheduler, "lora_execution_owner", (None, None))[1]
+    ):
+        return version_reply(command, "UNKNOWN", "ENGINE_EPOCH_MISMATCH")
+    if command.action not in ("load", "fence", "cleanup", "status", "ready"):
+        return version_reply(command, "UNKNOWN", "INVALID_VERSION_ACTION")
+    if getattr(scheduler, "lora_memory_state", "RESIDENT") != "RESIDENT":
+        return version_reply(command, "UNKNOWN", "ENGINE_SUSPENDED")
+    ref = command.ref
+    if ref.lora_id != identity.native_lora_id or not ref.pinned or not command.digest:
+        return version_reply(command, "UNKNOWN", "ADAPTER_IDENTITY_MISMATCH")
+    versions = scheduler.lora_versions
+    record = versions.get(identity.native_lora_id)
+    if record is not None and (record.identity, record.digest, record.ref) != (
+        identity,
+        command.digest,
+        ref,
+    ):
+        return version_reply(command, "UNKNOWN", "INSTANCE_CONTENT_CONFLICT")
+    if record is None:
+        if command.action in ("status", "ready"):
+            return version_reply(command, "UNKNOWN")
+        if command.action == "cleanup":
+            return version_reply(command, "UNKNOWN", "VERSION_FENCE_REQUIRED")
+        if (
+            len(versions) + len(scheduler.lora_sessions)
+            >= scheduler.lora_execution_limit
+        ):
+            if command.action == "fence":
+                scheduler.lora_execution_accepting = False
+            return version_reply(command, "UNKNOWN", "LIFECYCLE_CAPACITY_EXCEEDED")
+        record = NativeVersion(identity, ref, command.digest)
+        versions[identity.native_lora_id] = record
+    if command.action == "status":
+        return version_reply(
+            command,
+            record.state,
+            record.error,
+            record.actual_unload_count,
+            version_observation(scheduler, record),
+        )
+    if command.action == "ready":
+        if record.fenced:
+            return version_reply(command, record.state, "VERSION_FENCED")
+        if (
+            not record.warmed
+            or record.launching
+            or record.last_use_event is None
+            or not record.last_use_event.query()
+        ):
+            return version_reply(command, record.state, "WARMUP_DRAIN_UNCONFIRMED")
+        try:
+            scheduler.tp_worker.model_runner.lora_manager.validate_managed_residency(
+                ref
+            )
+        except Exception as exc:
+            return version_reply(
+                command, record.state, "ADAPTER_NOT_READY: " + str(exc)
+            )
+        record.state, record.error = "READY", None
+        return version_reply(
+            command, "READY", observation=version_observation(scheduler, record)
+        )
+    if command.action == "fence":
+        record.fenced = True
+        if record.state not in ("ABSENT", "CLEARING"):
+            record.state = "FENCED"
+        return version_reply(command, record.state, count=record.actual_unload_count)
+    if command.action == "load":
+        if record.fenced:
+            return version_reply(
+                command, record.state, "VERSION_FENCED", record.actual_unload_count
+            )
+        if record.load_received:
+            if record.load_command is not None:
+                if record.load_command.control_key == command.control_key:
+                    return None
+                return version_reply(command, record.state, "LOAD_ALREADY_PENDING")
+            return version_reply(
+                command, record.state, record.error, record.actual_unload_count
+            )
+        record.load_received = True
+        occupied = scheduler.lora_version_names.get(ref.lora_name)
+        if occupied is not None and occupied != identity.instance_key:
+            record.state, record.error = "LOAD_FAILED", "LORA_NAME_IN_USE"
+            return version_reply(command, record.state, record.error)
+        if not scheduler.lora_execution_accepting:
+            record.state, record.error = "LOAD_FAILED", "EXECUTION_ADMISSION_CLOSED"
+            return version_reply(command, record.state, record.error)
+        record.state = "LOADING"
+        record.load_started = True
+        scheduler.lora_version_names[ref.lora_name] = identity.instance_key
+        manager = scheduler.tp_worker.model_runner.lora_manager
+        try:
+            result = manager.load_lora_adapter(ref)
+            if not result.success:
+                record.state, record.error = "LOAD_FAILED", result.error_message
+                return version_reply(command, record.state, record.error)
+            # All-worker residency completion precedes warmup/admission. Keep
+            # our own event even when the native overlap loader drains its map.
+            stream = (
+                scheduler.lora_overlap_loader.load_stream
+                if getattr(scheduler, "enable_lora_overlap_loading", False)
+                else scheduler.forward_stream
+            )
+            record.load_unknown = True
+            record.load_event, record.error = manager.stage_managed_residency(
+                ref, stream
+            )
+            record.load_unknown = False
+            record.load_command = command
+            record.state = "RESIDENCY_PENDING"
+            scheduler.lora_loads[identity.instance_key] = record
+            return None
+        except Exception as exc:
+            record.state = "UNKNOWN" if record.load_unknown else "LOAD_FAILED"
+            record.error = str(exc)
+        return version_reply(command, record.state, record.error)
+    if not record.fenced:
+        return version_reply(command, record.state, "VERSION_FENCE_REQUIRED")
+    if record.state == "ABSENT":
+        return version_reply(command, "ABSENT", count=record.actual_unload_count)
+    if record.cleanup_command is not None:
+        if record.cleanup_command.control_key != command.control_key:
+            return version_reply(command, record.state, "CLEANUP_ALREADY_PENDING")
+        return None
+    record.cleanup_command = command
+    record.state = "RETIRING"
+    scheduler.lora_retirements[identity.instance_key] = record
+    # Reply only after the ordinary event loop has proved drain AND completed
+    # the physical clear. The mutation waiter stays owned while B runs.
+    return None
+
+
+def poll_version_loads(scheduler: Any) -> bool:
+    """Confirm only this instance's copy completion, without blocking decode."""
+    pending = getattr(scheduler, "lora_loads", {})
+    manager = None
+    for key, record in tuple(pending.items()):
+        command = record.load_command
+        try:
+            if not record.load_event.query():
+                continue
+        except Exception as exc:
+            record.load_unknown = True
+            record.state, record.error = "UNKNOWN", str(exc)
+        else:
+            manager = scheduler.tp_worker.model_runner.lora_manager
+            if (
+                manager.pending_lora_load_events.get(record.ref.lora_id)
+                is record.load_event
+            ):
+                del manager.pending_lora_load_events[record.ref.lora_id]
+            if not record.error:
+                try:
+                    manager.validate_managed_residency(record.ref)
+                except Exception as exc:
+                    record.error = "ADAPTER_NOT_READY: " + str(exc)
+            if record.fenced:
+                record.state, record.error = "FENCED", "VERSION_FENCED"
+            else:
+                record.state = "LOAD_FAILED" if record.error else "LOADED"
+        record.load_command = None
+        record.load_event = None
+        del pending[key]
+        send_managed_reply(
+            scheduler, version_reply(command, record.state, record.error)
+        )
+    return bool(pending)
+
+
+def poll_version_retirements(scheduler: Any, requests=None) -> bool:
+    pending = getattr(scheduler, "lora_retirements", {})
+    if not pending:
+        return False
+    active = {
+        req.lora_id
+        for req in (native_requests(scheduler) if requests is None else requests)
+    }
+    for key, record in tuple(pending.items()):
+        if (
+            record.ref.lora_id in active
+            or record.load_command is not None
+            or record.launching
+            or record.last_use_event is not None
+            and not record.last_use_event.query()
+        ):
+            continue
+        command = record.cleanup_command
+        try:
+            if record.load_unknown:
+                raise RuntimeError("RESIDENCY_COPY_UNKNOWN")
+            if record.load_started:
+                # Full immutable ref: never resolve the public name again.
+                result = scheduler.tp_worker.model_runner.lora_manager.poll_unload_drained_lora(
+                    record.ref
+                )
+                if result is None:
+                    record.state = "CLEARING"
+                    continue
+                if not result.success:
+                    raise RuntimeError(result.error_message)
+                record.actual_unload_count += 1
+            record.state = "ABSENT"
+            record.error = None
+            if scheduler.lora_version_names.get(record.ref.lora_name) == key:
+                del scheduler.lora_version_names[record.ref.lora_name]
+            reply = version_reply(
+                command,
+                "ABSENT",
+                count=record.actual_unload_count,
+                observation=version_observation(scheduler, record),
+            )
+        except Exception as exc:
+            record.state, record.error = "CLEANUP_PENDING", str(exc)
+            reply = version_reply(
+                command, record.state, record.error, record.actual_unload_count
+            )
+        record.cleanup_command = None
+        del pending[key]
+        # Keep the terminal state even if sending its ACK fails. Retrying a
+        # completed operation must never run physical cleanup a second time.
+        send_managed_reply(scheduler, reply)
+    return bool(pending)
+
+
+def scheduler_session(scheduler: Any, identity: LoRASessionIdentity) -> NativeSession:
+    if (identity.cohort_id, identity.engine_boot_id) != getattr(
+        scheduler, "lora_execution_owner", None
+    ):
+        raise ValueError("ENGINE_EPOCH_MISMATCH")
+    record = scheduler.lora_sessions.get(identity.session_id)
+    if record is not None:
+        if record.identity != identity:
+            raise ValueError("SESSION_ID_CONFLICT")
+        return record
+    if (
+        len(scheduler.lora_versions) + len(scheduler.lora_sessions)
+        >= scheduler.lora_execution_limit
+    ):
+        scheduler.lora_execution_accepting = False
+        raise ValueError("LIFECYCLE_CAPACITY_EXCEEDED")
+    record = NativeSession(identity)
+    scheduler.lora_sessions[identity.session_id] = record
+    return record
+
+
+def session_reply(
+    command: LoRASessionClose, state: str, error: Optional[str] = None
+) -> LoRASessionReply:
+    return LoRASessionReply(
+        command.identity, command.control_id, state, error, command.http_worker_ipc
+    )
+
+
+def control_session_close(
+    scheduler: Any, command: LoRASessionClose
+) -> Optional[LoRASessionReply]:
+    sequence = probe_sequence(command.identity.session_id)
+    if (command.identity.cohort_id, command.identity.engine_boot_id) != getattr(
+        scheduler, "lora_execution_owner", None
+    ):
+        return session_reply(command, "UNKNOWN", "ENGINE_EPOCH_MISMATCH")
+    if sequence and sequence <= getattr(scheduler, "lora_probe_drained", 0):
+        return session_reply(command, "SESSION_DRAINED")
+    try:
+        record = scheduler_session(scheduler, command.identity)
+    except ValueError as exc:
+        return session_reply(command, "UNKNOWN", str(exc))
+    record.closing = True
+    if record.closed:
+        return session_reply(command, "SESSION_DRAINED")
+    if record.error is not None:
+        # Native KV close may install its tombstone before releasing every
+        # component. Repeating it can return successfully with protection still
+        # held. Preserve UNKNOWN until process teardown; never infer completion
+        # from that idempotent no-op.
+        return session_reply(command, "CLEANUP_PENDING", record.error)
+    if record.command is not None and record.command.control_key != command.control_key:
+        return session_reply(
+            command, "CLEANUP_PENDING", "SESSION_CLOSE_ALREADY_PENDING"
+        )
+    record.command = command
+    scheduler.lora_session_closures[command.identity.session_key] = record
+    for req in native_requests(scheduler):
+        if getattr(req, "lora_session_id", None) == command.identity.session_id:
+            from sglang.srt.managers.io_struct import AbortReq
+
+            scheduler.abort_request(AbortReq(rid=req.rid), exact=True)
+    return None
+
+
+def poll_session_closures(scheduler: Any, requests=None) -> bool:
+    pending = getattr(scheduler, "lora_session_closures", {})
+    if not pending:
+        return False
+    active = {
+        getattr(req, "lora_session_id", None)
+        for req in (native_requests(scheduler) if requests is None else requests)
+    }
+    for key, record in tuple(pending.items()):
+        if record.identity.session_id in active:
+            continue
+        command = record.command
+        try:
+            # Snapshot once: another Session using the same adapter must not
+            # move our completion point forward indefinitely.
+            if record.completion_event is None:
+                record.completion_event = scheduler.device_module.Event()
+                stream = execution_stream(scheduler)
+                record.completion_event.record(stream=stream)
+            if not record.completion_event.query():
+                continue
+            # Native synchronous KV/session lifecycle runs only after physical
+            # request drain. Its return is now acknowledged, not merely sent.
+            if not probe_sequence(record.identity.session_id):
+                scheduler._close_lora_session(record.identity.session_id)
+            record.closed = True
+            record.error = None
+            record.completion_event = None
+            sequence = probe_sequence(record.identity.session_id)
+            if sequence:
+                scheduler.lora_probe_drained = sequence
+                del scheduler.lora_sessions[record.identity.session_id]
+            reply = session_reply(command, "SESSION_DRAINED")
+        except Exception as exc:
+            record.error = "SESSION_KV_CLOSE_UNKNOWN: " + str(exc)
+            reply = session_reply(command, "CLEANUP_PENDING", record.error)
+        record.command = None
+        del pending[key]
+        send_managed_reply(scheduler, reply)
+    return bool(pending)
+
+
+def poll_lora_controls(scheduler: Any) -> bool:
+    """Share a live-container view only when a retirement or close is pending."""
+    loads = poll_version_loads(scheduler)
+    if not (
+        getattr(scheduler, "lora_retirements", None)
+        or getattr(scheduler, "lora_session_closures", None)
+    ):
+        return loads
+    requests = native_requests(scheduler)
+    retiring = poll_version_retirements(scheduler, requests)
+    closing = poll_session_closures(scheduler, requests)
+    return loads or retiring or closing
