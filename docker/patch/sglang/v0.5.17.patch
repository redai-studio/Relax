+    device,
+    dtype,
+):
+    tensors = []
+    cache = {}
+    for raw_group_id in noise_group_ids:
+        group_id = str(raw_group_id)
+        noise = cache.get(group_id)
+        if noise is None:
+            generator = torch.Generator(device=torch.device("cpu"))
+            generator.manual_seed(_derive_group_seed(base_seed, group_id))
