+def gloo_worker(rank, rendezvous, result_path, case):
+    try:
+        dist.init_process_group(
+            "gloo",
+            init_method=f"file://{rendezvous}",
+            rank=rank,
+            world_size=2,
+            timeout=datetime.timedelta(seconds=15),
+        )
+
+        def reduce(tensor, op):
+            dist.all_reduce(tensor, op=op, group=dist.group.WORLD)
+
+        if case == "query_error":
+            query_error_round(reduce, rank)
+        elif case.startswith("weight_"):
+            failure = case.removeprefix("weight_") if rank == 1 else None
+            manager, backend, cc, events = weight_manager(reduce, failure)
+            if case == "weight_namespace":
+                original = backend.advance_weight_namespace
+
+                def advance():
+                    original()
+                    if rank == 1:
+                        backend.weight_namespace = "b" * 32 + "-1"
+
+                backend.advance_weight_namespace = advance
+            try:
+                manager.update_weights_from_tensor(
+                    NS(flush_cache=False, disable_draft_model=True)
+                )
+            except RuntimeError:
+                assert cc.storage_stop_event.is_set()
+            else:
+                raise AssertionError("A peer failure was returned as success")
+        else:
+            capacity = (
+                (4 if case == "full_partial" else 0)
+                if rank == 1 and case.startswith("full_")
+                else 32
+            )
+            cache, pool, auxiliary, submitted, released, locks = native_cache(
+                reduce, capacity, component_fails=rank == 1 and case == "component"
+            )
+            if case == "rate" and rank == 1:
+                cache.cache_controller.prefetch_rate_limited = lambda: True
+            if case == "duplicate" and rank == 1:
+                cache.aborted_prefetch.add("r")
+            cache.prefetch_from_storage("r", 1, list(range(8)))
+            if case in {"component", "rate", "duplicate"}:
+                assert not submitted and not cache.ongoing_prefetch and not locks
+                assert not released
+            else:
+                op = submitted[0]
+                if case == "cancelled" and rank == 1:
+                    op.mark_terminate()
+                if case == "identity" and rank == 1:
+                    op.native_sequence += 1
+                cache.cache_controller.prefetch_hit_queue.put(op)
+                cache._drain_storage_control_queues_impl(0, 1, 0, 0, {}, False)
+                assert cache.cache_controller.prefetch_buffer.empty()
+                assert not cache.ongoing_prefetch and not locks
+                assert auxiliary.freed == [9]
+                assert not released
+            # The failure must not poison the next collectively enqueued request.
+            cache.aborted_prefetch.clear()
+            cache.cache_controller.prefetch_rate_limited = lambda: False
+            cache.components["mamba"].prepare_prefetch = lambda *a, **k: NS(
+                alloc_failed=False, host_indices=torch.tensor([10])
+            )
+            pool.capacity = 32
+            cache.prefetch_from_storage("next", 1, list(range(8)))
+            op = submitted[-1]
+            cache.cache_controller.prefetch_hit_queue.put(op)
+            cache._drain_storage_control_queues_impl(0, 1, 0, 0, {}, False)
+            assert cache.cache_controller.prefetch_buffer.get_nowait() is op
+            assert len(op.host_indices) == 8
+        Path(result_path).write_text("PASS")
+    except BaseException:
+        Path(result_path).write_text(traceback.format_exc())
+        raise
+    finally:
+        if dist.is_initialized():
+            dist.destroy_process_group()
+
