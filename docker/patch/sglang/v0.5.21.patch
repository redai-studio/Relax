+        ),
+        lora_name=body.get("lora_name", "default"),
+        target=body.get("target", "transformer"),
+        strength=float(body.get("strength", 1.0)),
+        merge_mode=body.get("merge_mode"),
+    )
+
+    try:
+        response = await async_scheduler_client.forward(req)
