+    /// Account for a final short tail while its chunked Mamba checkpoint is pinned.
+    pub fn finish_deferred_chunked_backup(&mut self, node_id: NodeId) -> Vec<CacheAction> {
+        let Ok(node_id) = self.arena.resolve(node_id) else {
+            return Vec::new();
+        };
+        let node = self.arena.node(node_id);
+        if !self.enable_hicache
+            || node.is_root()
+            || node.backuped()
+            || node.write_through_pending_id.is_some()
+            || node.device_lock_ref(FULL) == 0
+            || !node.has_device_value(MAMBA)
+        {
+            return Vec::new();
+        }
+        if !self.inc_hit_count_and_check_(node_id, false) {
+            return Vec::new();
+        }
+        vec![CacheAction::BackupKV(
+            self.build_backup_kv_action_(self.arena.node(node_id), false),
+        )]
+    }
