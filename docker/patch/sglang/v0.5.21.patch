@@ -0,0 +1,162 @@
+"""CPU regression for sub-word TP boundaries in packed FP8 scale reloads."""
+
+import ast
+import os
+import sys
+from pathlib import Path
+from types import MethodType, ModuleType, SimpleNamespace
+
+import pytest
+import torch
+
+
+def _load(path, names, namespace, class_name=None):
+    body = ast.parse(path.read_text()).body
+    if class_name:
+        body = next(
+            node
+            for node in body
+            if isinstance(node, ast.ClassDef) and node.name == class_name
+        ).body
+    nodes = [
+        node
+        for node in body
+        if isinstance(node, (ast.ClassDef, ast.FunctionDef)) and node.name in names
+    ]
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__", names=[ast.alias(name="annotations")], level=0
+            ),
+            *nodes,
+        ],
+        type_ignores=[],
+    )
+    exec(compile(ast.fix_missing_locations(module), str(path), "exec"), namespace)
+
+
+@pytest.mark.parametrize("local_k,tp_size", [(384, 2), (384, 4), (512, 2)])
+@pytest.mark.parametrize(
+    "packed,presharded", [(True, False), (True, True), (False, False)]
+)
+@pytest.mark.parametrize("mn", [64, 128, 192])
+def test_row_scale_reload_preserves_each_rank_columns_and_storage(
+    monkeypatch, local_k, tp_size, packed, presharded, mn
+):
+    override = os.environ.get("SGLANG_TEST_SOURCE_ROOT")
+    root = (
+        Path(override)
+        if override
+        else Path(__file__).resolve().parents[4] / "python/sglang"
+    )
+    namespace = {"torch": torch, "Parameter": torch.nn.Parameter, "_is_cpu": False}
+    _load(
+        root / "srt/layers/parameter.py",
+        {
+            "BasevLLMParameter",
+            "_ColumnvLLMParameter",
+            "RowvLLMParameter",
+            "BlockQuantScaleParameter",
+        },
+        namespace,
+    )
+    fp8 = {}
+    fp8["torch"] = torch
+    _load(
+        root / "srt/layers/quantization/fp8_utils.py",
+        {
+            "transform_scale_ue8m0",
+            "inverse_transform_scale_ue8m0",
+            "_inverse_transform_scale_ue8m0_impl",
+            "_get_mn_major_tma_aligned_packed_ue8m0_tensor_torch_impl",
+        },
+        fp8,
+    )
+
+    def module(name, **attrs):
+        result = ModuleType(name)
+        result.__dict__.update(attrs)
+        monkeypatch.setitem(sys.modules, name, result)
+        return result
+
+    align = lambda size, alignment: (size + alignment - 1) // alignment * alignment
+    layout = module(
+        "deep_gemm.utils.layout",
+        get_mn_major_tma_aligned_packed_ue8m0_tensor=fp8[
+            "_get_mn_major_tma_aligned_packed_ue8m0_tensor_torch_impl"
+        ],
+    )
+    utils = module(
+        "deep_gemm.utils",
+        layout=layout,
+        align=align,
+        get_tma_aligned_size=lambda size, element_size: (
+            align(size * element_size, 16) // element_size
+        ),
+    )
+    module("deep_gemm", utils=utils)
+    module(
+        "sglang.srt.layers.quantization.fp8_utils",
+        **{name: value for name, value in fp8.items() if not name.startswith("__")},
+    )
+    # RowvLLMParameter imports this CUDA/CPU padding helper before branching;
+    # our tensors use the production GPU branch without requiring GPU kernels.
+    module(
+        "sglang.srt.model_loader.weight_utils",
+        narrow_padded_param_and_loaded_weight=None,
+    )
+    _load(
+        root / "srt/layers/linear.py",
+        {"weight_loader_v2", "_load_ue8m0_packed_scale"},
+        namespace,
+        "RowParallelLinear",
+    )
+    columns = local_k // 128
+    for rank in range(tp_size):
+        scale_rows = (mn + 127) // 128
+        shape = (mn, (columns + 3) // 4) if packed else (scale_rows, columns)
+        param = namespace["BlockQuantScaleParameter"](
+            data=torch.zeros(shape, dtype=torch.int32 if packed else torch.float32),
+            input_dim=1,
+            output_dim=0,
+            weight_loader=lambda *_: None,
+        )
+        param.format_ue8m0 = packed
+        pointer, stride = param.data_ptr(), param.stride()
+        layer = SimpleNamespace(
+            tp_rank=rank,
+            use_presharded_weights=presharded,
+            input_size_per_partition=local_k,
+            quant_method=SimpleNamespace(
+                quant_config=SimpleNamespace(weight_block_size=[128, 128])
+            ),
+        )
+        if "_load_ue8m0_packed_scale" in namespace:
+            layer._load_ue8m0_packed_scale = MethodType(
+                namespace["_load_ue8m0_packed_scale"], layer
+            )
+        for offset in (0, 1):
+            # Every scale column has a distinct exponent, including across a
+            # packed-word boundary and across successive weight updates.
+            scales = torch.pow(
+                2.0,
+                torch.arange(scale_rows * columns * tp_size, dtype=torch.float32)
+                - 7
+                + offset,
+            ).reshape(scale_rows, -1)
+            expected = scales[:, rank * columns : (rank + 1) * columns]
+            incoming = expected if presharded else scales
+            if packed:
+                incoming = fp8["transform_scale_ue8m0"](incoming, mn=mn)
+            namespace["weight_loader_v2"](layer, param, incoming)
+            assert param.data_ptr() == pointer and param.stride() == stride
+            if packed:
+                # Read one repeated scale row per 128 outputs directly; this
+                # oracle also supports a partial final output block.
+                words = param.data[::128].contiguous()
+                exponents = words.view(torch.uint8).to(torch.int32)
+                actual = (exponents << 23).view(torch.float32)
+            else:
+                actual = param.data
+            torch.testing.assert_close(actual[:, :columns], expected)
+            assert torch.count_nonzero(actual[:, columns:]) == 0
