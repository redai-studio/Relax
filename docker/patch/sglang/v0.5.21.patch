+
+# Load the production enum without importing incompatible local GPU dependencies.
+_base = (
+    Path(__file__).resolve().parents[4]
+    / "python/sglang/srt/disaggregation/base/conn.py"
+)
+_enum = next(
+    node
+    for node in ast.parse(_base.read_text()).body
+    if isinstance(node, ast.ClassDef) and node.name == "KVPoll"
+)
+_enum_namespace = {}
+exec(
+    compile(ast.Module(body=[_enum], type_ignores=[]), str(_base), "exec"),
+    _enum_namespace,
+)
+KVPoll = _enum_namespace["KVPoll"]
+
+
+def _load_queue():
+    # Exercise the production queue method without importing GPU scheduler kernels.
+    path = (
+        Path(__file__).resolve().parents[4]
+        / "python/sglang/srt/disaggregation/prefill.py"
+    )
+    tree = ast.parse(path.read_text())
+    helper = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == "_BootstrapDeadlinePoller"
+    )
+    queue = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == "PrefillBootstrapQueue"
+    )
+    methods = [
+        node
+        for node in queue.body
+        if isinstance(node, ast.FunctionDef)
+        and node.name in {"pop_bootstrapped", "poll_bootstrap_statuses"}
+    ]
+    for method in methods:
+        method.decorator_list = []  # Scheduler telemetry is outside this CPU queue contract.
+    queue.body = methods
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__", names=[ast.alias(name="annotations")], level=0
+            ),
+            helper,
+            queue,
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    namespace = {
+        "KVPoll": KVPoll,
+        "os": os,
+        "time": time,
+        "logger": logging.getLogger(__name__),
+        "should_force_retry": lambda req: False,
+        "get_disagg": lambda: SimpleNamespace(optimistic_prefill_attempts=0),
+    }
+    exec(compile(module, str(path), "exec"), namespace)
+    return namespace
+
+
+def _request(status=KVPoll.Bootstrapping, entry=100.0):
+    return SimpleNamespace(
+        rid="request",
+        disagg_kv_sender=SimpleNamespace(poll=lambda: status),
+        time_stats=SimpleNamespace(
+            prefill_bootstrap_queue_entry_time=entry, set_wait_queue_entry_time=Mock()
+        ),
+        prefill_attempt_count=0,
+        is_retracted=False,
+    )
+
+
+@pytest.mark.parametrize(
+    "status,entry,now,expected",
+    [
+        (KVPoll.Bootstrapping, 100.0, 701.0, KVPoll.Failed),
+        (KVPoll.Bootstrapping, 100.0, 700.0, KVPoll.Bootstrapping),
+        (KVPoll.Bootstrapping, 0.0, 1000.0, KVPoll.Bootstrapping),
+        (KVPoll.WaitingForInput, 100.0, 1000.0, KVPoll.WaitingForInput),
+        (KVPoll.Failed, 100.0, 101.0, KVPoll.Failed),
+    ],
+)
+def test_deadline_preserves_ready_and_native_failure(status, entry, now, expected):
+    namespace = _load_queue()
+    poller = namespace["_BootstrapDeadlinePoller"](_request(status, entry), now, 600.0)
+    assert poller.poll() == expected
+
+
+def test_one_tp_rank_timeout_removes_request_on_all_ranks(monkeypatch):
+    namespace = _load_queue()
+    monkeypatch.setenv("SGLANG_DISAGGREGATION_TRANSFER_TIMEOUT", "600")
+    monkeypatch.setattr(time, "perf_counter", lambda: 701.0)
+    requests = [_request(entry=100.0), _request(entry=102.0)]
+    # Only rank zero has expired; both must take the existing failure path.
+    peer_polls = [
+        namespace["_BootstrapDeadlinePoller"](req, 701.0, 600.0).poll()
+        for req in requests
+    ]
+    local_observations = []
+    for rank, req in enumerate(requests):
+
+        def reduce(pollers, cp_group, tp_group):
+            local = [poller.poll() for poller in pollers]
+            local_observations.append((rank, local))
+            return [min(local[0], peer_polls[1 - rank])]
+
+        namespace["poll_and_all_reduce_attn_cp_tp_group"] = reduce
+        namespace["poll_and_all_reduce_pp"] = lambda rids, state, good, bad: [
+            None for _ in rids
+        ]
+        queue = namespace["PrefillBootstrapQueue"]()
+        queue.queue = [req]
+        queue.pp_size = 1
+        queue.scheduler = SimpleNamespace(
+            processed_tokens_counter=0,
+            attn_cp_cpu_group="cp",
+            attn_tp_cpu_group="tp",
+            handle_bootstrap_failure=Mock(),
+        )
+        ready, failed = queue.pop_bootstrapped(return_failed_reqs=True)
+        assert ready == [] and failed == [req] and queue.queue == []
+        queue.scheduler.handle_bootstrap_failure.assert_called_once_with(req)
+    assert local_observations == [(0, [KVPoll.Failed]), (1, [KVPoll.Bootstrapping])]
+
+
+def test_pp_bootstrap_timeout_waits_for_bad_union_across_stages(monkeypatch):
+    """Two PP stages each have two TP ranks; only PP1/TP1 is expired."""
+    namespace = _load_queue()
+    monkeypatch.setenv("SGLANG_DISAGGREGATION_TRANSFER_TIMEOUT", "600")
+    monkeypatch.setattr(time, "perf_counter", lambda: 701.0)
+    # _base is .../srt/disaggregation/base/conn.py.
+    path = _base.parents[2] / "managers/scheduler_pp_mixin.py"
+    cls = next(
+        node
+        for node in ast.parse(path.read_text()).body
+        if isinstance(node, ast.ClassDef) and node.name == "SchedulerPPMixin"
+    )
+    for node in cls.body:
+        if isinstance(node, ast.FunctionDef) and node.name in {
+            "_pp_pd_get_bootstrapped_ids",
+            "get_rids",
+            "_route_aborts_to_bad",
+        }:
+            node.decorator_list = []
+            module = ast.Module(
+                body=[
+                    ast.ImportFrom(
+                        module="__future__",
+                        names=[ast.alias(name="annotations")],
+                        level=0,
+                    ),
+                    node,
+                ],
+                type_ignores=[],
+            )
+            exec(
+                compile(ast.fix_missing_locations(module), str(path), "exec"), namespace
+            )
+    namespace["FINISH_ABORT"] = type("Abort", (), {})
+    namespace["poll_and_all_reduce_pp"] = lambda rids, state, good, bad: [
+        KVPoll.Failed if rid in (bad or []) else state if rid in (good or []) else None
+        for rid in rids
+    ]
+    queues = []
+    for pp in range(2):
+        ranks = []
+        for tp in range(2):
+            req = _request(entry=100.0 if (pp, tp) == (1, 1) else 102.0)
+            req.finished_reason = None
+            queue = namespace["PrefillBootstrapQueue"]()
+            queue.queue, queue.pp_size = [req], 2
+            queue.scheduler = SimpleNamespace(
+                attn_cp_cpu_group=pp,
+                attn_tp_cpu_group=pp,
+                processed_tokens_counter=0,
+                handle_bootstrap_failure=Mock(),
+            )
+            ranks.append(queue)
+        queues.append(ranks)
+
+    def reduce(pollers, cp_group, tp_group):
+        # Reproduce TP MIN within one PP stage, never across PP stages.
+        if isinstance(pollers[0], namespace["_BootstrapDeadlinePoller"]):
+            values = [
+                namespace["_BootstrapDeadlinePoller"](q.queue[0], 701.0, 600.0).poll()
+                for q in queues[tp_group]
+            ]
+        else:
+            values = [q.queue[0].disagg_kv_sender.poll() for q in queues[tp_group]]
+        return [min(values)]
+
+    namespace["poll_and_all_reduce_attn_cp_tp_group"] = reduce
+    for ranks in queues:
+        for queue in ranks:
+            assert queue.pop_bootstrapped(
+                return_failed_reqs=True, pp_good_rids=[], pp_bad_rids=[]
+            ) == ([], [])
+            assert len(queue.queue) == 1
+
+    consensus = [[], []]
+    for pp, ranks in enumerate(queues):
+        results = []
+        for queue in ranks:
+            scheduler = queue.scheduler
+            scheduler.disagg_prefill_bootstrap_queue = queue
+            scheduler.pp_group = SimpleNamespace(is_first_rank=pp == 0)
+            scheduler._pp_recv_pyobj_from_prev_stage = lambda: consensus
+            scheduler.get_rids = lambda *args, scheduler=scheduler: namespace[
+                "get_rids"
+            ](scheduler, *args)
+            scheduler._route_aborts_to_bad = namespace["_route_aborts_to_bad"]
+            results.append(namespace["_pp_pd_get_bootstrapped_ids"](scheduler))
+        assert results[0] == results[1]
+        consensus = results[0]
+    assert consensus == [[], ["request"]]
+    for ranks in queues:
+        for queue in ranks:
+            req = queue.queue[0]
+            assert queue.pop_bootstrapped(
+                return_failed_reqs=True,
+                pp_good_rids=consensus[0],
+                pp_bad_rids=consensus[1],
+            ) == ([], [req])
+            assert queue.queue == []
+            queue.scheduler.handle_bootstrap_failure.assert_called_once_with(req)
+
+
+def test_pp_consensus_ready_request_is_not_replaced_by_local_deadline(monkeypatch):
+    namespace = _load_queue()
+    monkeypatch.setattr(time, "perf_counter", lambda: 1000.0)
+    req = _request(entry=100.0)
+    namespace["poll_and_all_reduce_pp"] = lambda rids, state, good, bad: [
+        KVPoll.WaitingForInput
+    ]
+    namespace["poll_and_all_reduce_attn_cp_tp_group"] = Mock(
+        side_effect=AssertionError(
+            "PP-covered request must not enter another collective"
+        )
+    )
+    queue = namespace["PrefillBootstrapQueue"]()
+    queue.queue = [req]
+    queue.pp_size = 2
+    queue.scheduler = SimpleNamespace(
+        processed_tokens_counter=0, handle_bootstrap_failure=Mock()
+    )
+    queue.finalize_bootstrap = lambda req: True
+    assert queue.pop_bootstrapped() == [req]
+    assert queue.queue == []
+    queue.scheduler.handle_bootstrap_failure.assert_not_called()
