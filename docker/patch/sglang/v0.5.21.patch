+"""CPU contracts for LoRA leases across tokenizer abort and terminal races."""
+
+import ast
+import asyncio
+import copy
+import logging
+import os
+from collections import OrderedDict
+from http import HTTPStatus
+from pathlib import Path
+from types import SimpleNamespace as N
+
+import pytest
+
+
+def _production_class(root, path, name, methods=None):
+    tree = ast.parse((root / path).read_text())
+    node = next(
+        item
+        for item in tree.body
+        if isinstance(item, ast.ClassDef) and item.name == name
+    )
+    if methods is not None:
+        node.body = [
+            item
+            for item in node.body
+            if isinstance(item, (ast.FunctionDef, ast.AsyncFunctionDef))
+            and item.name in methods
+        ]
+    for item in node.body:
+        if isinstance(item, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            item.decorator_list = []
+    return node
+
+
+class _AsyncLock:
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, *args):
+        return False
+
+
+@pytest.fixture
+def runtime():
+    override = os.environ.get("SGLANG_TEST_SOURCE_ROOT")
+    root = (
+        Path(override).parents[1] if override else Path(__file__).resolve().parents[4]
+    )
+    namespace = {
+        "asyncio": asyncio,
+        "copy": copy,
+        "HTTPStatus": HTTPStatus,
+        "logger": logging.getLogger(__name__),
+        "GenerateReqInput": type("GenerateReqInput", (), {}),
+        "get_disagg": lambda: N(language_only=False),
+        "get_lora": lambda: N(max_loaded_loras=None),
+        "get_serving": lambda: N(tokenizer_worker_num=1),
+        "AbortReq": lambda **kwargs: N(kind="abort", **kwargs),
+    }
+    path = "python/sglang/srt/managers/tokenizer_manager.py"
+    nodes = [
+        _production_class(
+            root, "python/sglang/srt/utils/common.py", "ConcurrentCounter"
+        ),
+        _production_class(
+            root,
+            "python/sglang/srt/lora/lora_registry.py",
+            "LoRARegistry",
+            {"acquire", "release", "wait_for_unload", "get_unregistered_loras"},
+        ),
+        _production_class(root, path, "RequestAbortedError"),
+        _production_class(
+            root,
+            path,
+            "TokenizerManager",
+            {
+                "generate_request",
+                "_validate_and_resolve_lora",
+                "_resolve_lora_path",
+                "_wait_for_request_unpaused",
+                "_raise_if_request_aborted",
+                "_release_req_states_on_failure",
+                "_send_one_request",
+                "abort_request",
+                "_finalize_lora_lease",
+                "_handle_abort_finish_reason",
+                "_handle_batch_request",
+                "_init_parallel_req_state",
+                "_collect_batch_responses",
+            },
+        ),
+    ]
+    nodes[-1].bases = []
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__", names=[ast.alias(name="annotations")], level=0
+            ),
+            *nodes,
+        ],
+        type_ignores=[],
+    )
+    exec(
+        compile(ast.fix_missing_locations(module), str(root / path), "exec"), namespace
+    )
+    return namespace
+
+
+def _manager(runtime):
+    registry = runtime["LoRARegistry"]()
+    registry._registry_lock = N(reader_lock=_AsyncLock(), writer_lock=_AsyncLock())
+    registry._registry = OrderedDict(adapter=N(lora_id="lease"))
+    registry._counters = {"lease": runtime["ConcurrentCounter"]()}
+    manager = runtime["TokenizerManager"]()
+    manager.enable_lora, manager.enable_metrics, manager.is_pause = True, False, False
+    manager.tokenizer = None
+    manager.encoder_dispatch_ready, manager.rid_to_state = {}, {}
+    manager.model_update_lock = N(reader_lock=_AsyncLock())
+    manager.lora_registry = registry
+    manager.request_logger = N(log_received_request=lambda *args: None)
+    manager.auto_create_handle_loop = lambda: None
+    manager._set_default_priority = lambda *args: None
+
+    def init_state(obj, request=None):
+        objects = (
+            [obj[i] for i in range(len(obj.rid))]
+            if isinstance(obj.rid, list)
+            else [obj]
+        )
+        manager.rid_to_state.update({item.rid: _state(item) for item in objects})
+
+    manager._init_req_state = init_state
+    sent = []
+    manager._dispatch_to_scheduler = sent.append
+    return manager, registry, sent
+
+
+def _state(obj, dispatched=False):
+    return N(
+        obj=obj,
+        event=asyncio.Event(),
+        dispatched=dispatched,
+        abort_sent=False,
+        abort_requested=False,
+        lora_lease_released=False,
+        time_stats=N(set_finished_time=lambda: None),
+    )
+
+
+async def _unload(registry):
+    registry._registry.clear()
+    await asyncio.wait_for(registry.wait_for_unload("lease"), 1.0)
+    assert "lease" not in registry._counters
+
+
+def test_abort_after_acquire_before_dispatch_allows_unload(runtime):
+    async def run():
+        manager, registry, sent = _manager(runtime)
+        entered, resume = asyncio.Event(), asyncio.Event()
+
+        async def tokenize(obj):
+            entered.set()
+            await resume.wait()
+            return N(rid=obj.rid, mm_inputs=None)
+
+        async def prepare(*args):
+            return []
+
+        manager._tokenize_one_request = tokenize
+        manager.cuda_vmm_feature_transport = N(
+            prepare_for_dispatch_async=prepare, cancel_for_dispatch=lambda *args: None
+        )
+        obj = N(
+            rid="r",
+            is_single=True,
+            lora_path="adapter",
+            lora_id=None,
+            return_prompt_token_ids=False,
+            normalize_batch_and_arguments=lambda: None,
+        )
+        task = asyncio.create_task(manager.generate_request(obj).__anext__())
+        await asyncio.wait_for(entered.wait(), 1.0)
+        assert registry._counters["lease"].value() == 1
+        manager.abort_request("r")
+        resume.set()
+        with pytest.raises(runtime["RequestAbortedError"]) as error:
+            await task
+        assert error.value.status_code == 499
+        assert not manager.rid_to_state
+        assert all(item.kind == "abort" for item in sent)
+        await _unload(registry)
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("stop", [None, "prefix", "child", "acquire"])
+@pytest.mark.parametrize("n", [2, 3])
+def test_parallel_sampling_clones_own_leases_and_parents_are_retired(runtime, stop, n):
+    # Use the actual n-expansion and cached sub-objects: the original request
+    # has n parent states/leases, not just one, before clones are constructed.
+    from sglang.srt.managers.io_struct import GenerateReqInput
+
+    async def run():
+        manager, registry, sent = _manager(runtime)
+        obj = GenerateReqInput(
+            input_ids=[1, 2], lora_path="adapter", sampling_params={"n": n}
+        )
+        generated = []
+
+        async def tokenize(request):
+            return N(
+                rid=request.rid,
+                input_ids=request.input_ids,
+                mm_inputs=None,
+                sampling_params=N(max_new_tokens=1),
+                lora_id=request.lora_id,
+            )
+
+        async def send(tokenized):
+            state = manager.rid_to_state[tokenized.rid]
+            state.dispatched = True
+            assert tokenized.lora_id == state.obj.lora_id == "lease"
+            generated.append(tokenized)
+            if stop == "child" and tokenized.sampling_params.max_new_tokens:
+                manager.abort_request(obj.rid[0])
+
+        async def response(request, *_):
+            state = manager.rid_to_state.pop(request.rid)
+            manager._finalize_lora_lease(state)
+            await asyncio.sleep(0)
+            if len(generated) == 1:
+                assert registry._counters["lease"].value() == n
+                if stop == "prefix":
+                    manager.abort_request(obj.rid[0])
+                if stop == "acquire":
+                    # Removal during a clone acquire must not release the
+                    # copied parent's ID a second time.
+                    registry._registry.clear()
+            yield {"rid": request.rid}
+
+        (
+            manager._tokenize_one_request,
+            manager._send_one_request,
+            manager._wait_one_response,
+        ) = tokenize, send, response
+        stream = manager.generate_request(obj)
+        if stop is None:
+            outputs = await stream.__anext__()
+            assert len(outputs) == n and len(generated) == n + 1
+        else:
+            with pytest.raises(ValueError):
+                await stream.__anext__()
+            # Only dispatched children may remain until their terminal echo.
+            assert all(state.dispatched for state in manager.rid_to_state.values())
+            for state in list(manager.rid_to_state.values()):
+                manager._finalize_lora_lease(state)
+                del manager.rid_to_state[state.obj.rid]
+        await stream.aclose()
+        await _unload(registry)
+        assert not manager.rid_to_state
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("first_dispatched", [False, True])
+@pytest.mark.parametrize("status", [500, 503])
+def test_batch_leases_are_per_request_and_terminal_release_is_once(
+    runtime, first_dispatched, status
+):
+    async def run():
+        manager, registry, sent = _manager(runtime)
+        objects = [N(rid=f"r{i}", lora_path="adapter", lora_id=None) for i in range(2)]
+        batch = N(
+            lora_path=["adapter", "adapter"],
+            lora_id=None,
+            _sub_obj_cache=dict(enumerate(objects)),
+        )
+        states = [
+            _state(obj, first_dispatched and i == 0) for i, obj in enumerate(objects)
+        ]
+        manager.rid_to_state = {state.obj.rid: state for state in states}
+        await manager._validate_and_resolve_lora(batch)
+        assert registry._counters["lease"].value() == 2
+        assert all(obj.lora_id == "lease" for obj in objects)
+        manager._release_req_states_on_failure([obj.rid for obj in objects])
+        await asyncio.sleep(0)
+        assert registry._counters["lease"].value() == (1 if first_dispatched else 0)
+        assert list(manager.rid_to_state) == (["r0"] if first_dispatched else [])
+        out = {
+            "meta_info": {
+                "finish_reason": {
+                    "type": "abort",
+                    "status_code": status,
+                    "message": "aborted",
+                }
+            }
+        }
+        for state in states:
+            # Terminal output processing and the awaiting client can both
+            # finalize; each batch child owns one lease even for the same ID.
+            manager._finalize_lora_lease(state)
+            assert (
+                await manager._handle_abort_finish_reason(out, state, is_stream=True)
+                == out
+            )
+        await _unload(registry)
+        assert not manager.rid_to_state
+
+    asyncio.run(run())
