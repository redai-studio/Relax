+"""Weight checking must leave derived position/axis buffers intact."""
+
+import ast
+import logging
+import os
+from pathlib import Path
+from types import SimpleNamespace
+from typing import NamedTuple
+
+import numpy as np
+import pytest
+import torch
+
+
+def _load(path, names, namespace, methods=None):
+    nodes = [
+        node
+        for node in ast.parse(path.read_text()).body
+        if isinstance(node, (ast.ClassDef, ast.FunctionDef)) and node.name in names
+    ]
+    if methods is not None:
+        for node in nodes:
+            if isinstance(node, ast.ClassDef):
+                node.body = [
+                    item
+                    for item in node.body
+                    if isinstance(item, ast.FunctionDef) and item.name in methods
+                ]
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__", names=[ast.alias(name="annotations")], level=0
+            ),
+            *nodes,
+        ],
+        type_ignores=[],
+    )
+    exec(compile(ast.fix_missing_locations(module), str(path), "exec"), namespace)
+
+
+class _RotaryBase(torch.nn.Module):
+    def __init__(self, head_size, rotary_dim, *args):
+        super().__init__()
+        self.rotary_dim = rotary_dim
+        self.cos_sin_cache = torch.zeros(4, rotary_dim)
+        self._force_native = False
+
+
+@torch.no_grad()
+@pytest.mark.parametrize(
+    "kind", ["kimi25", "kimi3", "mrope", "mrope_interleaved", "mrope_glm", "mrope_none"]
+)
+def test_derived_buffers_survive_weight_reset_and_are_excluded_from_comparison(kind):
+    override = os.environ.get("SGLANG_TEST_SOURCE_ROOT")
+    root = (
+        Path(override)
+        if override
+        else Path(__file__).resolve().parents[4] / "python/sglang"
+    )
+    namespace = {
+        "torch": torch,
+        "nn": torch.nn,
+        "np": np,
+        "RotaryEmbedding": _RotaryBase,
+    }
+    if kind.startswith("kimi"):
+        path = root / (
+            "srt/models/kimi_k25.py" if kind == "kimi25" else "srt/models/kimi_k3_vl.py"
+        )
+        cls = (
+            "Learnable2DInterpPosEmbDivided_fixed"
+            if kind == "kimi25"
+            else "Learnable2DInterpPosEmbDividedFixed"
+        )
+        _load(
+            path,
+            {cls, "get_1d_sincos_pos_embed", "get_1d_sincos_pos_embed_from_grid"},
+            namespace,
+            {"__init__", "reset_parameters"},
+        )
+        model = namespace[cls](height=2, width=2, num_frames=3, dim=8)
+    else:
+        _load(
+            root / "srt/layers/rotary_embedding/mrope.py",
+            {"MRotaryEmbedding"},
+            namespace,
+            {"__init__", "_build_axis_map"},
+        )
+        model = namespace["MRotaryEmbedding"](
+            12,
+            12,
+            16,
+            10000,
+            True,
+            torch.float32,
+            mrope_section=None if kind == "mrope_none" else [2, 2, 2],
+            mrope_interleaved=kind == "mrope_interleaved",
+            mrope_interleaved_glm=kind == "mrope_glm",
+        )
+        model.weight = torch.nn.Parameter(torch.full((2, 2), 9.0))
+    model.weight.fill_(9.0)
+    checker_ns = {
+        "torch": torch,
+        "NamedTuple": NamedTuple,
+        "CHUNK_NUMEL": 64,
+        "logger": logging.getLogger(__name__),
+        "select_comparable_weight": lambda _: None,
+    }
+    _load(
+        root / "srt/utils/weight_checker_comparator.py",
+        {"CompareResult", "ComparableWeight", "RawComparable", "compare_weights"},
+        checker_ns,
+    )
+    # Exercise native comparison arithmetic on CPU; only CUDA transfer is omitted.
+    checker_ns["RawComparable"].iter_chunks = lambda self: iter(
+        [(self.tensor.reshape(-1), None)]
+    )
+    checker_path = root / "srt/utils/weight_checker.py"
+    tree = ast.parse(checker_path.read_text())
+    patterns = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.Assign)
+        and any(
+            isinstance(target, ast.Name)
+            and target.id == "_NON_PERSISTENT_BUFFER_PATTERNS"
+            for target in node.targets
+        )
+    )
+    exec(
+        compile(
+            ast.Module(body=[patterns], type_ignores=[]), str(checker_path), "exec"
+        ),
+        checker_ns,
+    )
+    _load(
+        checker_path,
+        {
+            "WeightChecker",
+            "CheckEntry",
+            "QuantizedWeight",
+            "_is_non_persistent_buffer_name",
+            "_is_skip_weight_check",
+            "_random_like",
+            "_build_quantized_set",
+            "_build_check_entries",
+            "_check_tensors",
+        },
+        checker_ns,
+    )
+    checker = checker_ns["WeightChecker"].__new__(checker_ns["WeightChecker"])
+    checker._get_model = lambda: model
+    snapshot = {name: tensor.clone() for name, tensor in checker._model_state()}
+    derived = dict(model.named_buffers())
+    checker._reset_tensors()
+    assert not torch.equal(model.weight, snapshot["weight"])
+    for name, tensor in derived.items():
+        torch.testing.assert_close(tensor, snapshot[name])
+    assert checker._skip_compare_names() == set(derived)
+    model.weight.copy_(snapshot["weight"])
+    # Derived tensors may be rebuilt without participating in weight equality.
+    for tensor in derived.values():
+        tensor.add_(1)
+    checker._snapshot_tensors = snapshot
+    checker._compare()
+    # The exclusion must not suppress ordinary training-weight errors.
+    checker._snapshot_tensors = snapshot
+    model.weight.add_(1)
+    with pytest.raises(Exception, match="check tensor equality failed"):
+        checker._compare()
+
+
+@pytest.mark.parametrize("device", ["cpu", "meta"])
+@pytest.mark.parametrize("activation", [None, "silu"])
+def test_qwen_gdn_norm_follows_model_construction_device(
+    monkeypatch, device, activation
+):
+    override = os.environ.get("SGLANG_TEST_SOURCE_ROOT")
+    root = (
+        Path(override)
+        if override
+        else Path(__file__).resolve().parents[4] / "python/sglang"
+    )
+    namespace = {"torch": torch}
+    _load(
+        root / "kernels/ops/attention/fla/layernorm_gated.py",
+        {"RMSNorm"},
+        namespace,
+        {"__init__", "reset_parameters"},
+    )
+    path = root / "srt/models/qwen3_5.py"
+    cls = next(
+        node
+        for node in ast.parse(path.read_text()).body
+        if isinstance(node, ast.ClassDef) and node.name == "Qwen3_5GatedDeltaNet"
+    )
+    init = next(
+        node
+        for node in cls.body
+        if isinstance(node, ast.FunctionDef) and node.name == "__init__"
+    )
+    # Execute the actual norm construction with the actual RMSNorm constructor;
+    # other model layers and attention kernels are irrelevant to device placement.
+    assignment = next(
+        node
+        for node in init.body
+        if isinstance(node, ast.Assign)
+        and any(
+            isinstance(target, ast.Attribute) and target.attr == "norm"
+            for target in node.targets
+        )
+    )
+    model = torch.nn.Module()
+    model.head_v_dim = 8
+    model.layer_norm_epsilon = 1e-6
+    model.output_gate_type = activation
+
+    def unexpected_current_device():
+        raise AssertionError("norm construction must honor the model device context")
+
+    monkeypatch.setattr(
+        torch,
+        "get_device_module",
+        lambda: SimpleNamespace(current_device=unexpected_current_device),
+    )
+    with torch.device(device):
+        exec(
+            compile(ast.Module(body=[assignment], type_ignores=[]), str(path), "exec"),
+            {"self": model, "torch": torch, "RMSNormGated": namespace["RMSNorm"]},
+        )
+    assert model.norm.weight.device.type == device
+    assert model.norm.weight.dtype == torch.get_default_dtype()
+    assert model.norm.activation == (activation or "swish")
+    assert model.norm.eps == 1e-6
+    assert model.norm.norm_before_gate
