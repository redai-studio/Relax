+"""Routed-expert rows follow logical KV slots across CPU HiCache transfers."""
+
+import torch
+
+
+class RoutedExpertsHostCache:
+    def __init__(self, capacity: int, source: torch.Tensor):
+        self.buffer = torch.empty((capacity, *source.shape[1:]), dtype=source.dtype)
+        self.valid = torch.zeros(capacity, dtype=torch.bool)
+
+    def backup(self, source: torch.Tensor, host: torch.Tensor, device: torch.Tensor):
+        self.buffer[host] = source[device]
+        self.valid[host] = True
+
+    def covers(self, host: torch.Tensor) -> bool:
+        return bool(self.valid[host].all())
+
+    def restore(self, target: torch.Tensor, host: torch.Tensor, device: torch.Tensor):
+        # D may receive prompt KV directly from P, without local route metadata.
+        # Its prompt routes are supplied by the router; restore only known rows.
+        valid = self.valid[host]
+        target[device[valid]] = self.buffer[host[valid]]
+
+    def invalidate(self, host: torch.Tensor):
+        self.valid[host] = False
+
+    def reset(self):
+        self.valid.zero_()
