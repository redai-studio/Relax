+# SPDX-License-Identifier: Apache-2.0
+"""Strict validation of generation-branch dense weight-update buckets."""
+
+from __future__ import annotations
+
+import torch
+
+
+def validate_dense_bucket(
+    bucket: list[tuple[str, torch.Tensor]],
+    materialized_weights: list[tuple[str, torch.Tensor]],
+) -> None:
+    """Reject the entire bucket before any in-place parameter write."""
+    if not bucket:
+        raise ValueError("SenseNova dense weight bucket is empty")
+    expected = dict(materialized_weights)
+    if len(expected) != len(materialized_weights):
+        raise ValueError("SenseNova model has duplicate materialized parameter names")
+    seen: set[str] = set()
+    for entry in bucket:
+        if not isinstance(entry, (list, tuple)) or len(entry) != 2:
+            raise ValueError("SenseNova dense entries must be (name, tensor) pairs")
+        name, tensor = entry
+        if not isinstance(name, str) or not name or name in seen:
+            raise ValueError(f"Invalid or duplicate SenseNova weight name: {name!r}")
+        seen.add(name)
+        if name not in expected:
+            raise ValueError(f"Unknown SenseNova weight: {name}")
+        if not isinstance(tensor, torch.Tensor) or tensor.shape != expected[name].shape:
+            raise ValueError(f"SenseNova weight shape/type mismatch: {name}")
