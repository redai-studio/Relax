+# SPDX-License-Identifier: Apache-2.0
+"""Reuse identical static RoPE results within one ART decoder forward."""
+
+import functools
+from typing import Any
+
+import torch
+
+
+def install_rope_cache(model: Any) -> None:
+    # Cache only within one decoder forward. Values depend on positions,
+    # inverse frequencies, scaling and dtype, not hidden-state contents.
+    decoder = model.language_model.model
+    cache = {}
+    for attribute in ["rotary_emb", "rotary_emb_hw"]:
+        reference = getattr(decoder.layers[0].self_attn, attribute)
+        for layer in decoder.layers:
+            rotary = getattr(layer.self_attn, attribute)
+            if not torch.equal(rotary.inv_freq, reference.inv_freq):
+                raise ValueError("Layer RoPE frequencies are not identical")
+            if (
+                rotary.attention_scaling != reference.attention_scaling
+                or rotary.rope_type != "default"
+            ):
+                raise ValueError("Only static identical RoPE tables are supported")
+            original = rotary.forward
+
+            def forward(x, position_ids, _original=original, _group=attribute):
+                key = (
+                    _group,
+                    x.dtype,
+                    x.device,
+                    position_ids.data_ptr(),
+                    tuple(position_ids.shape),
+                    tuple(position_ids.stride()),
+                )
+                if key not in cache:
+                    cache[key] = _original(x, position_ids)
+                return cache[key]
+
+            rotary.forward = forward
+    original_decoder = decoder.forward
+
+    @functools.wraps(original_decoder)
+    def decoder_forward(*args, **kwargs):
+        cache.clear()
+        try:
+            return original_decoder(*args, **kwargs)
+        finally:
+            cache.clear()
+
+    decoder.forward = decoder_forward
