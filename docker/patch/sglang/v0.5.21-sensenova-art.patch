+# SPDX-License-Identifier: Apache-2.0
+"""Request-local SenseNova I2I rollout contract, independent of trainer state."""
+
+from __future__ import annotations
+
+import hashlib
+import math
+from typing import Any
+
+import torch
+
+ROLLOUT_PROTOCOL_VERSION = 4
+ART_ROLLOUT_PROTOCOL_VERSION = 5
+
+
+def _seed(value: Any, name: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or not 0 <= value < 2**63:
+        raise ValueError(f"{name} must be an integer in [0, 2**63)")
+    return value
+
+
+def derive_denoise_seed(base_seed: int, candidate_id: str, step: int) -> int:
+    payload = f"sensenova-rollout-v1\0{base_seed}\0{candidate_id}\0{step}".encode()
+    return int.from_bytes(hashlib.sha256(payload).digest()[:8], "little") % 2**63
+
+
+def _indices(value: Any, total: int, name: str) -> list[int]:
+    if not isinstance(value, (list, tuple)) or any(
+        isinstance(i, bool) or not isinstance(i, int) or not 0 <= i < total
+        for i in value
+    ):
+        raise ValueError(f"{name} must contain transition indices in [0, {total})")
+    if len(set(value)) != len(value):
+        raise ValueError(f"{name} must not contain duplicate indices")
+    return sorted(value)
+
+
+class SenseNovaRolloutPlan:
+    """Validate model-specific controls; execution state lives on the request."""
+
+    def __init__(
+        self,
+        *,
+        num_steps: int,
+        seed: int,
+        dynamics: str,
+        noise_level: float,
+        sde_step_indices: list[int] | None = None,
+        return_step_indices: list[int] | None = None,
+        options: dict[str, Any] | None = None,
+    ):
+        options = dict(options or {})
+        allowed = {
+            "capture",
+            "initial_seed",
+            "denoise_seed",
+            "denoise_seeds",
+            "candidate_id",
+            "sigmas",
+            "timesteps",
+            "storage_dtype",
+        }
+        unknown = set(options) - allowed
+        if unknown:
+            raise ValueError(f"Unknown SenseNova rollout options: {sorted(unknown)}")
+        if (
+            isinstance(num_steps, bool)
+            or not isinstance(num_steps, int)
+            or num_steps < 1
+        ):
+            raise ValueError("num_steps must be a positive integer")
+        if dynamics not in ("ode", "cps", "sde"):
+            raise ValueError(f"Unsupported SenseNova rollout dynamics: {dynamics!r}")
+        if not math.isfinite(noise_level) or not 0 <= noise_level <= 1:
+            raise ValueError("noise_level must be finite and in [0, 1]")
+        self.num_steps = num_steps
+        self.dynamics = dynamics
+        self.noise_level = 0.0 if dynamics == "ode" else noise_level
+        self.capture = options.get(
+            "capture", "terminal" if dynamics == "ode" else "transitions"
+        )
+        if self.capture not in ("terminal", "transitions", "ode_states"):
+            raise ValueError("capture must be 'terminal', 'transitions' or 'ode_states'")
+        if self.capture == "ode_states" and (
+            dynamics != "ode" or noise_level != 0 or sde_step_indices not in (None, [])
+        ):
+            raise ValueError("ODE state capture requires deterministic ODE with no stochastic steps")
+        if self.capture == "transitions" and (dynamics == "ode" or noise_level <= 0):
+            raise ValueError("Transition-score capture requires stochastic dynamics")
+        self.storage_dtype = options.get("storage_dtype", "bfloat16")
+        if self.storage_dtype not in ("bfloat16", "float16"):
+            raise ValueError("storage_dtype must be bfloat16 or float16")
+        if self.storage_dtype == "float16" and (dynamics != "ode" or self.capture not in ("terminal", "ode_states")):
+            raise ValueError("FP16 storage requires ODE terminal or selected-state capture")
+        self.initial_seed = _seed(options.get("initial_seed", seed), "initial_seed")
+        self.candidate_id = str(options.get("candidate_id", seed))
+        if not self.candidate_id:
+            raise ValueError("candidate_id must not be empty")
+        base = _seed(options.get("denoise_seed", seed), "denoise_seed")
+        denoise = options.get("denoise_seeds")
+        if denoise is not None and (
+            not isinstance(denoise, list) or len(denoise) != num_steps
+        ):
+            raise ValueError("denoise_seeds must have one seed per transition")
+        self.denoise_seeds = [
+            _seed(denoise[i], "denoise_seeds")
+            if denoise is not None
+            else derive_denoise_seed(base, self.candidate_id, i)
+            for i in range(num_steps)
+        ]
+        eligible = _indices(
+            list(range(num_steps - 1))
+            if sde_step_indices is None
+            else sde_step_indices,
+            num_steps,
+            "sde_step_indices",
+        )
+        self.sde_indices = eligible if self.noise_level > 0 else []
+        if dynamics == "cps" and num_steps - 1 in self.sde_indices:
+            raise ValueError(
+                "The terminal CPS step has zero variance and cannot be stochastic"
+            )
+        self.transition_indices = []
+        self.selected_indices = []
+        if self.capture == "transitions":
+            self.transition_indices = _indices(
+                self.sde_indices
+                if return_step_indices is None
+                else return_step_indices,
+                num_steps,
+                "return_step_indices",
+            )
+            if not self.transition_indices or not set(self.transition_indices) <= set(
+                self.sde_indices
+            ):
+                raise ValueError(
+                    "Captured transitions must be a nonempty subset of stochastic steps"
+                )
+        elif self.capture == "ode_states":
+            self.selected_indices = _indices(
+                return_step_indices, num_steps, "return_step_indices"
+            )
+            if not self.selected_indices:
+                raise ValueError("ODE state capture requires nonempty explicit input step indices")
+        elif return_step_indices not in (None, []):
+            raise ValueError("Terminal capture does not accept return_step_indices")
+        self.state_indices = (
+            self.selected_indices + [num_steps]
+            if self.capture == "ode_states"
+            else [num_steps]
+            if self.capture == "terminal"
+            else sorted({j for i in self.transition_indices for j in (i, i + 1)})
+        )
+        self.options = options
+
+    def prepare_schedule(self, native_timesteps: torch.Tensor) -> torch.Tensor:
+        """Freeze shifted scheduler coordinates; never shift a driver schedule twice."""
+        if len(native_timesteps) != self.num_steps + 1:
+            raise ValueError("Native schedule length does not match num_steps")
+        device = native_timesteps.device
+        explicit_sigmas = self.options.get("sigmas")
+        explicit_times = self.options.get("timesteps")
+        if explicit_sigmas is not None:
+            sigmas = torch.tensor(explicit_sigmas, dtype=torch.float32)
+            if sigmas.ndim != 1 or len(sigmas) != self.num_steps + 1:
+                raise ValueError(
+                    "sigmas must have T+1 entries, including terminal zero"
+                )
+            times = sigmas[:-1] * 1000
+        elif explicit_times is not None:
+            times = torch.tensor(explicit_times, dtype=torch.float32)
+            if times.ndim != 1 or len(times) != self.num_steps:
+                raise ValueError(
+                    "timesteps must have T entries in descending [1000,0] coordinates"
+                )
+            sigmas = torch.cat([times / 1000, times.new_zeros(1)])
+        else:
+            times = (1000 * (1 - native_timesteps[:-1].float())).cpu()
+            sigmas = torch.cat([times / 1000, times.new_zeros(1)])
+        if explicit_times is not None and explicit_sigmas is not None:
+            requested = torch.tensor(explicit_times, dtype=torch.float32)
+            if requested.shape != times.shape or not torch.allclose(
+                requested, times, atol=1e-5, rtol=1e-6
+            ):
+                raise ValueError("Driver timesteps and sigmas disagree")
+            times = requested
+        # Derive sigma from the public FP32 scheduler time coordinate,
+        # including driver-provided schedules.
+        sigmas = torch.cat([times / 1000, sigmas[-1:]])
+        if (
+            not torch.isfinite(sigmas).all()
+            or sigmas[0] != 1
+            or sigmas[-1] != 0
+            or not torch.all(sigmas[:-1] > sigmas[1:])
+        ):
+            raise ValueError(
+                "Schedule must decrease strictly from sigma=1 to terminal sigma=0"
+            )
+        if self.dynamics == "sde" and self.num_steps < 2:
+            raise ValueError("Flow-SDE requires at least two steps for sigma_max")
+        self.sigmas = sigmas.to(device)
+        self.timesteps = times.to(device)
+        # Convert scheduler time to the model's increasing native coordinate.
+        self.native_timesteps = torch.cat(
+            [1 - self.timesteps / 1000, self.timesteps.new_ones(1)]
+        )
+        return self.native_timesteps
+
+    def metadata(
+        self, conditioning: dict[str, Any], *, batch_size: int
+    ) -> dict[str, Any]:
+        return {
+            "protocol": "sensenova_i2i_flow_v1",
+            "protocol_version": ART_ROLLOUT_PROTOCOL_VERSION if self.capture == "ode_states" else ROLLOUT_PROTOCOL_VERSION,
+            "actual_batch_size": batch_size,
+            "dynamics": self.dynamics,
+            "capture": self.capture,
+            "state_layout": "T,C,H,W",
+            "storage_dtype": self.storage_dtype,
+            "score_kind": "none"
+            if not self.transition_indices
+            else (
+                "cps_residual_mse"
+                if self.dynamics == "cps"
+                else "gaussian_mean_logprob"
+            ),
+            "state_indices": self.state_indices,
+            "transition_indices": self.transition_indices,
+            "sde_indices": self.sde_indices,
+            "noise_level": self.noise_level,
+            "initial_seed": self.initial_seed,
+            "denoise_seeds": self.denoise_seeds,
+            "candidate_id": self.candidate_id,
+            "conditioning": conditioning,
+            **(
+                {
+                    "selected_indices": self.selected_indices,
+                    "velocity_convention": "noise_directed",
+                    "velocity_dtype": "float32",
+                    "solver": "euler",
+                }
+                if self.capture == "ode_states"
+                else {}
+            ),
+        }
+
+
+def build_rollout_plans(batch, options, seeds):
+    """Expand explicit candidate identities behind num_outputs_per_prompt.
+
+    A native group shares scheduler/conditioning controls. Heterogeneous groups
+    must remain separate requests, as with the public RolloutRequest schema.
+    """
+    options = dict(options or {})
+    candidates = options.pop("candidates", None)
+    count = int(batch.num_outputs_per_prompt)
+    if candidates is None:
+        if count != 1:
+            raise ValueError("Batched rollout requires explicit candidates")
+        candidates = [{"seed": seeds[0]}]
+    if not isinstance(candidates, list) or len(candidates) != count:
+        raise ValueError("candidates must have num_outputs_per_prompt entries")
+    plans = []
+    for candidate in candidates:
+        candidate = dict(candidate)
+        seed = _seed(candidate.pop("seed", None), "candidate seed")
+        allowed = {
+            "candidate_id",
+            "initial_seed",
+            "denoise_seed",
+            "denoise_seeds",
+        }
+        if set(candidate) - allowed:
+            raise ValueError("Candidates may override only identity and noise streams")
+        plan = SenseNovaRolloutPlan(
+            num_steps=int(batch.num_inference_steps),
+            seed=seed,
+            dynamics=batch.rollout_sde_type,
+            noise_level=float(batch.rollout_noise_level),
+            sde_step_indices=batch.rollout_sde_step_indices,
+            return_step_indices=batch.rollout_return_step_indices,
+            options={**options, **candidate},
+        )
+        plan.request_seed = seed
+        plans.append(plan)
+    if len({p.candidate_id for p in plans}) != count:
+        raise ValueError("Candidate IDs must be unique within a rollout batch")
+    if any(p.sde_indices != plans[0].sde_indices for p in plans):
+        raise ValueError(
+            "A batched group must share explicitly selected stochastic steps"
+        )
+    return plans
