@@ -0,0 +1,96 @@
+"""Lossless +0/-inf FP32 attention-mask transport for ART trajectories."""
+
+import math
+from typing import Any, Callable
+
+import numpy as np
+import torch
+
+
+MARKER = "__art_mask_bitpack__"
+NEG_INF = np.uint32(0xFF800000)
+MAX_BYTES = 2 * 1024**3
+CHUNK = 1024**2
+
+
+def encode_mask(tensor: Any) -> dict | None:
+    if not (
+        isinstance(tensor, torch.Tensor)
+        and tensor.device.type == "cpu"
+        and tensor.layout == torch.strided
+        and tensor.dtype == torch.float32
+        and tensor.ndim == 4
+        and tensor.is_contiguous()
+        and tensor.numel()
+        and not tensor.requires_grad
+        and not tensor.is_conj()
+        and not tensor.is_neg()
+        and 1048576 <= tensor.numel() * 4 <= MAX_BYTES
+    ):
+        return None
+    bits = tensor.numpy().reshape(-1).view(np.uint32)
+    chunks = []
+    for offset in range(0, bits.size, CHUNK):
+        block = bits[offset : offset + CHUNK]
+        selected = block == NEG_INF
+        if not np.all((block == 0) | selected):
+            return None
+        chunks.append(np.packbits(selected, bitorder="little").tobytes())
+    data = b"".join(chunks)
+    return {
+        MARKER: 1,
+        "dtype": "torch.float32",
+        "shape": list(tensor.shape),
+        "numel": tensor.numel(),
+        "bitorder": "little",
+        "data": data,
+    }
+
+
+def decode_mask(envelope: dict) -> torch.Tensor:
+    shape = envelope.get("shape")
+    if (
+        type(envelope.get(MARKER)) is not int
+        or envelope[MARKER] != 1
+        or envelope.get("dtype") != "torch.float32"
+        or envelope.get("bitorder") != "little"
+        or not isinstance(shape, list)
+        or len(shape) != 4
+        or any(type(n) is not int or n <= 0 for n in shape)
+    ):
+        raise ValueError("Invalid ART mask envelope")
+    size = math.prod(shape)
+    data = envelope.get("data")
+    if (
+        type(envelope.get("numel")) is not int
+        or size != envelope["numel"]
+        or size * 4 > MAX_BYTES
+        or not isinstance(data, bytes)
+        or len(data) != (size + 7) // 8
+    ):
+        raise ValueError("Invalid ART mask length")
+    if size % 8 and data[-1] >> (size % 8):
+        raise ValueError("Invalid ART mask padding")
+    packed = np.frombuffer(data, dtype=np.uint8)
+    # Owned uint32 output; bound transient unpacked bits to one chunk.
+    output = np.empty(size, dtype=np.uint32)
+    for offset in range(0, size, CHUNK):
+        count = min(CHUNK, size - offset)
+        flags = np.unpackbits(packed[offset // 8 : (offset + count + 7) // 8], count=count, bitorder="little")
+        np.multiply(flags, NEG_INF, out=output[offset : offset + count], dtype=np.uint32)
+    return torch.from_numpy(output.view(np.float32).reshape(shape))
+
+
+def serialize_art_conditions(env: Any, serializer: Callable) -> Any:
+    conditions = env.pos_cond_kwargs
+    metadata = (env.image_kwargs or {}).get("sensenova_rollout") or {}
+    if (
+        not isinstance(conditions, dict)
+        or metadata.get("capture") != "ode_states"
+        or metadata.get("protocol") != "sensenova_i2i_flow_v1"
+    ):
+        return serializer(conditions)
+    encoded = encode_mask(conditions.get("prefix_attention_mask"))
+    if encoded is None:
+        return serializer(conditions)
+    return serializer({**conditions, "prefix_attention_mask": encoded})
