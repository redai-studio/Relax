+def _it2i_ode_schedule(native_timesteps):
+    """Use the public [1000, 0] scheduler coordinate for model time and ODE deltas."""
+    times = 1000 * (1 - native_timesteps[:-1].float())
+    # Sigma uses correctly rounded FP64 division to FP32; model time uses
+    # native FP32 division. CUDA division can differ by an ULP.
+    sigmas = torch.cat([(times.double() / 1000).float(), times.new_zeros(1)])
+    timesteps = torch.cat([1 - times / 1000, times.new_ones(1)])
+    return timesteps, sigmas
+
