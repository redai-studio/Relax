@@ -0,0 +1,116 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Stateless flow-matching transitions for rollout schedulers.
+
+The caller owns scheduling and randomness. Transition scores describe the
+sampled observation after rounding to the configured storage dtype. CPS uses a
+residual-MSE score, not a normalized Gaussian log density.
+"""
+
+from dataclasses import dataclass
+
+import torch
+
+
+@dataclass
+class FlowStepOutput:
+    next_sample: torch.Tensor
+    mean: torch.Tensor
+    noise_std: torch.Tensor
+    dt: torch.Tensor
+    score: torch.Tensor | None
+    score_kind: str
+
+
+def flow_matching_step(
+    sample: torch.Tensor,
+    velocity: torch.Tensor,
+    sigma: torch.Tensor,
+    sigma_next: torch.Tensor,
+    *,
+    dynamics: str,
+    noise_level: float,
+    variance_noise: torch.Tensor | None = None,
+    compute_score: bool = False,
+    sigma_max: float | torch.Tensor | None = None,
+) -> FlowStepOutput:
+    """Sample one descending-sigma transition and optionally score its output.
+
+    ``velocity`` points from clean data toward noise. Scoring the rounded
+    output keeps the sampling record consistent with the returned trajectory.
+    The caller validates the descending sigma schedule once before sampling;
+    FlowMatchingRolloutScheduler does this at construction.
+    """
+    if dynamics not in ("ode", "cps", "sde"):
+        raise ValueError(f"Unsupported flow dynamics: {dynamics!r}")
+    if sample.shape != velocity.shape or sample.ndim < 2:
+        raise ValueError("sample and velocity must have the same batched shape")
+    if sample.dtype not in (torch.bfloat16, torch.float16, torch.float32):
+        raise ValueError("sample must use BF16, FP16 or FP32 boundary storage")
+    if not 0 <= noise_level <= 1:
+        raise ValueError("noise_level must be finite and in [0, 1]")
+    if variance_noise is not None and variance_noise.shape != sample.shape:
+        raise ValueError("variance_noise must match sample shape")
+    if dynamics == "ode" and compute_score:
+        raise ValueError("ODE has no transition score")
+    if compute_score and dynamics == "sde" and noise_level == 0:
+        raise ValueError("A zero-noise Gaussian cannot be scored")
+
+    def broadcast(value):
+        value = torch.as_tensor(value, device=sample.device, dtype=torch.float32)
+        if value.numel() not in (1, sample.shape[0]):
+            raise ValueError("sigma must be scalar or have one value per sample")
+        return value.reshape(-1, *([1] * (sample.ndim - 1)))
+
+    current, following = broadcast(sigma), broadcast(sigma_next)
+    state, prediction = sample.float(), velocity.float()
+    dt = following - current
+    score_kind = "none"
+
+    if dynamics == "ode":
+        mean = (state + prediction * dt).to(sample.dtype).float()
+        noise_std = torch.zeros_like(current)
+    elif dynamics == "cps":
+        noise_std = following * torch.sin(
+            current.new_full((), noise_level) * torch.pi / 2
+        )
+        clean = state - current * prediction
+        noise = state + prediction * (1 - current)
+        mean = clean * (1 - following) + noise * torch.sqrt(following**2 - noise_std**2)
+        score_kind = "cps_residual_mse"
+    else:
+        if sigma_max is None:
+            raise ValueError("Flow-SDE requires the actual schedule sigma_max")
+        maximum = broadcast(sigma_max)
+        coefficient = (
+            torch.sqrt(current / (1 - torch.where(current == 1, maximum, current)))
+            * noise_level
+        )
+        noise_std = coefficient * torch.sqrt(-dt)
+        mean = (
+            state * (1 + coefficient**2 / (2 * current) * dt)
+            + prediction * (1 + coefficient**2 * (1 - current) / (2 * current)) * dt
+        )
+        score_kind = "gaussian_mean_logprob"
+
+    if dynamics != "ode" and noise_level > 0 and variance_noise is None:
+        raise ValueError("Stochastic sampling requires explicit variance_noise")
+    sampled = mean
+    if variance_noise is not None and dynamics != "ode":
+        sampled = sampled + noise_std * variance_noise.float()
+    next_sample = sampled.to(sample.dtype)
+
+    score = None
+    if compute_score:
+        residual_squared = (next_sample.detach().float() - mean) ** 2
+        if dynamics == "cps":
+            elementwise = -residual_squared
+        else:
+            # Compute the Gaussian normalizer in FP32 and reduce per sample in FP64.
+            elementwise = (
+                -residual_squared / (2 * noise_std**2)
+                - torch.log(noise_std)
+                - torch.log(torch.sqrt(current.new_full((), torch.pi * 2)))
+            )
+        score = elementwise.flatten(1).mean(dim=1, dtype=torch.float64).float()
+
+    return FlowStepOutput(next_sample, mean, noise_std, dt, score, score_kind)
