+# SPDX-License-Identifier: Apache-2.0
+"""Explicit-noise flow scheduler using the shared rollout session lifecycle.
+
+Models provide noise-directed velocity. This opt-in scheduler scores rounded
+storage states and consumes independent, explicit noise streams. Existing
+schedulers retain their current numerical conventions.
+"""
+
+import torch
+from sglang.multimodal_gen.runtime.distributed import get_sp_world_size
+from sglang.multimodal_gen.runtime.post_training.flow_matching import flow_matching_step
+from sglang.multimodal_gen.runtime.post_training.scheduler_rl_mixin import (
+    SchedulerRLMixin,
+)
+
+
+class FlowMatchingRolloutScheduler(SchedulerRLMixin):
+    def __init__(self, *, timesteps, sigmas, denoise_seeds, score_step_indices):
+        if sigmas.ndim != 1 or timesteps.ndim != 1 or len(sigmas) != len(timesteps) + 1:
+            raise ValueError("Expected T timesteps and T+1 sigmas")
+        # Validate once, before the loop; Python checks on CUDA scalars would
+        # otherwise synchronize the device at every transition.
+        schedule = sigmas.detach().cpu()
+        if (
+            len(schedule) < 2
+            or not torch.isfinite(schedule).all()
+            or schedule[0] > 1
+            or schedule[-1] < 0
+            or not torch.all(schedule[:-1] > schedule[1:])
+        ):
+            raise ValueError("Expected finite, descending sigmas in [0, 1]")
+        if not denoise_seeds or any(
+            len(seeds) != len(timesteps) for seeds in denoise_seeds
+        ):
+            raise ValueError("Expected one transition seed per sample and timestep")
+        self.timesteps = timesteps
+        self.sigmas = sigmas
+        self.denoise_seeds = denoise_seeds
+        self.score_step_indices = set(score_step_indices)
+        self._step_index = 0
+
+    def prepare_rollout(self, batch, pipeline_config=None):
+        if get_sp_world_size() != 1:
+            raise ValueError(
+                "Explicit-noise rollout scheduler requires unsharded states"
+            )
+        if batch.latents.shape[0] != len(self.denoise_seeds):
+            raise ValueError("Latent batch size does not match candidate seed streams")
+        if batch.rollout_sde_type == "sde" and len(self.timesteps) < 2:
+            raise ValueError("Flow-SDE requires at least two steps for sigma_max")
+        super().prepare_rollout(batch, pipeline_config)
+        self._step_index = 0
+
+    def step(self, model_output, timestep, sample, *, batch):
+        self._get_rollout_session_data(batch)
+        index = batch._rollout_loop_step_index
+        if index != self._step_index or index >= len(self.timesteps):
+            raise ValueError(
+                "Rollout steps must execute exactly once in scheduler order"
+            )
+        selected = batch.rollout_sde_step_indices
+        level = (
+            batch.rollout_noise_level if selected is None or index in selected else 0.0
+        )
+        if batch.rollout_sde_type == "ode":
+            level = 0.0
+        noise = None
+        if level > 0:
+            # Draw [1, ...] separately: batching/reordering cannot change a
+            # candidate's random stream. The model forward remains batched.
+            noise = torch.cat(
+                [
+                    torch.randn(
+                        (1, *sample.shape[1:]),
+                        device=sample.device,
+                        dtype=torch.float32,
+                        generator=torch.Generator(device=sample.device).manual_seed(
+                            seeds[index]
+                        ),
+                    )
+                    for seeds in self.denoise_seeds
+                ]
+            )
+        collect = index in self.score_step_indices
+        output = flow_matching_step(
+            sample,
+            model_output,
+            self.sigmas[index],
+            self.sigmas[index + 1],
+            dynamics=batch.rollout_sde_type,
+            noise_level=level,
+            variance_noise=noise,
+            compute_score=collect,
+            sigma_max=self.sigmas[min(1, len(self.sigmas) - 1)],
+        )
+        if collect:
+            # flow_matching_step already reduces in FP64. Preserve that result
+            # while reusing the shared sum/count collection interface.
+            self.append_local_rollout_log_probs(
+                batch, output.score.detach(), torch.ones_like(output.score)
+            )
+            if batch.rollout_debug_mode:
+                self.append_local_rollout_debug_tensors(
+                    batch,
+                    variance_noise=noise,
+                    prev_sample_mean=output.mean.detach(),
+                    noise_std_dev=output.noise_std.reshape(-1, 1),
+                    model_output=model_output.detach(),
+                )
+        self._step_index += 1
+        return output.next_sample
+
+    def collect_rollout_log_probs(self, batch):
+        if not self._get_rollout_session_data(batch).local_log_prob_sum:
+            return None
+        return super().collect_rollout_log_probs(batch)
+
+    def collect_rollout_debug_tensors(self, batch):
+        if not self._get_rollout_session_data(batch).local_variance_noises:
+            return None
+        return super().collect_rollout_debug_tensors(batch)
