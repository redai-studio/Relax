+    def _insert_metadata(self, partition_id, data_fields, batch_size, is_last, prepare, insert_id, ticket):
+        # Older clients send neither field and keep their original allocation contract.
+        if insert_id is None and not prepare and ticket is None:
+            return self._allocate_insert(partition_id, data_fields, batch_size, is_last)
+        if (
+            not isinstance(insert_id, str)
+            or not insert_id
+            or data_fields is None
+            or batch_size is None
+            or batch_size < 1
+        ):
+            raise ValueError("Invalid insert request")
+        now = time.monotonic()
+        while self._insert_receipts and next(iter(self._insert_receipts.values())).expires <= now:
+            self._forget_insert(next(iter(self._insert_receipts)))
+        signature = (partition_id, tuple(data_fields), batch_size, is_last)
+        record = self._insert_receipts.get(insert_id)
+        if record is not None and record.signature != signature:
+            raise ValueError("Insert request ID reused with different parameters")
+        if prepare:
+            if record is None:
+                record = _InsertReceipt(uuid4().hex, partition_id, signature, now + self._insert_lifetime)
+                self._insert_receipts[insert_id] = record
+            return BatchMeta.empty({"insert_ticket": record.ticket})
+        if record is None or ticket != record.ticket:
+            raise ValueError("Expired or retired insert ticket")
+        if record.metadata is None:
+            try:
+                record.metadata = self._allocate_insert(partition_id, data_fields, batch_size, is_last)
+                for row in record.metadata.global_indexes:
+                    self._row_insert_ids[row] = insert_id
+            except BaseException:
+                # Allocation could have mutated a partition before failing.
+                self._forget_insert(insert_id)
+                raise
+        return record.metadata
+
+    def _forget_insert(self, insert_id: str) -> None:
+        receipt = self._insert_receipts.pop(insert_id)
+        if receipt.metadata is not None:
+            for row in receipt.metadata.global_indexes:
+                self._row_insert_ids.pop(row, None)
+
+    def _allocate_insert(self, partition_id, data_fields, batch_size, is_last):
+        if partition_id not in self.partitions:
+            self.create_partition(partition_id)
+
+        partition = self._get_partition(partition_id)
+        if data_fields is None:
+            raise RuntimeError("Must provide data_fields for inserting new data")
+
+        # This is called during put_data call without providing metadata.
+        # try to use pre-allocated global index first
+
+        if batch_size is None:
+            raise ValueError("must provide batch_size for inserting new data")
+
+        assert partition is not None
+        batch_global_indexes = partition.activate_pre_allocated_indexes(batch_size)
+
+        if len(batch_global_indexes) < batch_size:
+            new_global_indexes = self.index_manager.allocate_indexes(
+                partition_id, count=(batch_size - len(batch_global_indexes))
+            )
+            batch_global_indexes.extend(new_global_indexes)
+
+        # register global_indexes in partition
+        partition.global_indexes.update(batch_global_indexes)
+
+        # Streaming end-of-stream bookkeeping. Only insert puts reach here, so
+        # actual_sample_count counts each sample once (backfill puts carry
+        # metadata and skip this branch).
+        partition.actual_sample_count += batch_size
+        if is_last:
+            partition.pending_last_indexes.update(batch_global_indexes)
+            partition.has_pending_last = True
+            if data_fields:
+                partition.pending_last_fields.update(data_fields)
+
+        if is_last:
+            # get_meta(insert) and the data's NOTIFY are separate RPCs; if the
+            # notify arrived first its completion check was a no-op, so re-check
+            # now that has_pending_last is set (no-op if data not ready yet).
+            partition._maybe_mark_production_completed()
+
+        return self.generate_batch_meta(partition_id, batch_global_indexes, data_fields, "insert")
