+
+// Select a stable split count for each K sequence, independent of its neighbors.
+C10_HOST_DEVICE inline int dq_splits_for_seqlen(int seqlen_k) {
+    constexpr int tokens_per_split = 2048;
+    constexpr int max_splits = 5;
+    const int splits = seqlen_k > 0 ? 1 + (seqlen_k - 1) / tokens_per_split : 1;
+    return splits < max_splits ? splits : max_splits;
+}
 
