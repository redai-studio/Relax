+    fn prepare_dp_requests(
+        request: Value,
+        prefill: &dyn Worker,
+        decode: &dyn Worker,
+    ) -> (Value, Value) {
+        let mut prefill_request = request.clone();
+        let mut decode_request = request;
+        if let (Some(rank), Some(object)) = (prefill.dp_rank(), prefill_request.as_object_mut()) {
+            object.insert("routed_dp_rank".to_string(), Value::from(rank));
+        }
+        if let Some(object) = decode_request.as_object_mut() {
+            if let Some(rank) = decode.dp_rank() {
+                object.insert("routed_dp_rank".to_string(), Value::from(rank));
+            }
+            if let Some(rank) = prefill.dp_rank() {
+                object.insert("disagg_prefill_dp_rank".to_string(), Value::from(rank));
+            }
+        }
+        (prefill_request, decode_request)
+    }
