+    async fn abort_pd_peer(
+        &self,
+        peer: &dyn Worker,
+        rids: &[&str],
+        headers: Option<&HeaderMap>,
+        deadline: tokio::time::Instant,
+    ) -> bool {
+        // All control requests share the cancellation deadline, including their
+        // response bodies. A slow acknowledgement must not fail after just 1s.
+        let outcomes = futures_util::future::join_all(rids.iter().map(|rid| async move {
+            let remaining = deadline.saturating_duration_since(tokio::time::Instant::now());
+            if remaining.is_zero() {
+                return false;
+            }
+            let attempt = async {
+                let result = self
+                    .build_post_with_headers(
+                        &self.client,
+                        peer.base_url(),
+                        "/abort_request",
+                        &json!({"rid": rid, "abort_all": false}),
+                        headers,
+                        false,
+                    )
+                    .timeout(remaining)
+                    .send()
+                    .await;
+                match result {
+                    Ok(response) if response.status().is_success() => match response.bytes().await {
+                        Ok(_) => true,
+                        Err(error) => {
+                            warn!(peer = peer.url(), rid, %error, "PD sibling abort response failed");
+                            false
+                        }
+                    },
+                    Ok(response) => {
+                        warn!(peer = peer.url(), rid, status = %response.status(), "PD sibling abort failed");
+                        false
+                    }
+                    Err(error) => {
+                        warn!(peer = peer.url(), rid, %error, "PD sibling abort request failed");
+                        false
+                    }
+                }
+            };
+            match tokio::time::timeout_at(deadline, attempt).await {
+                Ok(confirmed) => confirmed,
+                Err(error) => {
+                    warn!(peer = peer.url(), rid, %error, "PD sibling abort deadline failed");
+                    false
+                }
+            }
+        }))
+        .await;
+        outcomes.into_iter().all(|confirmed| confirmed)
+    }
+
+    async fn settle_cancelled_peer<F, T>(
+        &self,
+        future: F,
+        peer: &dyn Worker,
+        rids: &[&str],
+        headers: Option<&HeaderMap>,
+        deadline: Duration,
+    ) -> Result<T, Response>
+    where
+        F: Future<Output = T>,
+    {
+        tokio::pin!(future);
+        let deadline_at = tokio::time::Instant::now() + deadline;
+        let expires = tokio::time::sleep_until(deadline_at);
+        tokio::pin!(expires);
+        let mut retry = tokio::time::interval(Duration::from_millis(250));
+        retry.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Delay);
+        let mut aborts_confirmed = true;
+        loop {
+            tokio::select! {
+                biased;
+                result = &mut future => return if aborts_confirmed {
+                    Ok(result)
+                } else {
+                    Err(Self::cancellation_unconfirmed(
+                        "A PD sibling abort request failed; safe RID reuse is unconfirmed",
+                    ))
+                },
+                _ = &mut expires => break,
+                _ = retry.tick() => {
+                    let abort = self.abort_pd_peer(peer, rids, headers, deadline_at);
+                    tokio::pin!(abort);
+                    tokio::select! {
+                        // Join the control request too: dropping an in-flight
+                        // abort could let it cancel the next use of this RID.
+                        result = &mut future => {
+                            aborts_confirmed &= (&mut abort).await;
+                            return if aborts_confirmed {
+                                Ok(result)
+                            } else {
+                                Err(Self::cancellation_unconfirmed(
+                                    "A PD sibling abort request failed; safe RID reuse is unconfirmed",
+                                ))
+                            };
+                        },
+                        confirmed = &mut abort => aborts_confirmed &= confirmed,
+                        _ = &mut expires => {
+                            (&mut abort).await;
+                            break;
+                        },
+                    }
+                },
+            }
+        }
+        // In-flight controls use the same deadline. Only this final explicit
+        // best-effort abort gets one additional second; it cannot prove release.
+        self.abort_pd_peer(
+            peer,
+            rids,
+            headers,
+            tokio::time::Instant::now() + Duration::from_secs(1),
+        )
+        .await;
+        Err(Self::cancellation_unconfirmed(
+            "Timed out waiting for the cancelled PD sibling to finish; remote cleanup is unconfirmed",
+        ))
+    }
