+    #[test]
+    fn test_pd_dp_requests_select_independent_owners() {
+        let prefill = crate::core::DPAwareWorkerBuilder::new("http://p:8000", 1, 2)
+            .worker_type(WorkerType::Prefill { bootstrap_port: Some(8998) })
+            .build();
+        let decode = crate::core::DPAwareWorkerBuilder::new("http://d:8000", 0, 2)
+            .worker_type(WorkerType::Decode)
+            .build();
+        let request = serde_json::json!({"input_ids": [1, 2], "routed_experts": "raw-r3", "routed_dp_rank": 7});
+        let (p, d) = PDRouter::prepare_dp_requests(request, &prefill, &decode);
+        assert_eq!(p["routed_dp_rank"], 1);
+        assert_eq!(d["routed_dp_rank"], 0);
+        assert_eq!(d["disagg_prefill_dp_rank"], 1);
+        assert!(p.get("disagg_prefill_dp_rank").is_none());
+        assert_eq!(p["routed_experts"], "raw-r3");
+        assert_eq!(d["routed_experts"], "raw-r3");
+        assert_eq!(prefill.base_url(), "http://p:8000");
+        assert_eq!(prefill.bootstrap_host(), "p");
+    }
+
+    #[test]
+    fn test_pd_dp1_requests_preserve_native_fields() {
+        let prefill = BasicWorkerBuilder::new("http://p:8000").build();
+        let decode = BasicWorkerBuilder::new("http://d:8000").build();
+        let request = serde_json::json!({"input_ids": [1], "custom_native_field": {"value": 3}});
+        let (p, d) = PDRouter::prepare_dp_requests(request.clone(), &prefill, &decode);
+        assert_eq!(p, request);
+        assert_eq!(d, request);
+    }
 
