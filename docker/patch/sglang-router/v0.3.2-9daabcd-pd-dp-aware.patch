+    fn cancellation_unconfirmed(detail: &str) -> Response {
+        (
+            StatusCode::FAILED_DEPENDENCY,
+            axum::Json(json!({"error": {
+                "code": "pd_cancellation_unconfirmed", "message": detail
+            }})),
+        )
+            .into_response()
+    }
