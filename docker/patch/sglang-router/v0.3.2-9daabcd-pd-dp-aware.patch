+    // Keep physical endpoints separate from virtual DP identities. Preserve the raw
+    // request so native extensions such as routed_experts survive the round trip.
+    fn prepare_dp_requests(
+        request: Value,
+        prefill: &dyn Worker,
+        decode: &dyn Worker,
+    ) -> (Value, Value) {
+        let mut prefill_request = request.clone();
+        let mut decode_request = request;
+        if let (Some(rank), Some(object)) = (prefill.dp_rank(), prefill_request.as_object_mut()) {
+            object.insert("routed_dp_rank".to_string(), Value::from(rank));
+        }
+        if let Some(object) = decode_request.as_object_mut() {
+            if let Some(rank) = decode.dp_rank() {
+                object.insert("routed_dp_rank".to_string(), Value::from(rank));
+            }
+            if let Some(rank) = prefill.dp_rank() {
+                object.insert("disagg_prefill_dp_rank".to_string(), Value::from(rank));
+            }
+        }
+        (prefill_request, decode_request)
+    }
+
+    fn request_rids(request: &Value) -> Vec<&str> {
+        // Native parallel sampling creates random child RIDs that cannot be
+        // cancelled safely using only the parent IDs in this HTTP payload.
+        let is_parallel = |params: &Value| {
+            params.get("n").is_some_and(|n| n.as_u64() != Some(1))
+        };
+        let has_parallel_samples = match request.get("sampling_params") {
+            Some(Value::Array(params)) => params.iter().any(is_parallel),
+            Some(params) => is_parallel(params),
+            None => false,
+        };
+        if has_parallel_samples {
+            return Vec::new();
+        }
+        match request.get("rid") {
+            Some(Value::String(rid)) if !rid.is_empty() => vec![rid],
+            Some(Value::Array(rids)) => rids
+                .iter()
+                .filter_map(Value::as_str)
+                .filter(|rid| !rid.is_empty())
+                .collect(),
+            _ => Vec::new(),
+        }
+    }
+
+    fn is_request_abort(body: &[u8], rids: &[&str]) -> bool {
+        let Ok(value) = serde_json::from_slice::<Value>(body) else {
+            return false;
+        };
+        let message = value.pointer("/error/message").and_then(Value::as_str);
+        rids.iter()
+            .any(|rid| message == Some(format!("Request {rid} was aborted").as_str()))
+    }
+
+    // Buffer 499 responses to distinguish SGLang cancellation from gateway errors.
+    // Rebuild unknown 499s so they retain the existing error handling.
+    async fn read_pd_response(
+        request: reqwest::RequestBuilder,
+        rids: &[&str],
+    ) -> (Result<reqwest::Response, reqwest::Error>, bool, bool) {
+        let response = match request.send().await {
+            Ok(response) => response,
+            Err(error) => return (Err(error), false, false),
+        };
+        if response.status().as_u16() != 499 {
+            return (Ok(response), false, false);
+        }
+        let (response, aborted, settled) = Self::finish_pd_response(Ok(response), false, false).await;
+        let response = match response {
+            Ok(response) => response,
+            Err(error) => return (Err(error), aborted, settled),
+        };
+        // The buffered response can be read without another network operation.
+        let status = response.status();
+        let headers = response.headers().clone();
+        let version = response.version();
+        let body = response.bytes().await.expect("buffered PD response body");
+        let aborted = status.as_u16() == 499 && Self::is_request_abort(&body, rids);
+        let mut response = http::Response::new(body);
+        *response.status_mut() = status;
+        *response.headers_mut() = headers;
+        *response.version_mut() = version;
+        (Ok(response.into()), aborted, true)
+    }
+
+    async fn finish_pd_response(
+        response: Result<reqwest::Response, reqwest::Error>,
+        aborted: bool,
+        settled: bool,
+    ) -> (Result<reqwest::Response, reqwest::Error>, bool, bool) {
+        if settled {
+            return (response, aborted, true);
+        }
+        let response = match response {
+            Ok(response) => response,
+            Err(error) => return (Err(error), aborted, false),
+        };
+        let status = response.status();
+        let headers = response.headers().clone();
+        let version = response.version();
+        let body = match response.bytes().await {
+            Ok(body) => body,
+            Err(error) => return (Err(error), aborted, false),
+        };
+        let mut response = http::Response::new(body);
+        *response.status_mut() = status;
+        *response.headers_mut() = headers;
+        *response.version_mut() = version;
+        (Ok(response.into()), aborted, true)
+    }
+
+    async fn native_abort_response(response: reqwest::Response) -> Response {
+        let headers = header_utils::preserve_response_headers(response.headers());
+        let body = response
+            .bytes()
+            .await
+            .expect("buffered PD abort response body");
+        let mut response = Response::new(Body::from(body));
+        *response.status_mut() = StatusCode::from_u16(499).unwrap();
+        *response.headers_mut() = headers;
+        response
+    }
