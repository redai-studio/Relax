@@ -0,0 +1,161 @@
+//! Native /generate routing replay: P owns prompt routes, D owns generated routes.
+
+use base64::{engine::general_purpose::STANDARD as BASE64_STANDARD, Engine as _};
+use bytes::Bytes;
+use serde_json::Value;
+
+pub(super) fn prefill_metadata(response: &Value) -> Option<Value> {
+    match response {
+        Value::Array(items) => Some(Value::Array(
+            items.iter().map(|item| item.get("meta_info").cloned().unwrap_or(Value::Null)).collect(),
+        )),
+        _ => response.get("meta_info").cloned(),
+    }
+}
+
+pub(super) fn select_prefill<'a>(prefill: Option<&'a Value>, decode: &Value) -> Option<&'a Value> {
+    match prefill? {
+        Value::Array(items) => items.get(decode.get("index").and_then(Value::as_u64).unwrap_or(0) as usize),
+        item => Some(item),
+    }
+}
+
+fn count(meta: &Value, key: &str) -> Result<usize, String> {
+    meta.get(key).and_then(Value::as_u64).and_then(|v| usize::try_from(v).ok())
+        .ok_or_else(|| format!("PD routing replay requires a valid {key}"))
+}
+
+fn routes(meta: &Value) -> Result<Vec<u8>, String> {
+    let text = meta.get("routed_experts").and_then(Value::as_str)
+        .ok_or_else(|| "PD routing replay response is missing routed_experts".to_string())?;
+    let bytes = BASE64_STANDARD.decode(text)
+        .map_err(|_| "PD routing replay response has invalid base64".to_string())?;
+    if bytes.len() % 4 != 0 {
+        return Err("PD routing replay response is not aligned to int32".to_string());
+    }
+    Ok(bytes)
+}
+
+pub(super) fn merge_routed_experts(
+    prefill: Option<&Value>,
+    decode: &mut Value,
+    start: Option<usize>,
+) -> Result<bool, String> {
+    let Some(start) = start else { return Ok(false) };
+    if let Value::Array(items) = decode {
+        let prefixes = prefill.and_then(Value::as_array)
+            .ok_or_else(|| "PD routing replay batch is missing prefill metadata".to_string())?;
+        if prefixes.len() != items.len() {
+            return Err("PD routing replay batch sizes differ".to_string());
+        }
+        for (prefix, item) in prefixes.iter().zip(items) {
+            merge_routed_experts(Some(prefix), item, Some(start))?;
+        }
+        return Ok(true);
+    }
+    let prefix = select_prefill(prefill, decode);
+    if decode.get("error").is_some() { return Ok(false); }
+    let Some(meta) = decode.get("meta_info") else {
+        return Err("PD routing replay response is missing meta_info".to_string());
+    };
+    // Preserve native errors and empty aborted attempts for the caller's retry path.
+    if decode.get("error").is_some() || (meta["finish_reason"]["type"] == "abort" && meta.get("routed_experts").is_none()) {
+        return Ok(false);
+    }
+    if meta.get("finish_reason").is_none_or(Value::is_null) {
+        return Ok(false);
+    }
+    let prefix = prefix.ok_or_else(|| "PD routing replay is missing prefill metadata".to_string())?;
+    let prompt = count(meta, "prompt_tokens")?;
+    let completion = count(meta, "completion_tokens")?;
+    if count(prefix, "prompt_tokens")? != prompt || start > prompt {
+        return Err("PD routing replay has inconsistent token counts".to_string());
+    }
+    let prefix_rows = prompt - start;
+    if count(prefix, "completion_tokens")? != 1 || prefix["finish_reason"]["type"] == "abort" {
+        return Err("PD routing replay prefill did not complete its handoff token".to_string());
+    }
+    let total_rows = prefix_rows.checked_add(completion)
+        .ok_or_else(|| "PD routing replay token count overflow".to_string())?.saturating_sub(1);
+    let mut p = routes(prefix)?;
+    let d = match meta.get("routed_experts") {
+        // A first-token EOS/length stop completes before D executes a forward.
+        None | Some(Value::Null) if completion <= 1 => None,
+        _ => Some(routes(meta)?),
+    };
+    if prefix_rows == 0 {
+        if !p.is_empty() { return Err("PD routing replay has unexpected prefill rows".to_string()); }
+        if total_rows == 0 {
+            if d.as_ref().is_some_and(|v| !v.is_empty()) {
+                return Err("PD routing replay has unexpected decode rows".to_string());
+            }
+        } else {
+            let bytes = d.ok_or_else(|| "PD routing replay is missing decode rows".to_string())?;
+            if bytes.is_empty() || bytes.len() % total_rows != 0 || (bytes.len() / total_rows) % 4 != 0 {
+                return Err("PD routing replay has an invalid decode shape".to_string());
+            }
+            p = bytes;
+        }
+    } else {
+        if p.is_empty() || p.len() % prefix_rows != 0 || (p.len() / prefix_rows) % 4 != 0 {
+            return Err("PD routing replay has an invalid prefill shape".to_string());
+        }
+        let width = p.len() / prefix_rows;
+        if let Some(d) = d {
+            let expected = total_rows.checked_mul(width)
+                .ok_or_else(|| "PD routing replay byte count overflow".to_string())?;
+            if d.len() != expected {
+                return Err(format!("PD routing replay decode byte count {} differs from expected {expected}", d.len()));
+            }
+            // D's prompt slots have KV, but were never forwarded on that worker.
+            if completion > 1 { p.extend_from_slice(&d[p.len()..]); }
+        }
+        if completion == 0 {
+            p.truncate(total_rows * width);
+        }
+    }
+    decode["meta_info"]["routed_experts"] = Value::String(BASE64_STANDARD.encode(p));
+    Ok(true)
+}
+
+#[derive(Default)]
+pub(super) struct SseBuffer {
+    bytes: Vec<u8>,
+}
+
+impl SseBuffer {
+    pub fn push(&mut self, chunk: &[u8]) { self.bytes.extend_from_slice(chunk); }
+
+    pub fn next_event(&mut self) -> Option<Bytes> {
+        // Parse bytes, not chunk-local UTF-8: both characters and CRLF can split.
+        let end = self.bytes.windows(2).position(|v| v == b"\n\n").map(|v| v + 2);
+        let crlf = self.bytes.windows(4).position(|v| v == b"\r\n\r\n").map(|v| v + 4);
+        let end = match (end, crlf) {
+            (Some(a), Some(b)) => a.min(b), (Some(a), None) | (None, Some(a)) => a,
+            (None, None) => return None,
+        };
+        Some(Bytes::from(self.bytes.drain(..end).collect::<Vec<_>>()))
+    }
+
+    pub fn remaining(self) -> Bytes { Bytes::from(self.bytes) }
+}
+
+pub(super) fn merge_routing_event(
+    prefill: Option<&Value>, event: Bytes, start: Option<usize>,
+) -> Result<(Bytes, Option<usize>, bool), String> {
+    let text = std::str::from_utf8(&event).map_err(|_| "Invalid UTF-8 in PD SSE event".to_string())?;
+    let data = text.lines().filter_map(|line| line.strip_prefix("data:").map(|s| s.strip_prefix(' ').unwrap_or(s)))
+        .collect::<Vec<_>>().join("\n");
+    if data.trim() == "[DONE]" { return Ok((event, None, true)); }
+    if data.is_empty() || start.is_none() { return Ok((event, None, false)); }
+    let mut decoded: Value = serde_json::from_str(&data).map_err(|_| "Invalid JSON in PD routing SSE event".to_string())?;
+    if decoded.get("error").is_some() || (decoded["meta_info"]["finish_reason"]["type"] == "abort" && decoded["meta_info"].get("routed_experts").is_none()) {
+        return Ok((event, Some(usize::MAX), false));
+    }
+    if !merge_routed_experts(prefill, &mut decoded, start)? { return Ok((event, None, false)); }
+    let index = decoded.get("index").and_then(Value::as_u64).unwrap_or(0) as usize;
+    let mut output = text.lines().filter(|line| !line.starts_with("data:") && !line.is_empty())
+        .map(|line| format!("{line}\n")).collect::<String>();
+    output.push_str(&format!("data: {}\n\n", serde_json::to_string(&decoded).map_err(|e| e.to_string())?));
+    Ok((Bytes::from(output), Some(index), false))
+}
