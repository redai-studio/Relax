ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG BASE_IMAGE=quay.io/ascend/cann:9.2.0-a3-ubuntu22.04-py3.12
FROM ${BASE_IMAGE} AS base

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy
ARG SOC_VERSION_FOR_SGL_BUILD="Ascend910_9392"
ARG SOC_VERSION_FOR_DEEPEP_BUILD="Ascend910_9382"

ENV http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    no_proxy=${NO_PROXY} \
    NO_PROXY=${NO_PROXY}

WORKDIR /root
ARG PIP_INDEX_URL="https://pypi.org/simple"

RUN if [ -n "$HTTP_PROXY" ]; then \
      echo "Acquire::http::Proxy \"$HTTP_PROXY\";" > /etc/apt/apt.conf.d/99proxy; \
      echo "Acquire::https::Proxy \"$HTTPS_PROXY\";" >> /etc/apt/apt.conf.d/99proxy; \
    fi

RUN DEBIAN_FRONTEND=noninteractive apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ cmake libnuma-dev wget git curl jq vim \
        build-essential patchelf tmux net-tools htop nano iputils-ping \
        autoconf automake libatlas-base-dev libgoogle-glog-dev libbz2-dev libc-ares2 \
        libleveldb-dev liblmdb-dev libprotobuf-dev libsnappy-dev libtool nasm protobuf-compiler pkg-config unzip sox \
        libsndfile1 libpng-dev libhdf5-dev gfortran rapidjson-dev ninja-build libedit-dev rsync && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        export LD_LIBRARY_PATH=/usr/local/Ascend/ascend-toolkit/latest/aarch64-linux/devlib/linux/aarch64:$LD_LIBRARY_PATH; \
    elif [ "$ARCH" = "x86_64" ]; then \
        export LD_LIBRARY_PATH=/usr/local/Ascend/ascend-toolkit/latest/x86_64-linux/devlib/linux/x86_64/:$LD_LIBRARY_PATH; \
    fi && \
    source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    source /usr/local/Ascend/nnal/atb/set_env.sh && \
    source /usr/local/Ascend/cann-9.2.0/share/info/ascendnpu-ir/bin/set_env.sh
ARG PIP_INDEX_URL="https://pypi.org/simple"
RUN pip config set global.index-url ${PIP_INDEX_URL} && \
    git config --global http.sslverify false && \
    git config --global https.sslverify false && \
    git config --global http.postBuffer 2147483648 && \
    git config --global user.email "temp@example.com" && \
    git config --global user.name "temp"
WORKDIR /root

FROM base AS train

ARG SOC_VERSION=ascend910_9391
ENV SOC_VERSION=${SOC_VERSION}

WORKDIR /root
RUN pip install --upgrade packaging setuptools==80.10.2 && \
    pip install numpy==1.26.4 && \
    pip install --index-url https://download.pytorch.org/whl/cpu \
        --extra-index-url "${PIP_INDEX_URL}" \
        torch==2.10.0+cpu torchvision==0.25.0+cpu torchaudio==2.10.0+cpu && \
    pip install --extra-index-url https://mirrors.huaweicloud.com/ascend/repos/pypi/ \
        torch-npu==2.10.0.post7
ARG PIP_DEPENDENCY_INDEX_URL=${PIP_INDEX_URL}
ENV PIP_INDEX_URL=${PIP_DEPENDENCY_INDEX_URL}
RUN pip config set global.index-url "${PIP_INDEX_URL}"
RUN pip install triton-ascend==3.6.0 --extra-index-url=https://triton-ascend.osinfra.cn/pypi/simple
RUN pip_install() { pip install "$@" || pip install --index-url https://pypi.org/simple "$@"; }; \
    pip_install tensordict==0.10.0 pyvers==0.1.0 --no-deps
RUN git clone https://github.com/redai-studio/TransferQueue.git /root/TransferQueue && \
    cd /root/TransferQueue && \
    git checkout 9784ad0d8a5f0db93ff8326379ab2a6d06e640a0 && \
    pip install /root/TransferQueue --no-deps --no-build-isolation && \
    cd /root && \
    rm -rf /root/TransferQueue

RUN git clone https://gitcode.com/ascend/MindSpeed.git /root/MindSpeed && \
    git clone https://github.com/NVIDIA/Megatron-LM.git /root/Megatron-LM && \
    git clone https://gitcode.com/ascend/MindSpeed-Ops.git /root/MindSpeed-Ops && \
    git clone https://gitcode.com/ascend/MindSpeed-Bridge.git /root/MindSpeed-Bridge && \
    git clone https://github.com/NVIDIA-NeMo/Megatron-Bridge.git /root/Megatron-Bridge

COPY docker/npu_patch/megatron-bridge.patch docker/npu_patch/megatron.patch docker/npu_patch/mindspeed-ops.patch docker/npu_patch/mindspeed.patch docker/npu_patch/mindspeed-bridge.patch /root/Relax/docker/npu_patch/

RUN pip_install() { pip install "$@" || pip install --index-url https://pypi.org/simple "$@"; }; \
    source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    source /usr/local/Ascend/nnal/atb/set_env.sh && \
    source /usr/local/Ascend/cann-9.2.0/share/info/ascendnpu-ir/bin/set_env.sh && \
    cd /root/MindSpeed && git checkout e4772499 && \
    git apply --check /root/Relax/docker/npu_patch/mindspeed.patch && \
    git apply /root/Relax/docker/npu_patch/mindspeed.patch && \
    pip install pybind11 ninja wheel six regex decorator attrs psutil pyyaml protobuf \
        einops scipy sentencepiece pytest pytest-mock 'transformers>=4.43.2' \
        gpytorch pandas scikit-learn SQLAlchemy pydantic && \
    pip install -e . --no-deps && \
    cd /root/Megatron-LM && git checkout core_v0.16.1 && pip install -e . --no-build-isolation && \
    cd /root/Megatron-Bridge && git checkout v0.3.1 && \
    cd /root/MindSpeed-Ops && git checkout 7ccec74448e07a36e137cf4173efa042ca235637 && pip install -e . --no-build-isolation --no-deps && \
    cd /root/MindSpeed-Bridge && git checkout v0.3.1 && \
    pip install megatron-energon transformers==5.3.0 qwen_vl_utils tensorboard omegaconf \
        flash-linear-attention setuptools hydra-core coverage nvidia-modelopt \
        nvidia-resiliency-ext accelerate datasets && \
    pip install -e . --no-deps

RUN cd /root/Megatron-Bridge && \
    patch -p1 < /root/Relax/docker/npu_patch/megatron-bridge.patch && \
    git add . && git commit -m "base line" && \
    cd /root/Megatron-LM && \
    patch -p1 < /root/Relax/docker/npu_patch/megatron.patch && \
    git add . && git commit -m "base line" && \
    cd /root/MindSpeed-Ops && \
    patch -p1 < /root/Relax/docker/npu_patch/mindspeed-ops.patch && \
    git add . && git commit -m "base line" && \
    cd /root/MindSpeed && git add . && git commit -m "base line"

COPY docker/npu_patch/sglang-v0.5.22-npu.patch /root/Relax/docker/npu_patch/

# Patch base: baa9befa381511cd4d56f83980951e5a45fffc6d.
RUN pip_install() { pip install "$@" || pip install --index-url https://pypi.org/simple "$@"; }; \
    git clone https://github.com/sgl-project/sglang.git /root/sglang && \
    cd /root/sglang && git checkout v0.5.22 && \
    git apply --check /root/Relax/docker/npu_patch/sglang-v0.5.22-npu.patch && \
    git apply /root/Relax/docker/npu_patch/sglang-v0.5.22-npu.patch && \
    mv python/pyproject.toml python/pyproject.toml.backup && \
    mv python/pyproject_npu.toml python/pyproject.toml && \
    pip_install 'setuptools-scm>=8.0' wheel && \
    SGLANG_BUILD_RUST_EXTS=none pip install -e "python[srt_npu]" \
        --no-build-isolation --constraint <(echo "torch==2.10.0")

COPY docker/npu_patch/sgl-kernel-npu-2026.9.0.post9.patch /root/Relax/docker/npu_patch/

# Patch base: 0234a271453bb55eb395aa471ace1e815513e92a.
RUN git clone https://github.com/sgl-project/sgl-kernel-npu /root/sgl-kernel-npu && \
    cd /root/sgl-kernel-npu && git checkout 2026.9.0.post9 && \
    git apply --check /root/Relax/docker/npu_patch/sgl-kernel-npu-2026.9.0.post9.patch && \
    git apply /root/Relax/docker/npu_patch/sgl-kernel-npu-2026.9.0.post9.patch && \
    git submodule update --init third_party/catlass third_party/pto-isa && \
    bash build.sh -a kernels ${SOC_VERSION_FOR_SGL_BUILD} && \
    bash build.sh -a memory-saver && \
    bash build.sh -a deepep ${SOC_VERSION_FOR_DEEPEP_BUILD} && \
    pip install output/*.whl && \
    cd /root && rm -rf /root/sgl-kernel-npu

ARG FLA_NPU_COMMIT=56a21dc
RUN apt-get update && apt-get install -y --no-install-recommends gawk && \
    git clone https://github.com/flashserve/flash-linear-attention-npu.git /root/flash-linear-attention-npu && \
    cd /root/flash-linear-attention-npu && git checkout ${FLA_NPU_COMMIT} && \
    source /usr/local/Ascend/cann/set_env.sh && \
    python -m pip install -r requirements.txt && \
    python scripts/check_npu_env.py --build-only && \
    FLA_NPU_SOC=ascend910_93 python scripts/build_wheel.py && \
    python -m pip install --force-reinstall --no-cache-dir --no-deps dist/flash_linear_attention_npu*.whl

COPY docker/npu_patch/hyper-multicore.patch /root/Relax/docker/npu_patch/

ARG HYPER_MULTICORE_COMMIT=623627515705c07d443997012d0979bbbe6e49bb
RUN git init /root/hyper-multicore && cd /root/hyper-multicore && \
    git remote add origin https://github.com/zongshuai1/hyper-multicore.git && \
    git -c http.version=HTTP/1.1 fetch --depth 1 origin ${HYPER_MULTICORE_COMMIT} && \
    git checkout --detach FETCH_HEAD && \
    git apply --check /root/Relax/docker/npu_patch/hyper-multicore.patch && \
    git apply /root/Relax/docker/npu_patch/hyper-multicore.patch && \
    pip install -r requirements.txt wheel 'packaging>=22' decorator attrs psutil && \
    source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    bash build.sh --soc-list ascend910_93 --jobs 24 && \
    pip install --force-reinstall --no-deps dist/*.whl

FROM train AS relax

WORKDIR /root

COPY requirements.txt /tmp/requirements.txt
RUN pip_install() { pip install "$@" || pip install --index-url https://pypi.org/simple "$@"; }; \
    pip install -r /tmp/requirements.txt --no-cache-dir && \
    pip_install ray==2.55.1 protobuf==6.33.6 fastokens==0.3.1

COPY docker/npu_patch/fsdpturbo.patch /root/Relax/docker/npu_patch/

# Patch base: 86c476bde97f657e0a0a70fd2a093ffbdb61e0cb.
RUN git clone https://gitcode.com/Ascend/FSDPTurbo.git /root/FSDPTurbo && \
    cd /root/FSDPTurbo && \
    git checkout 86c476bde97f657e0a0a70fd2a093ffbdb61e0cb && \
    git apply --check /root/Relax/docker/npu_patch/fsdpturbo.patch && \
    git apply /root/Relax/docker/npu_patch/fsdpturbo.patch && \
    pip install -e . --no-deps --no-build-isolation

RUN python -m pip install --no-cache-dir --no-deps \
        transformers==5.19.0 \
        huggingface-hub==1.33.0 \
        protobuf==6.33.6 \
        grpcio-health-checking==1.76.0 \
        grpcio-reflection==1.76.0

RUN python -m pip install --no-cache-dir --no-deps \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.10.0+cpu torchvision==0.25.0+cpu torchaudio==2.10.0+cpu && \
    python -m pip install --no-cache-dir --no-deps \
        --extra-index-url https://mirrors.huaweicloud.com/ascend/repos/pypi/ \
        torch-npu==2.10.0.post7 triton==3.6.0 numpy==1.26.4 && \
    python -m pip install --no-cache-dir --no-deps \
        --extra-index-url https://triton-ascend.osinfra.cn/pypi/simple triton-ascend==3.6.0

RUN pip cache purge && \
    rm -rf /tmp/*

ENTRYPOINT ["/bin/bash", "-c", "set -e; source /usr/local/Ascend/ascend-toolkit/set_env.sh; source /usr/local/Ascend/cann-9.2.0/share/info/ascendnpu-ir/bin/set_env.sh; source /usr/local/Ascend/nnal/atb/set_env.sh ${ATB_CXX_ABI}; source \"$(command -v hyper_multicore_set_env.bash)\"; exec \"$@\"", "--"]
CMD ["/bin/bash"]
