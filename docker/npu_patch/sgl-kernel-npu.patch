+
+    TPipe *pipe_;
+    TBuf<TPosition::VECCALC> stateBuf_[2];
+    TBuf<TPosition::VECCALC> workBuf_;
+    TBuf<TPosition::VECCALC> prodBuf_;
+    TBuf<TPosition::VECCALC> brcbBuf_;
