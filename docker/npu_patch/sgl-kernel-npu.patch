+    TBuf<TPosition::VECCALC> gateBuf_;
+
+    TEventID evtVS_;
+    TEventID evtSV_;
+    TEventID evtMte2S_;
+    TEventID evtMte2V_[2];
+    TEventID evtVMte2_[2];
+    TEventID evtVMte3_[2];
+    TEventID evtMte3V_[2];
+    TEventID evtMte3Mte2_[2];
+
+    uint32_t n_;
+    uint32_t h_;
+    uint32_t hv_;
+    uint32_t hvPerH_;
+    uint32_t qRowStride_;
+    uint32_t kRowStride_;
