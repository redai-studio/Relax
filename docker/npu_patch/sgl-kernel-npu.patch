+        )
+    if retrive_index.shape != candidates.shape:
+        raise ValueError("retrive_index shape must match candidates")
+    if accept_index.shape != candidates.shape:
+        raise ValueError(
+            "classic rejection sampling requires a topk=1 linear chain"
+        )
