+def _qsa_debug_dump_inputs(tag, tensors):
+    """Pre-launch snapshot of the chunk inputs (device is still healthy).
+
+    Writes /tmp/qsa_in_<pid>[_prev].pt with rotation: the newest file always
+    holds the last launched chunk, so if the kernel then faults on-device the
+    exact faulting input is already on the host.
