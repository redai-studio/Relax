+    prev = f"/tmp/qsa_in_{os.getpid()}_prev.pt"
+    try:
+        if os.path.exists(path):
+            os.replace(path, prev)
+        torch.save(
+            {
+                "tag": tag,
+                "time": time.time(),
+                **{
