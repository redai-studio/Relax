diff --git a/fsdp_turbo/memory/chunk_loss/sft_head.py b/fsdp_turbo/memory/chunk_loss/sft_head.py
new file mode 100644
index 0000000..c1a3ea2
--- /dev/null
+++ b/fsdp_turbo/memory/chunk_loss/sft_head.py
@@ -0,0 +1,79 @@
+# Copyright (c) 2026 Huawei Technologies Co., Ltd. All rights reserved.
+from __future__ import annotations
+
+import torch
+import torch.distributed as dist
+from torch import nn
+from torch.nn import functional as F
+from torch.utils.checkpoint import checkpoint
+
+
+def shard_sft_targets(targets: torch.Tensor, local_sequence_length: int, group) -> torch.Tensor:
+    """Align globally shifted labels with actual Ulysses hidden-state shards.
+
+    The caller reduces token losses across CP ranks and compensates for
+    FSDP gradient averaging; this helper performs no loss reduction.
+    """
+    size = dist.get_world_size(group)
+    padded_length = local_sequence_length * size
+    if targets.size(1) > padded_length:
+        raise ValueError("SFT targets exceed the padded hidden-state sequence length")
+    targets = F.pad(targets, (0, padded_length - targets.size(1)), value=-100)
+    rank = dist.get_rank(group)
+    return targets.narrow(1, rank * local_sequence_length, local_sequence_length).contiguous()
+
+
+class SFTChunkedLMHead(nn.Linear):
+    """Keep projection and token loss in one FSDP-managed module call."""
+
+    fsdp_preserve_forward_output = True
+    fsdp_original_output_dtype: torch.dtype | None = None
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        *,
+        targets: torch.Tensor | None = None,
+        chunk_rows: int = 512,
+        model_output_dtype: torch.dtype | None = None,
+    ) -> torch.Tensor:
+        """Return logits, or FP32 per-token NLL for next-token-aligned targets."""
+        head_output_dtype = self.fsdp_original_output_dtype
+        if targets is None:
+            logits = super().forward(hidden_states)
+            return logits.to(head_output_dtype) if head_output_dtype is not None else logits
+
+        def chunk_nll(hidden: torch.Tensor, weight: torch.Tensor, labels: torch.Tensor) -> torch.Tensor:
+            logits = F.linear(hidden, weight)
+            if head_output_dtype is not None:
+                logits = logits.to(head_output_dtype)
+            if model_output_dtype is not None:
+                logits = logits.to(model_output_dtype)
+            with torch.autocast(device_type=logits.device.type, enabled=False):
+                return F.cross_entropy(logits.float(), labels, reduction="none", ignore_index=-100)
+
+        flat_targets = targets.reshape(-1)
+        flat_hidden = hidden_states[:, :targets.size(1)].reshape(-1, hidden_states.size(-1))
+        indices = flat_targets.ne(-100).nonzero().flatten()
+        if indices.numel():
+            selected_hidden = flat_hidden.index_select(0, indices)
+            selected_targets = flat_targets.index_select(0, indices)
+        else:
+            # Keep the head and backbone in the backward graph on ranks with
+            # zero valid labels, including zero-weight alignment microbatches.
+            selected_hidden = hidden_states[0, :1]
+            selected_targets = flat_targets.new_full((1,), -100)
+
+        use_checkpoint = torch.is_grad_enabled() and (selected_hidden.requires_grad or self.weight.requires_grad)
+        losses = []
+        for hidden, labels in zip(selected_hidden.split(chunk_rows), selected_targets.split(chunk_rows)):
+            if use_checkpoint:
+                loss = checkpoint(
+                    chunk_nll, hidden, self.weight, labels, use_reentrant=False, preserve_rng_state=False
+                )
+            else:
+                loss = chunk_nll(hidden, self.weight, labels)
+            losses.append(loss)
+        selected_nll = torch.cat(losses)
+        token_nll = selected_nll.new_zeros(flat_targets.shape).index_copy(0, indices, selected_nll[:indices.numel()])
+        return token_nll.reshape_as(targets)
