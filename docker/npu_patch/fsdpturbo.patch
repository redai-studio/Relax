new file mode 100644
index 0000000000..2dfcd54dd6
--- /dev/null
+++ b/fsdp_turbo/ops/fla_compat.py
@@ -0,0 +1,47 @@
+# Copyright (c) 2026, Huawei Technologies Co., Ltd. All rights reserved.
+"""Helpers for calling FLA kernels robustly across environments.
+
+mindspeed's megatron_adaptor (imported by e.g. the Relax serve stack when it
+registers the megatron backend) globally replaces
+fla.ops.gated_delta_rule.chunk_gated_delta_rule — the package attribute —
+with its AscendC flash_gated_delta_rule, whose autograd Function
+unconditionally saves q/k/v/g/beta/A for backward and whose signature lacks
+upstream kwargs such as skip_recompute. Importing from the source submodule
+bypasses the attribute patch (the stock chunk kernel honors
+skip_recompute=True by recomputing the chunked recurrent states in
+backward), and dropping unsupported kwargs keeps both the stock FLA and the
+mindspeed-patched entry points working.
+"""
+
+import inspect
+import logging
+
+logger = logging.getLogger(__name__)
+
+_drop_warned = set()
+
+
+def drop_unsupported_kwargs(fn, kwargs):
+    """Drop kwargs the active FLA backend does not accept."""
+    sig = inspect.signature(fn)
+    if any(p.kind == inspect.Parameter.VAR_KEYWORD for p in sig.parameters.values()):
+        return
+    unsupported = sorted(k for k in kwargs if k not in sig.parameters)
+    for k in unsupported:
+        kwargs.pop(k)
+    if unsupported:
+        key = (getattr(fn, "__name__", repr(fn)), tuple(unsupported))
+        if key not in _drop_warned:
+            _drop_warned.add(key)
+            logger.warning(
+                "fla backend %s does not accept kwargs %s; dropping them",
+                key[0],
+                ", ".join(unsupported),
+            )
+
+
+def stock_chunk_gated_delta_rule():
+    """Return the stock FLA chunk GDN kernel, bypassing attribute patches."""
+    from fla.ops.gated_delta_rule.chunk import chunk_gated_delta_rule
+
+    return chunk_gated_delta_rule
