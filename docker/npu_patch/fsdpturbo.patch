+def _context_parallel_full_key_mask(
+    attention_mask: torch.Tensor,
+    local_query_length: int,
+    group: dist.ProcessGroup,
+) -> torch.Tensor:
+    """Rebuild the QSA indexer mask as ``[batch, 1, local_q, full_k]`` under Ulysses CP.
+
+    The indexer selects top-k keys across the whole CP-sharded sequence, so its input
+    mask must cover full-sequence keys. Two incoming layouts are handled:
+
+    - local ``[batch, 1, local_q, local_k]`` (post-fusion sharding): per-shard key
+      validity is all-gathered and causality is rebuilt with this rank's global query
+      offset (shards are equal-length because both sharding paths pad first);
+    - full ``[batch, 1, full_q, full_k]`` (MTP materializes the mask before splitting):
+      this rank's query rows are sliced out.
+
+    Bool masks stay bool; additive float masks stay additive float. The last local query
+    row is causal-visible to every local key, so it doubles as the local key-validity row.
+    """
+    ulysses_rank = dist.get_rank(group)
+    ulysses_size = dist.get_world_size(group)
+    query_offset = ulysses_rank * local_query_length
+    is_float_mask = attention_mask.is_floating_point()
+    if attention_mask.shape[-2] == local_query_length:
+        local_key_validity = attention_mask[:, 0, -1, :]
+        if is_float_mask:
+            local_key_validity = local_key_validity == 0
+        gathered_validity = [torch.empty_like(local_key_validity) for _ in range(ulysses_size)]
+        dist.all_gather(gathered_validity, local_key_validity.contiguous(), group=group)
+        key_validity = torch.cat(gathered_validity, dim=-1)
+    else:
+        attention_mask = attention_mask[:, :, query_offset : query_offset + local_query_length, :]
+        key_validity = attention_mask[:, 0, -1, :]
+        if is_float_mask:
+            key_validity = key_validity == 0
