+                group_list=group_list,
+                split_item=2,
+                group_type=0,
+                group_list_type=group_list_type,
+            )[0]
+            if _gmm_packed_ok is None:
+                _gmm_packed_ok = True
+                logger.info(
+                    "npu_grouped_matmul: packed 3D weight form accepted "
+                    "(tensorList len 1, %s groups) ? no expert-count limit",
+                    weight_packed.shape[0],
+                )
+            return out
+        except RuntimeError as exc:
+            if _gmm_packed_ok:
+                raise  # packed form already proven on this stack: real error
+            _gmm_packed_ok = False
