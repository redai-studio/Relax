diff --git a/tests/test_relax_640.py b/tests/test_relax_640.py
--- /dev/null
+++ b/tests/test_relax_640.py
@@ -0,0 +1,79 @@
+"""Routed-only uses no shared storage; the existing zero-shared oracle is equivalent."""
+
+import pytest
+import torch
+import torch.distributed as dist
+
+from mok import functional, ops
+from .utils import BF16_TOLERANCE, MXFP8_TOLERANCE, check_correctness, generate_inputs, run_reference_bf16
+
+
+@pytest.mark.parametrize("precision,grad_dtype,situ", [
+    ("bf16", None, False), ("bf16", torch.float32, False),
+    ("bf16", torch.bfloat16, False),
+])
+def test_routed_only_reference_and_accumulation(context, precision, grad_dtype, situ):
+    rank, world, device = context
+    inputs = generate_inputs(rank, device, 512, 512 // world, 10, 512, 2560, 640)
+    x, routes, probs, *rest = inputs
+    shared, weights, dy = rest[:3], rest[3:6], rest[6]
+    for weight in shared:
+        weight.zero_()
+    if precision == "bf16" and grad_dtype is None:
+        routes[:] = torch.arange(10, device=device)  # Route only to EP0; all other ranks are empty.
+    routes[0].fill_(-1)
+    probs[0].zero_()
+    if precision == "mxfp8":
+        gate, up, down = [ops.mxfp8_quantize(w, True, True) for w in weights]
+        fwd_weights = (gate[:2], up[:2], down[:2])
+        bwd_weights = (gate, up, down[2:])
+    else:
+        fwd_weights = bwd_weights = weights
+    config = functional.MoKConfig(2, 2, 256, 512 if grad_dtype else 4096, 1.5)
+    workspace = functional.get_workspace(
+        config, dist.group.WORLD, device=device, num_local_tokens=512, hidden_size=2560, topk=10,
+    )
+    schedule = functional.build_schedule(workspace, config, routes, num_local_experts=512 // world)
+    if grad_dtype:
+        assert schedule.num_tokens.item() > config.macrobatch_size
+    buffers = [torch.zeros_like(w, dtype=grad_dtype) for w in weights] if grad_dtype else None
+    main_grads = (None, buffers[0], None, buffers[1], None, buffers[2]) if buffers else None
+    expected = [torch.zeros_like(w, dtype=grad_dtype) for w in weights] if grad_dtype else None
+    tolerance = MXFP8_TOLERANCE if precision == "mxfp8" else BF16_TOLERANCE
+    for step in range(2 if grad_dtype else 1):
+        xx, ddy = (x * -0.5, dy * 2) if step == 1 else (x, dy)
+        beta = ((2.0, 8.0) if step == 1 else (4.0, 25.0)) if situ else None
+        y, ctx = functional.forward(config, workspace, schedule, xx, probs, None, None, None, *fwd_weights,
+                                    situ_beta=beta)
+        assert ctx.gate_shared is ctx.up_shared is ctx.hidden_shared is None
+        assert ctx.shared_output is ctx.shared_output_gate is None
+        if not grad_dtype or (situ and step == 0):
+            ctx = functional.recompute_forward_context(
+                config, workspace, schedule, xx, None, None, *fwd_weights[:2],
+                situ_beta=beta,
+            )
+            assert ctx.gate_shared is ctx.up_shared is ctx.hidden_shared is None
+        assert ctx.situ_beta == beta
+        grads = functional.backward(
+            config, workspace, schedule, ctx, ddy, xx, probs, None, None, None, *bwd_weights,
+            main_grads=main_grads,
+        )
+        assert len(grads) == 9 and all(g is None for g in grads[5:])
+        def situ_reference(a, u):
+            a, u = a.float(), u.float()
+            return (beta[0] * torch.tanh(a / beta[0]) * torch.sigmoid(a)
+                    * beta[1] * torch.tanh(u / beta[1])).bfloat16()
+
+        golden = list(run_reference_bf16(
+            xx, routes, probs, *shared, *weights, ddy,
+            routed_activation=situ_reference if situ else None,
+        )[:6])
+        if grad_dtype:
+            for actual, buffer, total, contribution in zip(grads[2:5], buffers, expected, golden[3:]):
+                assert actual is buffer
+                total.add_(contribution)
+            golden[3:] = expected
+        for name, actual, reference in zip(("Y", "dX", "dP", "dWa", "dWu", "dWd"), (y, *grads[:5]), golden):
+            check_correctness(name, reference, actual, tolerance, print_stats=rank == 0)
+        torch.testing.assert_close(y[0], torch.zeros_like(y[0]), rtol=0, atol=0)
+        torch.testing.assert_close(grads[0][0], torch.zeros_like(grads[0][0]), rtol=0, atol=0)
diff --git a/tests/test_swiglu_reference.py b/tests/test_swiglu_reference.py
--- /dev/null
+++ b/tests/test_swiglu_reference.py
@@ -0,0 +1,66 @@
+"""Pin MOK's inclusive clamp subgradient independently of torch.clamp backward."""
+
+import pytest
+import torch
+
+from .utils import run_swiglu_reference
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
+@pytest.mark.parametrize("component", ["gate", "up"])
+def test_clamped_swiglu_reference_boundary_gradient(context, dtype, component):
+    device = context[2]
+    limit = 4.0
+    lo = torch.tensor(-limit, device=device, dtype=dtype)
+    hi = -lo
+    negative_inf = torch.full_like(lo, -float("inf"))
+    positive_inf = -negative_inf
+    # Include both exact boundaries and their nearest representable neighbors.
+    values = torch.stack((
+        2 * lo, torch.nextafter(lo, negative_inf), lo,
+        torch.nextafter(lo, positive_inf), torch.zeros_like(lo),
+        torch.nextafter(hi, negative_inf), hi,
+        torch.nextafter(hi, positive_inf), 2 * hi,
+    ))
+    gate = (values if component == "gate" else torch.ones_like(values)).requires_grad_()
+    up = (values if component == "up" else torch.ones_like(values)).requires_grad_()
+    dy = torch.tensor([1, -2, 0.5, 2, -1, 0.25, -0.5, 4, 1], device=device, dtype=dtype)
+    output = run_swiglu_reference(gate, up, limit)
+    d_gate, d_up = torch.autograd.grad(output, (gate, up), dy)
+
+    # torch.clamp is used only for forward values, never its backward rule.
+    gate_value = gate.detach().float().clamp(max=limit)
+    up_value = up.detach().float().clamp(min=-limit, max=limit)
+    silu_value = torch.nn.functional.silu(gate_value)
+    expected_output = (silu_value * up_value).to(dtype)
+    torch.testing.assert_close(output, expected_output, rtol=0, atol=0)
+
+    # Hand-written masks pin the inclusive boundary contract, not a version probe.
+    if component == "gate":
+        gate_mask = [1, 1, 1, 1, 1, 1, 1, 0, 0]
+        up_mask = [1] * 9
+    else:
+        gate_mask = [1] * 9
+        up_mask = [0, 0, 1, 1, 1, 1, 1, 0, 0]
+    sigmoid = torch.sigmoid(gate_value)
+    dsilu = sigmoid * (1 + gate_value * (1 - sigmoid))
+    expected_gate = (dy.float() * up_value * dsilu
+                     * torch.tensor(gate_mask, device=device)).to(dtype)
+    expected_up = (dy.float() * silu_value
+                   * torch.tensor(up_mask, device=device)).to(dtype)
+    tolerance = dict(rtol=2e-6, atol=1e-7) if dtype == torch.float32 else dict(rtol=0, atol=0)
+    torch.testing.assert_close(d_gate, expected_gate, **tolerance)
+    torch.testing.assert_close(d_up, expected_up, **tolerance)
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
+def test_unclamped_swiglu_reference_unchanged(context, dtype):
+    gate = torch.tensor([-5, -4, 0, 4, 5], device=context[2], dtype=dtype, requires_grad=True)
+    up = torch.tensor([-4, 2, 1, 4, 5], device=context[2], dtype=dtype, requires_grad=True)
+    actual = run_swiglu_reference(gate, up)
+    expected = torch.nn.functional.silu(gate) * up
+    actual_grads = torch.autograd.grad(actual.sum(), (gate, up))
+    expected_grads = torch.autograd.grad(expected.sum(), (gate, up))
+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+    for actual_grad, expected_grad in zip(actual_grads, expected_grads):
+        torch.testing.assert_close(actual_grad, expected_grad, rtol=0, atol=0)
