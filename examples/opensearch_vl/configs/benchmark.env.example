# 复制到仓库外并填入本次配置；认证信息不进入Git。
export AGENT_BASE_URL=http://127.0.0.1:30000/v1
export AGENT_MODEL=your-served-model-name
export AGENT_API_KEY=EMPTY
# 模型来源已按可信清单核验，服务名与实际服务一致。
export AGENT_PROVENANCE_FILE=/path/to/verified-model-provenance.json
export BENCHMARK_DATA_ROOT=/path/to/benchmark-datasets
export BENCHMARK_OVERLAP_INDEX=/path/to/train-overlap-index.json
export BENCHMARK_WORKERS=16
# 0为全部191题；非0仅用于冒烟测试。
export BENCHMARK_MAX_CASES=0
