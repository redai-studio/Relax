# Copy outside Git and fill the service configuration. Do not store real keys here.
export OPENSEARCH_ROOT=/path/to/OpenSearch-VL
export AGENT_BASE_URL=http://127.0.0.1:30148/v1
export AGENT_MODEL=your-served-model-name
# JSON with served_model_name, hashes_verified, model provenance, kind and epochs.
export AGENT_PROVENANCE_FILE=/path/to/model-provenance.json
export JUDGE_BASE_URL=""
export JUDGE_MODEL=""
export JUDGE_API_KEY="${MAAS_API_KEY:-}"
export JUDGE_API_KEY_HEADER=api-key
export SERPER_API_KEY=""
export JINA_API_KEY=""
export QWEN_API_BASE=""
export QWEN_MODEL_NAME=""
export SERPAPI_URL=""
export SERPAPI_API_KEY=""
export IMAGE_UPLOAD_URL=""
export LAYOUT_PARSING_API_URL=""
export LAYOUT_PARSING_TOKEN=""
export SR_MODEL_PATH=/path/to/EDSR_x4.pb
export BENCHMARK_DATA_ROOT=/path/to/benchmark-datasets
export BENCHMARK_OVERLAP_INDEX=/path/to/train-overlap-index.json
# Keep this cache and its referenced intermediate images for both model runs.
export BENCHMARK_CACHE_DIR=/path/to/shared-tool-cache
