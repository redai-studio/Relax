+
+    async def cleanup_rollout(self, rollout_id: str) -> dict[str, Any]:
+        proc = self._active_processes.get(rollout_id)
+        if proc is not None:
+            await _terminate_process_group(proc)
+            if proc.returncode is not None and self._active_processes.get(rollout_id) is proc:
+                self._active_processes.pop(rollout_id, None)
+        return {"rollout_id": rollout_id, "clean": proc is None or proc.returncode is not None}
+
+    async def probe_cleanup(self, rollout_id: str) -> dict[str, Any]:
+        proc = self._active_processes.get(rollout_id)
+        clean = proc is None or proc.returncode is not None
+        if clean and proc is not None and self._active_processes.get(rollout_id) is proc:
+            self._active_processes.pop(rollout_id, None)
+        return {"rollout_id": rollout_id, "clean": clean}
